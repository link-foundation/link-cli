+      group: rerun-infrastructure-failures-${{ github.event.workflow_run.id }}
+      cancel-in-progress: false
+    permissions:
+      contents: read
+      # Read the run's jobs and rerun them.
+      actions: write
+      # Read each job's check-run annotations.
+      checks: read
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+
+      - name: Rerun jobs that GitHub never handed to a runner
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          RUN_ID: ${{ github.event.workflow_run.id }}
+          ATTEMPT: ${{ github.event.workflow_run.run_attempt }}
+          UNACQUIRED_JOBS_VERBOSE: ${{ vars.UNACQUIRED_JOBS_VERBOSE || '0' }}
+        run: >-
+          python3 .github/scripts/unacquired-jobs.py rerun
+          --repository "$REPOSITORY" --run-id "$RUN_ID" --attempt "$ATTEMPT"
+
+
+  pipeline-status:
+    name: Pipeline Status (rerun-infrastructure-failures)
+    needs:
+      - rerun
+    if: ${{ !cancelled() && github.event.workflow_run.conclusion == 'failure' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    concurrency:
+      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status
+      cancel-in-progress: true
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v7
+        with:
+          node-version: '26.x'
+      - name: Check every prerequisite
+        working-directory: .
+        env:
+          NEEDS_JSON: ${{ toJSON(needs) }}
+        run: node .github/scripts/pipeline-status.mjs
