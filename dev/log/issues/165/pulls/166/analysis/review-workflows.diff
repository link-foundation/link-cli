diff --git a/.github/workflows/rerun-infrastructure-failures.yml b/.github/workflows/rerun-infrastructure-failures.yml
new file mode 100644
index 0000000..b4b91a5
--- /dev/null
+++ b/.github/workflows/rerun-infrastructure-failures.yml
@@ -0,0 +1,97 @@
+name: Rerun infrastructure failures
+
+# Ported from the Rust pipeline template (#226), for link-cli issue #165.
+# When GitHub has no hosted runner to give (macOS arm64 capacity is
+# the usual case) it gives up on a queued job with "The job was not acquired by
+# Runner of type hosted even after multiple attempts". The job ends cancelled
+# with no steps and no runner, so no code ran, yet the release and status gates
+# go red and nothing reruns them. This workflow reruns such a run's failed jobs
+# (and, through `gh run rerun --failed`, the gates that depend on them) at most
+# twice. A job that ran steps and failed never triggers a rerun; see
+# .github/scripts/unacquired-jobs.py for the exact rule.
+#
+# workflow_run is safe here: the checkout is the default branch (github.sha of a
+# workflow_run event), nothing from the triggering run is executed, and the job
+# only reads that run through the API and asks GitHub to rerun it.
+on: # zizmor: ignore[dangerous-triggers]
+  workflow_run:
+    # Every workflow with a terminal Pipeline Status gate.
+    workflows:
+      - Rust CI/CD Pipeline
+      - C# CI/CD Pipeline
+      - JS client CI
+      - DeepClient CI
+      - WebAssembly CI
+      - Docs
