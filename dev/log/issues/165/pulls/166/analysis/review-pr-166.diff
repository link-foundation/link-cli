@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { checkNugetAuthentication, selectNugetCredential } from './nuget-auth.mjs';
+
+test('NuGet username is configuration, OIDC is authentication and scope remains unverified', async () => {
+  assert.equal((await checkNugetAuthentication({ nugetUser: 'publisher' })).status, 'failed');
+  const result = await checkNugetAuthentication({
+    oidcOutcome: 'success',
+    oidcKey: 'temporary',
+    apiKey: 'invalid',
+    fetchImpl: async () => {
+      throw Error('must not probe fallback');
+    },
+  });
+  assert.equal(result.status, 'ok');
+  assert.equal(result.authenticated, true);
+  assert.equal(result.authorized, 'unknown');
+  assert.ok(!JSON.stringify(result).includes('temporary'));
+  assert.equal(
+    selectNugetCredential({ oidcOutcome: 'failure', apiKey: 'provided' }).method,
+    'token-fallback',
+  );
+});
+
+test('fallback rejects expired, unavailable or malformed verification without exposing keys', async () => {
+  for (const status of [401, 403, 500]) {
+    const result = await checkNugetAuthentication({
+      apiKey: 'provided',
+      packageId: 'Example',
+      fetchImpl: async () => ({ ok: false, status }),
+    });
+    assert.equal(result.status, status === 401 ? 'failed' : 'unknown');
+    assert.ok(!JSON.stringify(result).includes('provided'));
+  }
+  const options = { apiKey: 'provided', packageId: 'Example' };
+  assert.equal(
+    (
+      await checkNugetAuthentication({
+        ...options,
+        fetchImpl: async () => {
+          throw Error('offline');
+        },
+      })
+    ).status,
+    'unknown',
+  );
+  assert.equal(
+    (
+      await checkNugetAuthentication({
+        ...options,
+        fetchImpl: async () => ({ ok: true, json: async () => ({}) }),
+      })
+    ).status,
+    'unknown',
+  );
+  const valid = await checkNugetAuthentication({
+    ...options,
+    fetchImpl: async () => ({ ok: true, json: async () => ({ Key: 'derived-secret' }) }),
+  });
+  assert.equal(valid.status, 'ok');
+  assert.equal(valid.authorized, 'unknown');
+  assert.ok(!JSON.stringify(valid).includes('derived-secret'));
+});
diff --git a/.github/scripts/pipeline-status.mjs b/.github/scripts/pipeline-status.mjs
new file mode 100644
index 00000000..a70ece16
--- /dev/null
+++ b/.github/scripts/pipeline-status.mjs
@@ -0,0 +1,35 @@
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+/** A failed prerequisite must never turn the remaining skipped jobs green. */
+export function checkPipeline(needs) {
+  if (!needs || typeof needs !== 'object' || Array.isArray(needs) || !Object.keys(needs).length) {
+    throw Error('Missing pipeline job results');
+  }
+  const failed = Object.entries(needs).filter(
+    ([, job]) => !['success', 'skipped'].includes(job?.result),
+  );
+  if (failed.length)
+    throw Error(
+      `Pipeline jobs did not succeed: ${failed.map(([name, job]) => `${name} (${job?.result ?? 'missing'})`).join(', ')}`,
+    );
+  if (!Object.values(needs).some((job) => job.result === 'success'))
+    throw Error('Every pipeline job was skipped; no verification ran');
+  return Object.entries(needs)
+    .filter(([, job]) => job.result === 'skipped')
+    .map(([name]) => name);
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    const skipped = checkPipeline(JSON.parse(process.env.NEEDS_JSON || '{}'));
+    if (skipped.length)
+      console.log(
+        `::notice::Conditional jobs skipped: ${skipped.join(', ')}. See their event, path and prerequisite conditions above.`,
+      );
+    console.log('All executed pipeline jobs succeeded.');
+  } catch (error) {
+    console.error(error.message);
+    process.exitCode = 1;
+  }
+}
