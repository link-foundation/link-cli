+++ b/experiments/issue-165/collect-runs.py
@@ -0,0 +1,60 @@
+"""Collect issue-referenced workflow evidence without building the project."""
+
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+root = Path("dev/log/issues/165/pulls/166")
+issue = json.loads((root / "github/issue-165.json").read_text())
+ids = list(dict.fromkeys(re.findall(r"actions/runs/(\d+)", issue["body"])))
+ids = sys.argv[1:] or ids + ["42128585418", "42128585421"]
+for run_id in ids:
+    metadata = subprocess.check_output(
+        [
+            "gh",
+            "run",
+            "view",
+            run_id,
+            "--repo",
+            "link-foundation/link-cli",
+            "--json",
+            "databaseId,name,headSha,createdAt,updatedAt,conclusion,status,jobs",
+        ]
+    )
+    run = json.loads(metadata)
+    (root / f"github/run-{run_id}.json").write_bytes(metadata)
+    if run["status"] != "completed":
+        print(run_id, run["status"], flush=True)
+        continue
+    with (root / f"ci-logs/run-{run_id}.log").open("w") as output:
+        result = subprocess.run(
+            [
+                "gh",
+                "run",
+                "view",
+                run_id,
+                "--repo",
+                "link-foundation/link-cli",
+                "--log",
+            ],
+            stdout=output,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        if result.returncode:
+            (root / f"ci-logs/run-{run_id}-missing.txt").write_text(result.stderr)
+            print(run_id, result.stderr.strip(), flush=True)
+    for job in run["jobs"]:
+        annotations = subprocess.check_output(
+            [
+                "gh",
+                "api",
+                f"repos/link-foundation/link-cli/check-runs/{job['databaseId']}/annotations",
+                "--paginate",
+                "--slurp",
+            ]
+        )
+        (root / f"github/annotations-{job['databaseId']}.json").write_bytes(annotations)
+    print(run_id, run["name"], run["conclusion"], flush=True)
diff --git a/experiments/issue-165/collect-template-tooling.py b/experiments/issue-165/collect-template-tooling.py
new file mode 100644
index 00000000..611afd06
--- /dev/null
+++ b/experiments/issue-165/collect-template-tooling.py
@@ -0,0 +1,46 @@
+import concurrent.futures
+import json
+import re
+import subprocess
+from pathlib import Path
+
+root = Path("dev/log/issues/165/pulls/166/templates")
+tasks = []
+for lang in ["rust", "csharp", "js", "python"]:
+    p = root / lang
+    meta = json.loads((p / "source.json").read_text())
+    tree = json.loads((p / "tree.json").read_text())["tree"]
+    for entry in tree:
+        file = entry["path"]
+        if entry["type"] != "blob" or (p / file).exists():
+            continue
+        if file.startswith(("tests/", ".husky/", "eslint-rules/")) or re.search(
+            r"(^|/)(?:\.?prettier[^/]*|eslint[^/]*|\.editorconfig|\.ruff.toml|global.json|jsconfig.json|tsconfig[^/]*|Directory.Build.props|\.secretlintrc.json|CONTRIBUTING.md|deno.json|bunfig.toml)$",
+            file,
+        ):
+            tasks.append((meta, p, file))
+
+
+def collect(task):
+    meta, p, file = task
+    result = subprocess.run(
+        [
+            "gh",
+            "api",
+            f"repos/{meta['repository']}/contents/{file}?ref={meta['sha']}",
+            "-H",
+            "Accept: application/vnd.github.raw+json",
+        ],
+        capture_output=True,
+    )
+    if result.returncode:
+        raise RuntimeError(result.stderr.decode())
+    dest = p / file
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    dest.write_bytes(result.stdout)
+    return f"{meta['repository']} {file}"
+
+
+with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
+    for result in pool.map(collect, tasks):
+        print(result, flush=True)
