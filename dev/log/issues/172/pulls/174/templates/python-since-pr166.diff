+    workflow_job_names,
+)
+
+WRITERS = {
+    "release.yml": {
+        "auto-release",
+        "manual-release",
+        "docker-publish-config",
+        "docker-publish-build",
+        "docker-publish",
+    },
+    "docs.yml": {"deploy"},
+}
