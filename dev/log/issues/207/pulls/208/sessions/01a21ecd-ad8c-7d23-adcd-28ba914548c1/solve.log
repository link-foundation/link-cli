[2026-11-27T21:26:42.251Z] [STDOUT] {"type":"item.completed","item":{"id":"item_362","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /tmp/link-cli-207-templates/js/scripts/check-npm-tarball-size.mjs && sed -n '1,120p' /tmp/link-cli-207-templates/js/tests/ci-issue-299.test.js && head -n 10 /tmp/link-cli-207-templates/js/LICENSE\"","aggregated_output":"#!/usr/bin/env node\nimport { execFileSync } from 'node:child_process';\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { getJsRoot, parseJsRootConfig } from './js-paths.mjs';\n\n// Conservative project budget, not a guaranteed registry upload limit.\nexport const MAX_TARBALL_BYTES = 157 * 1024 * 1024;\nconst quote = (value) =>\n  JSON.stringify(String(value)).replaceAll(':', '\\\\u003a');\n\nexport function validatePackReport(report, budget = MAX_TARBALL_BYTES) {\n  if (!Number.isSafeInteger(budget) || budget <= 0) {\n    throw new Error('Tarball budget must be a positive integer');\n  }\n  if (!Array.isArray(report) || !report.length) {\n    throw new Error('npm pack produced no package reports');\n  }\n  const failures = [];\n  for (const pack of report) {\n    if (\n      !Number.isSafeInteger(pack.size) ||\n      pack.size <= 0 ||\n      !Array.isArray(pack.files) ||\n      !pack.files.length ||\n      pack.files.some(\n        (file) =>\n          typeof file.path !== 'string' ||\n          !Number.isSafeInteger(file.size) ||\n          file.size < 0\n      )\n    ) {\n      throw new Error('npm pack produced malformed size or file evidence');\n    }\n    if (pack.size > budget) {\n      const largest = [...pack.files]\n        .sort((a, b) => b.size - a.size)\n        .slice(0, 10)\n        .map((file) => `${quote(file.path)} (${file.size} bytes unpacked)`)\n        .join(', ');\n      failures.push(\n        `${quote(pack.name ?? pack.filename)}: ${pack.size} compressed bytes exceeds budget ${budget}. Largest files: ${largest}. Narrow package.json files or split platform binaries into pinned optionalDependencies.`\n      );\n    }\n  }\n  if (failures.length) {\n    throw new Error(failures.join('\\n'));\n  }\n  return report;\n}\n\nexport function checkNpmTarballSize({ cwd = '.', run = execFileSync } = {}) {\n  const output = run('npm', ['pack', '--dry-run', '--json'], {\n    cwd,\n    encoding: 'utf8',\n    maxBuffer: 16 * 1024 * 1024,\n    env: { ...process.env, npm_config_loglevel: 'silent' },\n    shell: process.platform === 'win32',\n  });\n  const reports = validatePackReport(JSON.parse(output));\n  for (const pack of reports) {\n    console.log(\n      `npm tarball ${quote(pack.name)}: ${pack.size}/${MAX_TARBALL_BYTES} compressed bytes`\n    );\n  }\n  return reports;\n}\n\nexport function reportNpmTarballSizeError(error, log = console.error) {\n  const escaped = String(error.message)\n    .replaceAll('%', '%25')\n    .replaceAll('\\r', '%0D')\n    .replaceAll('\\n', '%0A');\n  log(`::error title=npm tarball size gate::${escaped}`);\n}\n\nif (\n  process.argv[1] &&\n  import.meta.url === pathToFileURL(resolve(process.argv[1])).href\n) {\n  try {\n    checkNpmTarballSize({\n      cwd: getJsRoot({ jsRoot: parseJsRootConfig() }) || '.',\n    });\n  } catch (error) {\n    reportNpmTarballSizeError(error);\n    process.exitCode = 1;\n  }\n}\nimport assert from 'node:assert/strict';\nimport { readdirSync, readFileSync } from 'node:fs';\nimport { describe, it } from 'test-anywhere';\nimport { parse } from 'yaml';\nimport {\n  validatePackReport,\n  checkNpmTarballSize,\n  MAX_TARBALL_BYTES,\n  reportNpmTarballSizeError,\n} from '../scripts/check-npm-tarball-size.mjs';\nimport {\n  isNonRetryableFailure,\n  buildPublishFailureGuidance,\n} from '../scripts/publish-failure-classifier.mjs';\nimport { publishWithRetry } from '../scripts/publish-retry.mjs';\n\nconst workflow = (name) =>\n  parse(readFileSync(`.github/workflows/${name}.yml`, 'utf8'));\nconst pack = (size = 1) => [\n  {\n    name: 'fixture',\n    size,\n    files: [\n      { path: 'small.js', size: 1 },\n      { path: 'binary', size: 200 },\n    ],\n  },\n];\ndescribe('issue 299 workflow regressions', () => {\n  it('sets init.defaultBranch in every workflow with checkout', () => {\n    for (const file of readdirSync('.github/workflows')) {\n      const text = readFileSync(`.github/workflows/${file}`, 'utf8');\n      if (text.includes('actions/checkout@')) {\n        assert.deepEqual(\n          Object.fromEntries(\n            Object.entries(parse(text).env).filter(([key]) =>\n              key.startsWith('GIT_CONFIG_')\n            )\n          ),\n          {\n            GIT_CONFIG_COUNT: '1',\n            GIT_CONFIG_KEY_0: 'ini…nch',\n            GIT_CONFIG_VALUE_0: 'main',\n          },\n          file\n        );\n      }\n    }\n  });\n  it('runs the pinned ShellCheck in a venv over scripts and hooks', () => {\n    const command = workflow('workflows').jobs.shellcheck.steps.at(-1).run;\n    assert.match(command, /python3 -m venv/);\n    assert.match(command, /shellcheck-py==0\\.11\\.0\\.1/);\n    assert.match(command, /git ls-files -z '\\*\\.sh' '\\.husky\\/\\*'/);\n    assert.match(\n      command,\n      /xargs -0 \"\\$RUNNER_TEMP\\/shellcheck-venv\\/bin\\/shellcheck\"/\n    );\n    assert.doesNotMatch(command, /pipx/);\n  });\n  it('restores PR link caches but saves only main pushes', () => {\n    const steps =\n      workflow('links').jobs['link-check']?.steps ??\n      Object.values(workflow('links').jobs)[0].steps;\n    assert.ok(steps.some((step) => step.uses === 'actions/cache/restore@v5'));\n    const save = steps.find((step) => step.uses === 'actions/cache/save@v5');\n    assert.match(save.if, /github.event_name == 'push'/);\n    assert.match(save.if, /github.ref == 'refs\\/heads\\/main'/);\n    assert.match(save.if, /cache-hit != 'true'/);\n    assert.ok(!steps.some((step) => step.uses === 'actions/cache@v5'));\n    assert.ok(\n      !workflow('release').jobs['docker-build'].steps.some(\n        (step) => step.with?.['cache-to']\n      )\n    );\n  });\n  it('runs the pinned Secretlint CLI and checks tarball size on PRs', () => {\n    const steps = workflow('release').jobs.lint.steps;\n    const scan = steps.find((step) => step.name === 'Check for secrets');\n    assert.match(scan.run, /secretlint@14\\.0\\.0/);\n    assert.doesNotMatch(scan.run, /secretlint-rule-preset-recommend@/);\n    assert.match(scan.run, /node scripts\\/check-secrets.mjs/);\n    const gate = steps.find(\n      (step) => step.run === 'node scripts/check-npm-tarball-size.mjs'\n    );\n    assert.ok(gate);\n    assert.equal(gate.if, undefined);\n    assert.ok(\n      readFileSync('scripts/publish-to-npm.mjs', 'utf8').includes(\n        'checkNpmTarballSize({ cwd: jsRoot'\n      )\n    );\n  });\n});\ndescribe('npm tarball size and permanent failures', () => {\n  it('accepts the boundary and reports compressed size and largest unpacked files', () => {\n    validatePackReport(pack(MAX_TARBALL_BYTES));\n    assert.throws(\n      () => validatePackReport(pack(MAX_TARBALL_BYTES + 1)),\n      /Largest files: \"binary\" \\(200 bytes unpacked\\), \"small.js\"/\n    );\n  });\n  for (const report of [\n    null,\n    [],\n    [{}],\n    pack(-1),\n    pack(NaN),\n    [{ ...pack()[0], files: [] }],\n  ]) {\n    it(`rejects missing or invalid npm evidence ${JSON.stringify(report)}`, () =>\n      assert.throws(() => validatePackReport(report)));\n  }\n  it('uses npm dry-run without creating a tarball and honors package cwd', () => {\n    checkNpmTarballSize({\n      cwd: 'js',\n      run: (command, args, options) => {\n        assert.equal(command, 'npm');\n        assert.deepEqual(args, ['pack', '--dry-run', '--json']);\n        assert.equal(options.cwd, 'js');\nThis is free and unencumbered software released into the public domain.\n\nAnyone is free to copy, modify, publish, use, compile, sell, or\ndistribute this software, either in source code form or as a compiled\nbinary, for any purpose, commercial or non-commercial, and by any\nmeans.\n\nIn jurisdictions that recognize copyright laws, the author or authors\nof this software dedicate any and all copyright interest in the\nsoftware to the public domain. We make this dedication for the benefit\n","exit_code":0,"status":"completed"}}
