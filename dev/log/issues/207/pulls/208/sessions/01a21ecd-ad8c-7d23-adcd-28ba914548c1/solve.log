const file = kind === 'shm' ? `/dev/shm/lc${rendezvous.id}` : rendezvous.path(SUFFIX[kind]);\n   const region = new FileRegion(createFile(file, size), size);\n-  const forget = () => fs.rmSync(file, { force: true });\n+  const forget = () => removeRingFile(file, windows);\n   try {\n     initialize(region, capacity);\n     const poll = endpoint.millis('poll', 5);\n@@ -449,7 +461,6 @@ export async function connectRing(endpoint, { signal } = {}, platform = process.\n     const notifier =\n       kind === 'signal' ? new SignalNotifier(peer, peerSignal(ack)) : new PollNotifier(poll);\n     // Both sides hold the region open now; nothing should outlive a crash.\n-    const windows = platform === 'win32';\n     const cleanup = windows ? [file] : [];\n     if (!windows) forget();\n     const stream = new RingStream({ kind, region, notifier, peerPid: peer, cleanup });\ndiff --git a/js/client/test/ipc-ring.test.mjs b/js/client/test/ipc-ring.test.mjs\nindex 7a9069a9..6255bfcf 100644\n--- a/js/client/test/ipc-ring.test.mjs\n+++ b/js/client/test/ipc-ring.test.mjs\n@@ -2,6 +2,7 @@\n // listener of the rendezvous directory (test/support/ipc-listener.mjs), and of\n // the ring stream's failure paths on in-memory regions. They need no `clink`.\n import assert from 'node:assert/strict';\n+import { once } from 'node:events';\n import fs from 'node:fs';\n import os from 'node:os';\n import path from 'node:path';\n@@ -99,6 +100,70 @@ test('a ring keeps its file until it hangs up on Windows', async (t) => {\n   assert.deepEqual(fs.readdirSync(dir), ['listener.json']);\n });\n \n+for (const code of ['EPERM', 'EBUSY']) {\n+  test(`Windows ring cleanup leaves the mapped file for the peer on ${code}`, async (t) => {\n+    const dir = tempDir(t);\n+    const listener = new Listener(dir, 'mmap', { answer: () => ({ pid: process.pid }) });\n+    t.after(() => listener.close());\n+    const stream = await connectRing(parseEndpoint(`mmap:${dir}`), {}, 'win32');\n+    const file = path.join(\n+      dir,\n+      fs.readdirSync(dir).find((name) => name.endsWith('.mmap')),\n+    );\n+    const remove = fs.rmSync;\n+    const attempt = t.mock.method(fs, 'rmSync', (name, options) => {\n+      if (name === file) throw Object.assign(new Error('peer still maps the file'), { code });\n+      return remove(name, options);\n+    });\n+    const closed = once(stream, 'close');\n+    stream.destroy();\n+    await closed;\n+    assert.ok(attempt.mock.calls.some(({ arguments: [name] }) => name === file));\n+    assert.ok(fs.existsSync(file));\n+    // The peer closes its mapping after the JS stream and removes the file.\n+    remove(file);\n+    assert.deepEqual(fs.readdirSync(dir), ['listener.json']);\n+  });\n+}\n+\n+test('Windows ring cleanup delivers other deletion errors through the stream', async (t) => {\n+  const failure = Object.assign(new Error('I/O error removing file'), { code: 'EIO' });\n+  const remove = fs.rmSync;\n+  t.mock.method(fs, 'rmSync', (file, options) => {\n+    if (file.endsWith('.mmap')) throw failure;\n+    return remove(file, options);\n+  });\n+\n+  const region = fresh();\n+  const stream = new RingStream({\n+    kind: 'mmap',\n+    region,\n+    notifier: new PollNotifier(1),\n+    peerPid: process.pid,\n+    cleanup: ['unused.mmap'],\n+  });\n+  const error = once(stream, 'error');\n+  stream.destroy();\n+  assert.deepEqual(await error, [failure]);\n+});\n+\n+test('Windows ring cleanup preserves a rejected handshake while the peer still maps the file', async (t) => {\n+  const dir = tempDir(t);\n+  const listener = new Listener(dir, 'mmap', { answer: () => ({ error: 'no room' }) });\n+  t.after(() => listener.close());\n+  const remove = fs.rmSync;\n+  t.mock.method(fs, 'rmSync', (file, options) => {\n+    if (file.endsWith('.mmap')) {\n+      throw Object.assign(new Error('peer still maps the file'), { code: 'EPERM' });\n+    }\n+    return remove(file, options);\n+  });\n+  await assert.rejects(\n+    connectRing(parseEndpoint(`mmap:${dir}`), {}, 'win32'),\n+    rejectsWith('ECONNREFUSED', /no room/),\n+  );\n+});\n+\n test('a refused ring connection removes its region', async (t) => {\n   const dir = tempDir(t);\n   let answer = () => ({ error: 'no room' });\n✔ Windows ring cleanup leaves the mapped file for the peer on EPERM (23.303535ms)\n✔ Windows ring cleanup leaves the mapped file for the peer on EBUSY (23.214388ms)\n✔ Windows ring cleanup delivers other deletion errors through the stream (2.155721ms)\n✔ Windows ring cleanup preserves a rejected handshake while the peer still maps the file (16.226865ms)\nℹ tests 4\nℹ suites 0\nℹ pass 4\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 293.923592\n","exit_code":0,"status":"completed"}}
