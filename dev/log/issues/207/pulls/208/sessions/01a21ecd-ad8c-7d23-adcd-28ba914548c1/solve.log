[2026-11-27T23:34:11.736Z] [STDOUT] {"type":"item.completed","item":{"id":"item_1307","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,150p' csharp/Foundation.Data.Doublets.Cli.Tests/CliStoreLockTests.cs && git diff --cached -- csharp/Foundation.Data.Doublets.Cli.Tests/StoreLockTests.cs && sed -n '1,145p' csharp/Foundation.Data.Doublets.Cli.Tests/FiniteExitChild.cs\"","aggregated_output":"namespace Foundation.Data.Doublets.Cli.Tests;\n\n/// <summary>\n/// <c>clink</c> locks its stores for the whole run (issue #194): concurrent\n/// <c>--in</c> imports all keep their writes, a held lock fails naming its\n/// owner, and the lock options. The Rust counterpart is\n/// <c>rust/tests/cli_store_lock_tests.rs</c>, the JavaScript one\n/// <c>js/server/test/main-store-lock.test.mjs</c>.\n/// </summary>\npublic sealed class CliStoreLockTests : IDisposable\n{\n    private readonly string _directory = Directory.CreateTempSubdirectory(\"cli-store-lock-\").FullName;\n\n    public void Dispose() => Directory.Delete(_directory, recursive: true);\n\n    private string Db => Path.Combine(_directory, \"s.links\");\n\n    [Theory]\n    [InlineData(null)]\n    [InlineData(\"flock\")]\n    [InlineData(\"pid\")]\n    public async Task ConcurrentImportsAllKeepTheirWrites(string? kind)\n    {\n        string[] lockArguments = kind is null ? [] : [\"--lock\", kind];\n        const int Writers = 8;\n        var imports = Enumerable.Range(1, Writers).Select(index =>\n        {\n            var input = Path.Combine(_directory, $\"in{index}.lino\");\n            File.WriteAllText(input, $\"(w{index}: w{index} w{index})\\n\");\n            return Clink.RunAsync([\"--db\", Db, .. lockArguments, \"--in\", input]);\n        });\n        foreach (var result in await Task.WhenAll(imports)) Clink.AssertSucceeded(result);\n\n        var output = Path.Combine(_directory, \"out.lino\");\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"--out\", output));\n        var exported = await File.ReadAllTextAsync(output);\n        for (var index = 1; index <= Writers; index++)\n        {\n            Assert.Contains($\"(w{index}: w{index} w{index})\", exported, StringComparison.Ordinal);\n        }\n        Assert.DoesNotContain(\n          Directory.GetFileSystemEntries(_directory).Select(Path.GetFileName).OfType<string>(),\n          entry => entry.EndsWith(\".owner\", StringComparison.Ordinal) || entry.Contains(\".lock.d\", StringComparison.Ordinal));\n    }\n\n    [Fact]\n    public async Task FailsNamingTheOwnerOfAHeldLockAndNoLockPassesItBy()\n    {\n        var directory = StorePidLock.LockDirectoryPath(Db);\n        Directory.CreateDirectory(directory);\n        File.WriteAllText(Path.Combine(directory, \"owner\"), StoreLockOwner.Current(\"held-by-test\").ToRecord());\n\n        var held = await Clink.RunAsync(\"--db\", Db, \"--lock\", \"pid\", \"--lock-timeout\", \"20\", \"() ((1 1))\");\n        Assert.Equal(1, held.ExitCode);\n        Assert.StartsWith(\n          $\"Error: Lock error: store is locked: {directory} is held by pid={Environment.ProcessId} \",\n          held.Stderr,\n          StringComparison.Ordinal);\n        Assert.Contains(\"gave up waiting for the pid lock after 20 ms (--lock-timeout)\", held.Stderr, StringComparison.Ordinal);\n\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"--no-lock\", \"() ((1 1))\"));\n        var after = await Clink.RunAsync(\"--db\", Db, \"--lock\", \"none\", \"--after\");\n        Assert.Equal(\"(1: 1 1)\\n\", after.Stdout);\n    }\n\n    [Fact]\n    public async Task AWriterWaitsForAReaderToFinish()\n    {\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"() ((1 1))\"));\n        using var reader = StoreLock.Acquire([Db], LockMode.Shared, new StoreLockOptions { TimeoutMs = 0 });\n        var blocked = await Clink.RunAsync(\"--db\", Db, \"--lock-timeout\", \"0\", \"() ((1 2))\");\n        Assert.Equal(1, blocked.ExitCode);\n        Assert.Contains($\"{Db}.lock is held by shared readers;\", blocked.Stderr, StringComparison.Ordinal);\n        var after = await Clink.RunAsync(\"--db\", Db, \"--lock-timeout\", \"0\", \"--after\");\n        if (OperatingSystem.IsWindows())\n        {\n            // Windows gives the store, mapped for writing, to one process, so\n            // readers there take the lock alone too.\n            Assert.Equal(1, after.ExitCode);\n            Assert.Contains($\"{Db}.lock is held by shared readers;\", after.Stderr, StringComparison.Ordinal);\n            return;\n        }\n        // Elsewhere readers share it.\n        Clink.AssertSucceeded(after);\n        Assert.Equal(\"(1: 1 1)\\n\", after.Stdout);\n    }\n\n    [Fact]\n    public async Task ReadersOfAStoreNotCreatedYetTakeTheLockAlone()\n    {\n        // Opening a new store creates and initializes its memory-mapped files;\n        // readers doing that at once crashed each other.\n        var readers = Enumerable.Range(0, 8).Select(_ => Clink.RunAsync(\"--db\", Db, \"--after\"));\n        foreach (var result in await Task.WhenAll(readers)) Clink.AssertSucceeded(result);\n\n        using var reader = StoreLock.Acquire([Path.Combine(_directory, \"new.links\")], LockMode.Shared, new StoreLockOptions { TimeoutMs = 0 });\n        var first = await Clink.RunAsync(\"--db\", Path.Combine(_directory, \"new.links\"), \"--lock-timeout\", \"0\", \"--after\");\n        Assert.Equal(1, first.ExitCode);\n        Assert.Contains(\"new.links.lock is held by shared readers;\", first.Stderr, StringComparison.Ordinal);\n    }\n\n    [Fact]\n    public async Task LockStatusReportsEveryStoreWithoutCreatingAny()\n    {\n        var log = Path.Combine(_directory, \"log.links\");\n        var status = await Clink.RunAsync(\"--db\", Db, \"--transactions-file\", log, \"--lock-status\");\n        Clink.AssertSucceeded(status);\n        Assert.Equal(\n          $\"flock {log}.lock: unlocked\\npid {log}.lock.d: unlocked\\nflock {Db}.lock: unlocked\\npid {Db}.lock.d: unlocked\\n\",\n          status.Stdout);\n        Assert.Empty(Directory.GetFileSystemEntries(_directory));\n    }\n\n    [Theory]\n    [InlineData(\"--lock\", \"mutex\", \"Invalid --lock value 'mutex'. Use 'flock', 'pid' or 'none'.\")]\n    [InlineData(\"--lock-timeout\", \"soon\", \"Invalid --lock-timeout value 'soon'. Use a whole number of milliseconds.\")]\n    public async Task ChecksTheLockOptionsBeforeAnyStoreOpens(string option, string value, string message)\n    {\n        var result = await Clink.RunAsync(\"--db\", Db, option, value, \"() ((1 1))\");\n        Assert.Equal(1, result.ExitCode);\n        Assert.Equal(message + \"\\n\", result.Stderr);\n        Assert.Empty(Directory.GetFileSystemEntries(_directory));\n    }\n\n    [Fact]\n    public void LocksTheDatabaseAndEverySideStoreOnce()\n    {\n        Assert.Equal([\"a.links\"], CliStoreLocks.LockedStores(\"a.links\", null, null, null, \" self \", \" \"));\n        Assert.Equal(\n          [\"a.links\", \"t.links\", \"v.links\", \"g.links\", \"tokens.links\", \"p.links\"],\n          CliStoreLocks.LockedStores(\"a.links\", \"t.links\", \"v.links\", \"g.links\", \" tokens.links \", \"p.links\"));\n    }\n}\ndiff --git a/csharp/Foundation.Data.Doublets.Cli.Tests/StoreLockTests.cs b/csharp/Foundation.Data.Doublets.Cli.Tests/StoreLockTests.cs\nindex 45f5cae6..cd59f386 100644\n--- a/csharp/Foundation.Data.Doublets.Cli.Tests/StoreLockTests.cs\n+++ b/csharp/Foundation.Data.Doublets.Cli.Tests/StoreLockTests.cs\n@@ -193,6 +193,55 @@ public sealed class StoreLockTests : IDisposable\n         Assert.Empty(Directory.GetFileSystemEntries(_directory));\n     }\n \n+    [Fact]\n+    public void PidCleanupRetriesWindowsSharingErrorsButLeavesPermanentErrorsAlone()\n+    {\n+        const int sharingViolation = unchecked((int)0x80070020);\n+        var attempts = 0;\n+        var cleaned = StorePidLock.TryCleanup(() =>\n+        {\n+            if (++attempts == 1) throw new IOException(\"held by a reader\", sharingViolation);\n+        }, trace: false);\n+        Assert.Equal(OperatingSystem.IsWindows(), cleaned);\n+        Assert.Equal(OperatingSystem.IsWindows() ? 2 : 1, attempts);\n+\n+        attempts = 0;\n+        Assert.False(StorePidLock.TryCleanup(() =>\n+        {\n+            attempts++;\n+            throw new DirectoryNotFoundException();\n+        }, trace: false));\n+        Assert.Equal(1, attempts);\n+    }\n+\n+    [Fact]\n+    public void WindowsPidCleanupCanMoveTheDirectoryAfterItsReaderCloses()\n+    {\n+        if (!OperatingSystem.IsWindows()) return;\n+\n+        var directory = PlantPidLock(Store(), StoreLockOwner.Current(\"held\"));\n+        var released = directory + \".released\";\n+        using var reader = new FileStream(Path.Combine(directory, \"owner\"),\n+          FileMode.Open, FileAccess.Read, FileShare.Read);\n+        var attempts = 0;\n+        Assert.True(StorePidLock.TryCleanup(() =>\n+        {\n+            attempts++;\n+            try\n+            {\n+                Directory.Move(directory, released);\n+            }\n+            catch (IOException) when (attempts == 1)\n+            {\n+                reader.Dispose();\n+                throw;\n+            }\n+        }, trace: true));\n+        Assert.Equal(2, attempts);\n+        Assert.Equal(\"held\", StorePidLock.ReadOwner(released)?.Token);\n+        Assert.False(Directory.Exists(directory));\n+    }\n+\n     [Fact]\n     public void BreaksTheLockOfAnOwnerThatIsGone()\n     {\nusing System.Diagnostics;\nusing System.Text;\n\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\n// Supervision only: phases and elapsed times do not prove persistence.\ninternal static class FiniteExitChild\n{\n    private static readonly object phaseGate = new();\n    private static readonly Stopwatch phaseElapsed = Stopwatch.StartNew();\n    private static int phaseNumber;\n    internal static void Phase(string phase)\n    {\n        lock (phaseGate) Console.Error.WriteLine($\"@link-progress:{++phaseNumber} phase={phase} elapsed={phaseElapsed.ElapsedMilliseconds}ms\");\n    }\n\n    private static string Capture(StreamReader reader, FinitePhaseWatch? progress = null)\n    {\n        const int limit = 65536;\n        var text = new StringBuilder();\n        var buffer = new char[1024];\n        int read;\n        bool truncated = false;\n        // This dedicated reader must not queue behind test-runner workers.\n        while ((read = reader.Read(buffer, 0, buffer.Length)) != 0)\n        {\n            progress?.Observe(buffer.AsSpan(0, read));\n            int keep = Math.Min(read, limit - text.Length);\n            text.Append(buffer, 0, keep);\n            truncated |= keep != read;\n        }\n        progress?.Complete();\n        if (truncated) text.Append(\"\\n[finite diagnostic capture truncated]\");\n        return text.ToString();\n    }\n\n    internal static async Task Run(ProcessStartInfo info, int expectedExit, string description)\n    {\n        info.Environment[\"DOTNET_GCHeapHardLimit\"] = \"0x10000000\";\n        using var child = Process.Start(info)!;\n        await Wait(child, expectedExit, description).ConfigureAwait(false);\n    }\n\n    internal static Task Wait(Process child, int expectedExit, string description, TimeSpan? limit = null)\n        => Dedicated(() => WaitCore(child, expectedExit, description, limit));\n\n    private static Task<T> Dedicated<T>(Func<T> action)\n        => Task.Factory.StartNew(action, CancellationToken.None, TaskCreationOptions.LongRunning, TaskScheduler.Default);\n\n    private static bool WaitCore(Process child, int expectedExit, string description, TimeSpan? limit)\n    {\n        using var progress = new FinitePhaseWatch(limit ?? TimeSpan.FromSeconds(15));\n        var stdout = Dedicated(() => Capture(child.StandardOutput));\n        var stderr = Dedicated(() => Capture(child.StandardError, progress));\n        var elapsed = Stopwatch.StartNew();\n        Exception? failure = null;\n        try\n        {\n            // Both pipe readers and process observation run independently of\n            // the shared pool. A monotonic poll enforces the same idle bound\n            // even when timer and process-exit callbacks cannot be admitted.\n            while (!child.WaitForExit(progress.WaitMilliseconds)) progress.Token.ThrowIfCancellationRequested();\n        }\n        catch (Exception error) { failure = error; }\n        // Reap before either returning or allowing fixture cleanup, including\n        // exceptions other than deadline cancellation. Never abandon a child.\n        try\n        {\n            if (!child.HasExited) child.Kill(entireProcessTree: true);\n            child.WaitForExit();\n        }\n        catch (Exception cleanup)\n        {\n            throw failure is null ? cleanup : new AggregateException(failure, cleanup);\n        }\n        string output = stdout.GetAwaiter().GetResult(), errors = stderr.GetAwaiter().GetResult();\n        string detail = $\"{description}; pid={child.Id}; elapsed={elapsed.Elapsed}; phase={progress.LastPhase}; exited {child.ExitCode}\\nstdout:\\n{output}\\nstderr:\\n{errors}\";\n        if (progress.Failure is not null) throw new InvalidOperationException($\"{progress.Failure}; {detail}\", failure);\n        if (failure is OperationCanceledException) throw new TimeoutException(detail, failure);\n        if (failure is not null) throw new InvalidOperationException(detail, failure);\n        Assert.True(child.ExitCode == expectedExit, detail);\n        return true;\n    }\n\n    internal static async Task WithDirectory(string prefix, Func<string, Task> action, Action<string>? cleanup = null)\n    {\n        string directory = Directory.CreateTempSubdirectory(prefix).FullName;\n        Exception? failure = null;\n        try { await action(directory); }\n        catch (Exception error) { failure = error; throw; }\n        finally\n        {\n            try\n            {\n                if (cleanup is null) Directory.Delete(directory, recursive: true);\n                else cleanup(directory);\n            }\n            catch (Exception error) when (failure is not null) { throw new AggregateException(failure, error); }\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
