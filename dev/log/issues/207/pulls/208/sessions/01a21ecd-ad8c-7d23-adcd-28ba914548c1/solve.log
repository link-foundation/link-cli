n        working-directory: .\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          # Read head_ref through env, never interpolate it into the script: on\n          # a fork PR the branch name is attacker-controlled (issue #134).\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n        run: |\n          # Skip changeset check for automated release PRs\n          if [[ \"$GITHUB_HEAD_REF\" == \"changeset-release/\"* ]] || [[ \"$GITHUB_HEAD_REF\" == \"changeset-manual-release-\"* ]]; then\n            echo \"Skipping changeset check for automated release PR\"\n            exit 0\n          fi\n\n          # A C# code change without exactly one valid changeset never reaches\n          # a release, so this fails instead of warning (issue #134).\n          node csharp/scripts/validate-changeset.mjs\n\n  # === LINT AND FORMAT CHECK ===\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-lint\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: |\n      !cancelled() && needs.javascript.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (\n        github.event_name != 'pull_request' || needs.detect-changes.outputs.stack-changed == 'true'\n      ) && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.cs-changed == 'true' ||\n        needs.detect-changes.outputs.csproj-changed == 'true' ||\n        needs.detect-changes.outputs.sln-changed == 'true' ||\n        needs.detect-changes.outputs.props-changed == 'true' ||\n        needs.detect-changes.outputs.mjs-changed == 'true' ||\n---\n'Foundation.Data.Doublets.Cli': patch\n---\n\nKeep C# checks for each main revision and group import and export options with the CLI I/O helpers.\n---\n'Foundation.Data.Doublets.Cli': patch\n---\n\nRetry transient Windows sharing failures while releasing PID store locks.\n.\n..\nREADME.md\nci-reliability.md\nconfig.json\nwindows-pid-lock-cleanup.md\n","exit_code":0,"status":"completed"}}
