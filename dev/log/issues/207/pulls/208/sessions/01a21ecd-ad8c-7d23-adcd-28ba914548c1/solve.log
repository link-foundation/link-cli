[2026-11-27T21:45:36.896Z] [STDOUT] {"type":"item.completed","item":{"id":"item_613","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' .github/scripts/npm-release.test.mjs && sed -n '1,160p' .github/scripts/pipeline-status.mjs && rg -n 'version|release' js/client/package.json js/server/package.json\"","aggregated_output":"import assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport test from 'node:test';\nimport { fileURLToPath } from 'node:url';\nimport { readJobs, workflows } from './workflow-files.mjs';\n\nfor (const name of ['js-client', 'js-server']) {\n  test(`${name}: pull requests validate the tarball without npm registry credentials`, () => {\n    const { text } = workflows.find((workflow) => workflow.name === `${name}.yml`);\n    const jobs = readJobs(text);\n    const { body: pack } = jobs.find((job) => job.name === 'package-check');\n    const { body: release } = jobs.find((job) => job.name === 'release');\n    const { body: preflight } = jobs.find((job) => job.name === 'release-preflight');\n    const mainOnly = /if: github\\.event_name == 'push' && github\\.ref == 'refs\\/heads\\/main'/;\n    assert.match(pack, /if: inputs\\.verify_trusted_publishing != true/);\n    assert.match(\n      pack,\n      /shell: bash\\n +run: npm pack --dry-run --json \\| node .*check-npm-tarball-size\\.mjs/,\n    );\n    assert.doesNotMatch(pack, /main-writer|npm (view|publish)|id-token: [REDACTED]\n    assert.match(release, mainOnly);\n    assert.match(release, /needs: \\[release-preflight, package-check,/);\n    assert.match(preflight, mainOnly);\n  });\n}\n\ntest('the npm tarball size check requires a report and identifies the largest files on failure', () => {\n  const script = fileURLToPath(new URL('./check-npm-tarball-size.mjs', import.meta.url));\n  const validate = (report) =>\n    spawnSync(process.execPath, [script], {\n      input: JSON.stringify(report),\n      encoding: 'utf8',\n    });\n  const maxTarballBytes = 157 * 1024 * 1024;\n  const pack = {\n    name: 'fixture',\n    size: maxTarballBytes,\n    files: [\n      { path: 'small.js', size: 1 },\n      { path: 'large.bin', size: maxTarballBytes },\n    ],\n  };\n  const accepted = validate([pack]);\n  assert.equal(accepted.status, 0, accepted.stderr);\n  assert.match(accepted.stdout, /compressed bytes/);\n\n  const oversized = validate([{ ...pack, size: maxTarballBytes + 1 }]);\n  assert.equal(oversized.status, 1);\n  assert.match(oversized.stderr, /Largest files: \"large\\.bin\".*\"small\\.js\"/);\n\n  const missing = validate([]);\n  assert.equal(missing.status, 1);\n  assert.match(missing.stderr, /Expected one npm pack report/);\n});\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\n/** A failed prerequisite must never turn the remaining skipped jobs green. */\nexport function checkPipeline(needs) {\n  if (!needs || typeof needs !== 'object' || Array.isArray(needs) || !Object.keys(needs).length) {\n    throw Error('Missing pipeline job results');\n  }\n  const failed = Object.entries(needs).filter(\n    ([, job]) => !['success', 'skipped'].includes(job?.result),\n  );\n  if (failed.length)\n    throw Error(\n      `Pipeline jobs did not succeed: ${failed.map(([name, job]) => `${name} (${job?.result ?? 'missing'})`).join(', ')}`,\n    );\n  if (!Object.values(needs).some((job) => job.result === 'success'))\n    throw Error('Every pipeline job was skipped; no verification ran');\n  return Object.entries(needs)\n    .filter(([, job]) => job.result === 'skipped')\n    .map(([name]) => name);\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  try {\n    const skipped = checkPipeline(JSON.parse(process.env.NEEDS_JSON || '{}'));\n    if (skipped.length)\n      console.log(\n        `::notice::Conditional jobs skipped: ${skipped.join(', ')}. See their event, path and prerequisite conditions above.`,\n      );\n    console.log('All executed pipeline jobs succeeded.');\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\njs/server/package.json:3:  \"version\": \"0.1.1\",\njs/server/package.json:4:  \"description\": \"Pure JavaScript link-cli server and embedded store: the clink query language, named types and unicode strings, LiNo and binary import/export, persistent transformations, transactions, version control, triplets, permissions, the clink --serve protocol server and the GraphQL endpoint, with the same command line and on-disk formats as the Rust clink\",\njs/client/package.json:3:  \"version\": \"0.5.0\",\njs/client/package.json:54:    \"./engine-causal-version\": {\njs/client/package.json:55:      \"types\": \"./types/engine-causal-version.d.ts\",\njs/client/package.json:56:      \"default\": \"./src/engine-causal-version.js\"\n","exit_code":0,"status":"completed"}}
