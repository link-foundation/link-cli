[2026-11-27T21:02:27.056Z] [STDOUT] {"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"cat .github/scripts/verify-npm-trust.mjs .github/scripts/verify-npm-trust.test.mjs && cat .github/scripts/npm-release.test.mjs && sed -n '595,720p' .github/workflows/js-client.yml && rg -n '\"'^'\"\\\\w.*\\\\(' csharp/Foundation.Data.Doublets.Cli/Program.cs | tail -30 && rg -n 'Program.cs|transactions/mod.rs|types.rs' parity/features.json | head -30\"","aggregated_output":"// Verify the registry's trusted publisher policy without uploading a package.\n// API: https://api-docs.npmjs.com/#tag/OIDC\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\n// The packages this repository publishes, each from its own workflow: the\n// trusted publisher policy on npmjs.com names that workflow file.\nexport const NPM_WORKFLOWS = {\n  '@link-foundation/link-cli-client': 'js-client.yml',\n  '@link-foundation/link-cli-server': 'js-server.yml',\n};\n\nexport async function verifyNpmTrust(\n  packageName,\n  { env = process.env, fetch = globalThis.fetch } = {},\n) {\n  if (!env.ACTIONS_ID_TOKEN_REQUEST_URL || !env.ACTIONS_ID_TOKEN_REQUEST_TOKEN) {\n    throw new Error('npm verification requires GitHub Actions with id-token: [REDACTED]\n  }\n  const url = new URL(env.ACTIONS_ID_TOKEN_REQUEST_URL);\n  url.searchParams.set('audience', 'npm:registry.npmjs.org');\n  const oidc = await fetch(url, {\n    headers: { Authorization: [REDACTED] ${env.ACTIONS_ID_TOKEN_REQUEST_TOKEN}` },\n    signal: AbortSignal.timeout(30_000),\n  });\n  if (!oidc.ok) throw new Error(`GitHub OIDC request failed: HTTP ${oidc.status}`);\n  const { value } = await oidc.json();\n  if (!value) throw new Error('GitHub OIDC response is missing a token');\n  const exchange = await fetch(\n    `https://registry.npmjs.org/-/npm/v1/oidc/token/exchange/package/${encodeURIComponent(packageName)}`,\n    {\n      method: 'POST',\n      headers: { Authorization: [REDACTED] ${value}` },\n      signal: AbortSignal.timeout(30_000),\n    },\n  );\n  if (!exchange.ok || !(await exchange.json()).token) {\n    throw new Error(\n      `npm trusted publisher verification failed (HTTP ${exchange.status}). Configure this repository and ${NPM_WORKFLOWS[packageName] ?? 'its release workflow'} in the trusted publisher settings of ${packageName} on npmjs.com (a package that is not on npm yet must be published once by a maintainer first).`,\n    );\n  }\n  // Discard the short-lived credential. Never write it to logs, disk or outputs.\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n  try {\n    await verifyNpmTrust(process.env.NPM_PACKAGE || '@link-foundation/link-cli-client');\n    console.log('npm trusted publisher authentication succeeded. No package was uploaded.');\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { NPM_WORKFLOWS, verifyNpmTrust } from './verify-npm-trust.mjs';\n\ntest('npm trust verification exchanges OIDC credentials without publishing or using a secret', async () => {\n  const requests = [];\n  await verifyNpmTrust('@link-foundation/link-cli-client', {\n    env: {\n      ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…lue',\n      ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n    },\n    fetch: async (url, options) => {\n      requests.push({ url: String(url), ...options });\n      return Response.json(\n        requests.length === 1 ? { value: 'oidc-token' } : { token: 'tem…ken' },\n      );\n    },\n  });\n  assert.equal(requests.length, 2);\n  const oidc = new URL(requests[0].url);\n  assert.equal(oidc.searchParams.get('audience'), 'npm:registry.npmjs.org');\n  assert.equal(oidc.searchParams.get('existing'), 'value');\n  assert.equal(requests[0].headers.Authorization, 'Bearer runner-token');\n  assert.equal(\n    requests[1].url,\n    'https://registry.npmjs.org/-/npm/v1/oidc/token/exchange/package/%40link-foundation%2Flink-cli-client',\n  );\n  assert.equal(requests[1].method, 'POST');\n  assert.equal(requests[1].headers.Authorization, 'Bearer oidc-token');\n});\n\ntest('npm trust verification fails clearly when OIDC or the registry policy is missing', async () => {\n  await assert.rejects(verifyNpmTrust('package', { env: {} }), /id-token: [REDACTED]\n  const env = {\n    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n  };\n  for (const [response, error] of [\n    [new Response('', { status: 403 }), /OIDC.*403/],\n    [Response.json({}), /OIDC.*token/],\n  ]) {\n    await assert.rejects(verifyNpmTrust('package', { env, fetch: async () => response }), error);\n  }\n  for (const response of [new Response('', { status: 404 }), Response.json({})]) {\n    let calls = 0;\n    await assert.rejects(\n      verifyNpmTrust('package', {\n        env,\n        fetch: async () => (++calls === 1 ? Response.json({ value: 'oidc' }) : response),\n      }),\n      /npm.*trusted publisher/,\n    );\n  }\n});\n\ntest('npm trust failures name the workflow each package is published from', async () => {\n  const env = {\n    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n  };\n  for (const [packageName, workflow] of Object.entries(NPM_WORKFLOWS)) {\n    let calls = 0;\n    await assert.rejects(\n      verifyNpmTrust(packageName, {\n        env,\n        fetch: async () =>\n          ++calls === 1 ? Response.json({ value: 'oidc' }) : new Response('', { status: 404 }),\n      }),\n      (error) => error.message.includes(workflow) && error.message.includes(packageName),\n    );\n  }\n  assert.deepEqual(Object.values(NPM_WORKFLOWS), ['js-client.yml', 'js-server.yml']);\n});\nimport assert from 'node:assert/strict';\nimport { spawnSync } from 'node:child_process';\nimport { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { 