[2026-11-27T21:22:19.662Z] [STDOUT] {"type":"item.completed","item":{"id":"item_302","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' /tmp/link-cli-207-remote/code.diff\n\"","aggregated_output":"diff --git a/.github/scripts/ci-governance.test.mjs b/.github/scripts/ci-governance.test.mjs\nindex 9d4235d5..3bfb0c43 100644\n--- a/.github/scripts/ci-governance.test.mjs\n+++ b/.github/scripts/ci-governance.test.mjs\n@@ -21,6 +21,30 @@ test('the required stage checks report on every pull request (issue #111)', () =\n   }\n });\n \n+test('read-only concurrency only replaces superseded PR synchronizations (issue #207)', () => {\n+  const scope =\n+    \"${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}\";\n+  const cancel =\n+    \"${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\";\n+  for (const { name, text } of workflows) {\n+    const groups = [...text.matchAll(/^ +group: (.*)\\n +cancel-in-progress: (.*)$/gm)];\n+    assert.ok(groups.length, `${name}: missing concurrency groups`);\n+    const queueCount = [...text.matchAll(/^ +queue\\s*:/gm)].length;\n+    let writerGroups = 0;\n+    for (const [block, group, policy] of groups) {\n+      if (group.startsWith('main-writer-')) {\n+        writerGroups++;\n+        const nextLine = text.slice(text.indexOf(block) + block.length + 1).split('\\n')[0];\n+        assert.equal(nextLine.trim(), 'queue: max', `${name}: writer lost its queue`);\n+      }\n+      if (policy === 'false') continue;\n+      assert.equal(policy, cancel, `${name}: ${group} cancels unrelated runs`);\n+      assert.ok(group.includes(scope), `${name}: ${group} can collide across revisions or events`);\n+    }\n+    assert.equal(queueCount, writerGroups, `${name}: queue is only supported for shared writers`);\n+  }\n+});\n+\n test('every suite proves it loaded the shared golden fixtures (issue #111)', () => {\n   for (const [name, suite, job] of [\n     ['rust.yml', 'rust', 'test'],\ndiff --git a/.github/scripts/npm-release.test.mjs b/.github/scripts/npm-release.test.mjs\nindex bc5aa186..dec13054 100644\n--- a/.github/scripts/npm-release.test.mjs\n+++ b/.github/scripts/npm-release.test.mjs\n@@ -1,63 +1,20 @@\n import assert from 'node:assert/strict';\n-import { spawnSync } from 'node:child_process';\n-import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n-import { tmpdir } from 'node:os';\n-import { join } from 'node:path';\n import test from 'node:test';\n+import { readJobs, workflows } from './workflow-files.mjs';\n \n-const workflow = readFileSync(new URL('../workflows/js-client.yml', import.meta.url), 'utf8');\n-const step = workflow.split('      - name: Dry-run the release\\n')[1]?.split(/\\n {6}- name:/)[0];\n-assert.ok(step, 'npm release must validate pull requests');\n-const run = /^ {8}run: (.+)$/m.exec(step);\n-assert.ok(run, 'release validation needs a run command');\n-const script =\n-  run[1] === '|'\n-    ? step\n-        .slice(run.index + run[0].length)\n-        .split('\\n')\n-        .filter((line) => line.startsWith('          '))\n-        .map((line) => line.slice(10))\n-        .join('\\n')\n-    : run[1];\n-\n-test('npm release validation uses the actual registry lookup result', () => {\n-  assert.match(step, /PUBLISHED: \\$\\{\\{ steps\\.check\\.outputs\\.published \\}\\}/);\n-});\n-\n-for (const published of ['true', 'false']) {\n-  test(`npm release validation succeeds when published=${published}`, () => {\n-    const root = mkdtempSync(join(tmpdir(), 'npm-release-136-'));\n-    try {\n-      writeFileSync(\n-        join(root, 'npm'),\n-        `#!/usr/bin/env bash\n-set -eu\n-printf '%s\\\\n' \"$*\" >> \"$INVOCATIONS\"\n-if [[ \"$PUBLISHED\" == true && \"$1\" == publish ]]; then\n-  echo 'You cannot publish over the previously published versions: 0.1.0.' >&2\n-  exit 1\n-fi\n-`,\n-        { mode: 0o755 },\