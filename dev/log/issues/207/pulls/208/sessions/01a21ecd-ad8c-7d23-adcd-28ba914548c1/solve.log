[2026-11-27T21:01:47.058Z] [STDOUT] {"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"cat experiments/issue-138/etcd-harness.mjs && cat experiments/issue-138/etcd-harness.test.mjs && rg -n 'became leader|elected leader|new election|leader changed|leader is' dev/log/issues/207/pulls/208/artifacts/46062568123/run-K49PWa/*.log | head -50\"","aggregated_output":"// Each intended member must be ready before injecting failures. A majority's\n// readiness alone says nothing about a slower member's listening socket.\nexport async function waitForMembers(\n  endpoints,\n  {\n    fetch = globalThis.fetch,\n    attempts = 30,\n    pause = (ms) => new Promise((done) => setTimeout(done, ms)),\n  } = {},\n) {\n  return Promise.all(\n    endpoints.map(async (endpoint) => {\n      let failure;\n      for (let attempt = 0; attempt < attempts; attempt++) {\n        try {\n          const response = await fetch(`${endpoint}/v3/maintenance/status`, {\n            method: 'POST',\n            body: '{}',\n            signal: AbortSignal.timeout(2000),\n          });\n          if (!response.ok) throw Error(`member status HTTP ${response.status}`);\n          const status = await response.json();\n          if (!status.header?.member_id || !status.leader || status.leader === '0')\n            throw Error('member has no leader');\n          return status;\n        } catch (error) {\n          failure = error;\n          await pause(100);\n        }\n      }\n      throw failure;\n    }),\n  );\n}\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { waitForMembers } from './etcd-harness.mjs';\n\ntest('a ready majority cannot hide a slow third member', async () => {\n  const calls = new Map();\n  let pauses = 0;\n  const status = await waitForMembers(['http://n0', 'http://n1', 'http://n2'], {\n    pause: async () => {\n      pauses++;\n    },\n    fetch: async (url) => {\n      const count = (calls.get(url) ?? 0) + 1;\n      calls.set(url, count);\n      if (url.includes('n1') && count === 1) throw Error('ECONNREFUSED');\n      if (url.includes('n1') && count === 2) return new Response('{}', { status: 503 });\n      if (url.includes('n1') && count === 3) return Response.json({ leader: '0' });\n      return Response.json({ header: { member_id: url }, leader: 'elected' });\n    },\n  });\n  assert.equal(status.length, 3);\n  assert.equal(pauses, 3);\n  assert.deepEqual([...calls.values()].sort(), [1, 1, 4]);\n});\ntest('readiness has a finite attempt limit and preserves the failure', async () => {\n  let calls = 0;\n  await assert.rejects(\n    waitForMembers(['http://absent'], {\n      attempts: 2,\n      pause: async () => {},\n      fetch: async () => {\n        calls++;\n        throw Error('still absent');\n      },\n    }),\n    /still absent/,\n  );\n  assert.equal(calls, 2);\n});\ndev/log/issues/207/pulls/208/artifacts/46062568123/run-K49PWa/n1.log:5:{\"level\":\"warn\",\"ts\":\"2026-11-27T20:29:57.675074Z\",\"caller\":\"etcdserver/raft.go:390\",\"msg\":\"leader failed to send out heartbeat on time; took too long, leader is overloaded likely from slow disk\",\"to\":\"4eba5b54076660ba\",\"heartbeat-interval\":\"100ms\",\"expected-duration\":\"200ms\",\"exceeded-duration\":\"1.209944512s\"}\ndev/log/issues/207/pulls/208/artifacts/46062568123/run-K49PWa/n1.log:6:{\"level\":\"warn\",\"ts\":\"2026-11-27T20:29:57.675125Z\",\"caller\":\"etcdserver/raft.go:390\",\"msg\":\"leader failed to send out heartbeat on time; took too long, leader is overloaded likely from slow disk\",\"to\":\"4b199c7130dc33e8\",\"heartbeat-interval\":\"100ms\",\"expected-duration\":\"200ms\",\"exceeded-duration\":\"1.209997575s\"}\n","exit_code":0,"status":"completed"}}
