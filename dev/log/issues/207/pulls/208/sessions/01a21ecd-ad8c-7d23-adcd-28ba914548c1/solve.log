am and enable the child's existing tracing.\n\nAll nine workflows now pass for prior published dec6cb7, including all three\nnative Rust/C# platforms. mapped-grow-ci-after.txt preserves exact SHA, commit\nand run timestamps and the successful per-platform totals. This validates\nretained plain-data growth and discovery controls, before the later empty\nshrink/setup-progress changes; those changes require new exact-head CI.\nusing Platform.Data;\nusing Platform.Data.Doublets;\n\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\n// Isolated finite probes run beside the ordinary tests. They never change the\n// testhost's global ThreadPool limits or terminate the parent test process.\ninternal static class ProbeProgram\n{\n    private static int Main(string[] args)\n    {\n        try\n        {\n            if (args is [\"finite-exit-pool\", var poolDirectory, var poolMode]) return FiniteExitPoolTests.Child(poolDirectory, poolMode);\n            if (args is [\"finite-exit-control\", var finiteDirectory, var finiteMode]) return FiniteExitChildTests.Child(finiteDirectory, finiteMode);\n            if (args is [\"async-worker-pool\"]) return AsyncWorkerPool();\n            if (args is [\"async-worker-pool\", \"blocking-control\"]) return AsyncWorkerPool(blockingControl: true, schedulingControl: true);\n            if (args is [\"async-worker-pool\", \"scheduling-control\"]) return AsyncWorkerPool(schedulingControl: true);\n            if (args is [\"mapping-quota\", var mappingDirectory]) return MappedGrowthTests.QuotaChild(mappingDirectory);\n            if (args is [\"deep-structure\", var structureDirectory]) return StructureDepthTests.Child(structureDirectory);\n            if (args is [\"unicode-cycle\", var unicodeOperation, var unicodeDirectory]) return UnicodeGraphCycleTests.Child(unicodeOperation, unicodeDirectory);\n            if (args is [\"group-exit\", var groupPath, var groupPoint, var delta]) return EngineGroupExitTests.Child(groupPath, groupPoint, bool.Parse(delta));\n            if (args is [\"group-exit\", var encodedPath, var encodedPoint, var physicalDelta, var encoding, var structure])\n                return EngineGroupExitTests.Child(encodedPath, encodedPoint, bool.Parse(physicalDelta),\n                    Enum.Parse<Engine.RevisionEncoding>(encoding), Enum.Parse<Engine.StateStructure>(structure));\n            if (args is [\"mirrored-pages-exit\", var mirrorPath, var mirrorPoint]) return MirroredFileExitTests.Child(mirrorPath, mirrorPoint);\n            if (args is [\"pages-exit\", var pagesPath, var pagesPoint]) return PagedFileExitTests.Child(pagesPath, pagesPoint);\n            if (args is [\"checkpoint-pages-cut\", var checkpointPath, var checkpointMirror, var checkpointPoint, var checkpointPhase, var checkpointRoot])\n                return NativeCheckpointExitTests.Child(checkpointPath, bool.Parse(checkpointMirror), int.Parse(checkpointPoint, System.Globalization.CultureInfo.InvariantCulture), checkpointPhase, bool.Parse(checkpointRoot));\n            if (args is [\"native-lsm-exit\", var lsmDirectory, var lsmPhase, var lsmMirrored]) return NativeLsmFileExitTests.Child(lsmDirectory, lsmPhase, bool.Parse(lsmMirrored));\n            if (args is [\"sqlite-exit\", var sqlitePath, var sqlitePoint, var sqliteDelta, var sqliteEncoding, var sqliteStructure])\n                return EngineSqliteExitTests.Child(sqlitePath, sqlitePoint, bool.Parse(sqliteDelta),\n                    Enum.Parse<Engine.RevisionEncoding>(sqliteEncoding), Enum.Parse<Engine.StateStructure>(sqliteStructure));\n            if (args is [\"row-wal-exit\", var rowDirectory, var rowOperation, var rowExplicit])\n                return TransactionRowWalExitTests.Child(rowDirectory, rowOperation, bool.Parse(rowExplicit));\n            if (args is [\"deep-ancestry\", var operation, var ancestryDirectory]) return VersionAncestryDepthTests.Child(operation, ancestryDirectory);\n            if (args is [\"version-exit\", var directory, var mode, va