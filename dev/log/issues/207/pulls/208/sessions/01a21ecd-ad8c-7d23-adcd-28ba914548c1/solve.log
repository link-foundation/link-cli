  - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Validate package contents without registry access\n        working-directory: js/server\n        run: npm pack --dry-run\n\n  release:\n    name: Release to npm\n    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.release-preflight.result == 'success'\n    needs: [release-preflight, package-check, unit, portability, differential]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    # Writer group: never cancel a publish that may already be under way.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: read\n      # Trusted publishing and npm provenance use a GitHub OIDC token.\n      id-token: write\n    defaults:\n      run:\n        working-directory: js/server\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Check whether this version is published\n        id: check\n        run: |\n          name=$(node -p \"require('./package.json').name\")\n          version=$(node -p \"require('./package.json').version\")\n          # Only E404 means \"not published\". Any other failure (an unreachable\n          # registry, a 5xx after npm's own retries) must not count as \"not on\n          # npm yet\", or main would try to publish an existing version.\n          if output=$(npm view \"$name@$version\" version 2>&1); then\n            echo \"$name@$version is already on npm.\"\n            echo \"published=true\" >> \"$GITHUB_OUTPUT\"\n          elif grep -q 'code E404' <<< \"$output\"; then\n            echo \"$name@$version is not on npm yet.\"\n            echo \"published=false\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"$output\"\n            echo \"::error title=npm lookup failed::Could not ask npm whether $name@$version is published. How to fix: re-run the job.\"\n            exit 1\n          fi\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n\n      # The package's OIDC policy is verified through the authentication-only\n      # dispatch above (issue #136). No long-lived publishing token is used.\n      - name: Publish to npm\n        if: steps.check.outputs.published == 'false'\n        env:\n          VERSION: ${{ steps.check.outputs.version }}\n        run: | # zizmor: ignore[adhoc-packages] -- exact pinned release, see below\n          # Trusted publishing needs npm 11.5.1+. Pinned to an exact release\n          # of the 11 line (Node.js ^20.17.0 || >=22.9.0, so 26.x included),\n          # so the npm that publishes does not change with the runner's Node.js.\n          npm install --global npm@11.21.1\n          if npm publish --access public --provenance --loglevel verbose; then\n            exit 0\n          fi\n          echo \"::error title=npm trusted publishing failed::@link-foundation/link-cli-server $VERSION could not be published. Add this repository and js-server.yml as a trusted publisher of @link-foundation/link-cli-server on npmjs.com (a maintainer publishes the first version by hand if the package does not exist yet), run the authentication-only verification dispatch, then retry.\"\n          exit 1\n\n  pipeline-status:\n    name: Pipeline Status (js-server)\n    needs:\n      - javascript\n      - release-preflight\n      - verify-trusted-publishing\n      - unit\n      - portability\n      - differential\n      - package-check\n      - release\n    if: ${{ !cancelled() }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-pipeline-status\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Check every prerequisite\n        working-directory: .\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n        run: node .github/scripts/pipeline-status.mjs\n# zizmor configuration for the workflow security audit run by\n# `.github/workflows/workflows.yml` -- https://docs.zizmor.sh/configuration/\n#\n# Union of the unpinned-uses policies of the C#, Rust and JS\n# ai-driven-development-pipeline templates, because this repository ships all\n# three languages (issue #134).\n#\n# Blanket policy: third-party actions must be pinned to a commit hash, because\n# a mutable tag or branch of a repository we do not control is arbitrary code\n# execution in any job that holds credentials. Namespaces we do trust to keep\n# their release tags immutable are allowed to stay on a readable ref.\nrules:\n  unpinned-uses:\n    config:\n      policies:\n        actions/*: ref-pin\n        github/*: ref-pin\n        docker/*: ref-pin\n        oven-sh/*: ref-pin\n        codecov/*: ref-pin\n        lycheeverse/*: ref-pin\n        peter-evans/*: ref-pin\n        zizmorcore/*: ref-pin\n        '*': hash-pin\n  # .github/workflows/dependencies.yml fails while any dependency is behind\n  # its latest release (the requirement of PR #106), so Dependabot has to open\n  # the update the day it is released. A cooldown would keep that check red\n  # for the whole cooldown window. The supply-chain risk a cooldown mitigates\n  # is covered instead by the lockfiles, `--locked` installs and the review of\n  # every Dependabot pull request before it merges.\n  dependabot-cooldown:\n    disable: true\n  # zizmor 1.30+ asks for GitHub's `uses: $/...` self-repository syntax\n  # (github.blog changelog 2026-07-30) instead of `uses: ./...`. actionlint\n  # 1.7.12, which workflows.yml also runs, rejects `$/` as an invalid\n  # reusable workflow reference (rhysd/actionlint#711, open), so the two\n  # linters cannot both pass. The risk the audit names, a step-level\n  # `uses: ./action` loading code a previous step cloned into the workspace,\n  # does not apply here: the only local references are job-level calls of\n  # .github/workflows/javascript-stage.yml (issue #111), which GitHub\n  # resolves from the caller's commit, not from a runner's filesystem, and\n  # workflow-policy.test.mjs fails on any step-level `uses: ./`. Re-enable\n  # this audit and switch to `$/` once an actionlint release accepts it.\n  self-repository:\n    disable: true\n      at Test.postRun (node:internal/test_runner/test:1542:19)\n      at Test.run (node:internal/test_runner/test:1467:12)\n      at async Test.processPendingSubtests (node:internal/test_runner/test:974:7) {\n    generatedMessage: true,\n    code: 'ERR_ASSERTION',\n    actual: \"github.event_name == 'push' && github.ref == 'refs/heads/main'\",\n    expected: /needs\\.release-preflight\\.result == 'success'/,\n    operator: 'match',\n    diff: 'simple'\n  }\n","exit_code":0,"status":"completed"}}
