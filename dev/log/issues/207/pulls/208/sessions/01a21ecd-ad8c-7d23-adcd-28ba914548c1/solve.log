[2026-11-27T23:20:11.116Z] [STDOUT] {"type":"item.completed","item":{"id":"item_1144","type":"command_execution","command":"/bin/bash -lc \"cat csharp/Foundation.Data.Doublets.Cli.Library/StorePidLock.cs && sed -n '1,90p' csharp/Foundation.Data.Doublets.Cli.Tests/CliStoreLockTests.cs\"","aggregated_output":"namespace Foundation.Data.Doublets.Cli;\n\n/// <summary>\n/// <c>--lock pid</c> (issue #194): a lock directory, <c>&lt;db&gt;.lock.d</c>,\n/// holding an <c>owner</c> record.\n/// </summary>\n/// <remarks>\n/// The directory is built under a private name with its record inside, then\n/// renamed to <c>&lt;db&gt;.lock.d</c>. A rename onto an existing directory\n/// fails, so exactly one process publishes the lock, and a published lock\n/// always has its record. The operating system does not release it when the\n/// owner exits, so a waiter breaks the lock when the record names a process\n/// on this host, in this PID namespace, that is gone. Works where\n/// <c>flock</c> does not, such as on some network file systems. The Rust and\n/// JavaScript <c>clink</c> take the same lock.\n/// </remarks>\npublic sealed class StorePidLock : IDisposable\n{\n    /// <summary>\n    /// A directory without a readable record is treated as abandoned after\n    /// this long (an owner crashed between creating and renaming it, or\n    /// another tool made it).\n    /// </summary>\n    public static readonly TimeSpan UnownedGrace = TimeSpan.FromSeconds(10);\n\n    private const string OwnerFile = \"owner\";\n\n    private readonly string _token;\n\n    private StorePidLock(string directory, string token)\n    {\n        Path = directory;\n        _token = token;\n    }\n\n    /// <summary>The lock directory.</summary>\n    public string Path { get; }\n\n    /// <summary><c>&lt;db&gt;.lock.d</c>.</summary>\n    public static string LockDirectoryPath(string store)\n    {\n        ArgumentNullException.ThrowIfNull(store);\n        return store + \".lock.d\";\n    }\n\n    /// <summary>The owner record of <paramref name=\"directory\"/>, if it has a readable one.</summary>\n    public static StoreLockOwner? ReadOwner(string directory)\n    {\n        try\n        {\n            return StoreLockOwner.Parse(File.ReadAllText(System.IO.Path.Combine(directory, OwnerFile)));\n        }\n        catch (IOException)\n        {\n            return null;\n        }\n        catch (UnauthorizedAccessException)\n        {\n            return null;\n        }\n    }\n\n    /// <summary>Why the lock in <paramref name=\"directory\"/> may be broken, if it may.</summary>\n    public static string? StaleReason(string directory, StoreLockOwner? owner)\n    {\n        if (owner is not null)\n        {\n            var liveness = owner.Liveness();\n            return liveness.State == StoreLockLivenessState.Gone ? liveness.Reason : null;\n        }\n        if (!Directory.Exists(directory)) return null;\n        var age = DateTime.UtcNow - Directory.GetLastWriteTimeUtc(directory);\n        return age >= UnownedGrace ? $\"no owner record for {UnownedGrace.TotalSeconds} s\" : null;\n    }\n\n    /// <summary>\n    /// Publishes the lock once, breaking a stale one first. Returns the lock,\n    /// or <see langword=\"null\"/> and in <paramref name=\"holder\"/> the owner of\n    /// the lock that holds (<see langword=\"null\"/> for a directory without a\n    /// record).\n    /// </summary>\n    public static StorePidLock? TryAcquire(string directory, bool trace, out StoreLockOwner? holder)\n    {\n        ArgumentNullException.ThrowIfNull(directory);\n        var parent = System.IO.Path.GetDirectoryName(directory);\n        if (!string.IsNullOrEmpty(parent)) Directory.CreateDirectory(parent);\n        var token = Sto…n();\n        var owner = StoreLockOwner.Current(token);\n        Exception? lastError = null;\n        for (var attempt = 0; attempt < 4; attempt++)\n        {\n            var staging = $\"{directory}.{owner.Pid}.{StoreLockOwner.UniqueToken()}.tmp\";\n            Directory.CreateDirectory(staging);\n            try\n            {\n                WriteOwner(staging, owner);\n                Directory.Move(staging, directory);\n                holder = null;\n                return new StorePidLock(directory, token);\n            }\n            catch (IOException error)\n            {\n                lastError = error;\n            }\n            catch (UnauthorizedAccessException error)\n            {\n                lastError = error;\n            }\n            TryDelete(staging);\n            if (!Exists(directory))\n            {\n                // Released between the rename and this check, or a real error.\n                continue;\n            }\n            lastError = null;\n            holder = ReadOwner(directory);\n            var reason = StaleReason(directory, holder);\n            if (reason is null) return null;\n            if (trace) Console.Error.WriteLine($\"[TRACE] Breaking stale lock {directory}: {reason}\");\n            BreakStale(directory, holder);\n        }\n        if (lastError is not null) throw new IOException($\"Cannot create the lock {directory}: {lastError.Message}\", lastError);\n        holder = ReadOwner(directory);\n        return null;\n    }\n\n    /// <summary>\n    /// Moves a stale lock aside and removes it. Should a live owner have\n    /// published a new lock in between, its directory is moved back. A lock\n    /// that cannot be moved (another waiter moved it first, or the directory\n    /// is not writable) is left alone: the next attempt sees what became of it.\n    /// </summary>\n    public static void BreakStale(string directory, StoreLockOwner? expected)\n    {\n        ArgumentNullException.ThrowIfNull(directory);\n        var tombstone = $\"{directory}.{Environment.ProcessId}.{StoreLockOwner.UniqueToken()}.stale\";\n        if (!TryMove(directory, tombstone)) return;\n        var moved = ReadOwner(tombstone);\n        if (moved?.Token =[REDACTED] expected?.Token)\n        {\n            TryDelete(tombstone);\n        }\n        else\n        {\n            // A third process may have published meanwhile; then the moved\n            // owner has lost its lock and its directory stays for inspection.\n            _ = TryMove(tombstone, directory);\n        }\n    }\n\n    /// <summary>Removes the lock while it is still ours.</summary>\n    public void Dispose()\n    {\n        if (ReadOwner(Path)?.Token != _token) return;\n        var tombstone = $\"{Path}.{_token}.released\";\n        if (TryMove(Path, tombstone)) TryDelete(tombstone);\n    }\n\n    private static void WriteOwner(string directory, StoreLockOwner owner)\n    {\n        using var file = new FileStream(System.IO.Path.Combine(directory, OwnerFile), FileMode.CreateNew, FileAccess.Write);\n        var bytes = System.Text.Encoding.UTF8.GetBytes(owner.ToRecord());\n        file.Write(bytes);\n        file.Flush(flushToDisk: true);\n    }\n\n    /// <summary>Whether anything, even a dangling link, is at <paramref name=\"path\"/>.</summary>\n    internal static bool Exists(string path) => Directory.Exists(path) || File.Exists(path) || new FileInfo(path).LinkTarget is not null;\n\n    private static bool TryMove(string from, string to)\n    {\n        try\n        {\n            Directory.Move(from, to);\n            return true;\n        }\n        catch (IOException)\n        {\n            return false;\n        }\n        catch (UnauthorizedAccessException)\n        {\n            return false;\n        }\n    }\n\n    private static void TryDelete(string directory)\n    {\n        try\n        {\n            Directory.Delete(directory, recursive: true);\n        }\n        catch (IOException)\n        {\n        }\n        catch (UnauthorizedAccessException)\n        {\n        }\n    }\n}\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\n/// <summary>\n/// <c>clink</c> locks its stores for the whole run (issue #194): concurrent\n/// <c>--in</c> imports all keep their writes, a held lock fails naming its\n/// owner, and the lock options. The Rust counterpart is\n/// <c>rust/tests/cli_store_lock_tests.rs</c>, the JavaScript one\n/// <c>js/server/test/main-store-lock.test.mjs</c>.\n/// </summary>\npublic sealed class CliStoreLockTests : IDisposable\n{\n    private readonly string _directory = Directory.CreateTempSubdirectory(\"cli-store-lock-\").FullName;\n\n    public void Dispose() => Directory.Delete(_directory, recursive: true);\n\n    private string Db => Path.Combine(_directory, \"s.links\");\n\n    [Theory]\n    [InlineData(null)]\n    [InlineData(\"flock\")]\n    [InlineData(\"pid\")]\n    public async Task ConcurrentImportsAllKeepTheirWrites(string? kind)\n    {\n        string[] lockArguments = kind is null ? [] : [\"--lock\", kind];\n        const int Writers = 8;\n        var imports = Enumerable.Range(1, Writers).Select(index =>\n        {\n            var input = Path.Combine(_directory, $\"in{index}.lino\");\n            File.WriteAllText(input, $\"(w{index}: w{index} w{index})\\n\");\n            return Clink.RunAsync([\"--db\", Db, .. lockArguments, \"--in\", input]);\n        });\n        foreach (var result in await Task.WhenAll(imports)) Clink.AssertSucceeded(result);\n\n        var output = Path.Combine(_directory, \"out.lino\");\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"--out\", output));\n        var exported = await File.ReadAllTextAsync(output);\n        for (var index = 1; index <= Writers; index++)\n        {\n            Assert.Contains($\"(w{index}: w{index} w{index})\", exported, StringComparison.Ordinal);\n        }\n        Assert.DoesNotContain(\n          Directory.GetFileSystemEntries(_directory),\n          entry => entry.EndsWith(\".owner\", StringComparison.Ordinal) || entry.Contains(\".lock.d\", StringComparison.Ordinal));\n    }\n\n    [Fact]\n    public async Task FailsNamingTheOwnerOfAHeldLockAndNoLockPassesItBy()\n    {\n        var directory = StorePidLock.LockDirectoryPath(Db);\n        Directory.CreateDirectory(directory);\n        File.WriteAllText(Path.Combine(directory, \"owner\"), StoreLockOwner.Current(\"held-by-test\").ToRecord());\n\n        var held = await Clink.RunAsync(\"--db\", Db, \"--lock\", \"pid\", \"--lock-timeout\", \"20\", \"() ((1 1))\");\n        Assert.Equal(1, held.ExitCode);\n        Assert.StartsWith(\n          $\"Error: Lock error: store is locked: {directory} is held by pid={Environment.ProcessId} \",\n          held.Stderr,\n          StringComparison.Ordinal);\n        Assert.Contains(\"gave up waiting for the pid lock after 20 ms (--lock-timeout)\", held.Stderr, StringComparison.Ordinal);\n\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"--no-lock\", \"() ((1 1))\"));\n        var after = await Clink.RunAsync(\"--db\", Db, \"--lock\", \"none\", \"--after\");\n        Assert.Equal(\"(1: 1 1)\\n\", after.Stdout);\n    }\n\n    [Fact]\n    public async Task AWriterWaitsForAReaderToFinish()\n    {\n        Clink.AssertSucceeded(await Clink.RunAsync(\"--db\", Db, \"() ((1 1))\"));\n        using var reader = StoreLock.Acquire([Db], LockMode.Shared, new StoreLockOptions { TimeoutMs = 0 });\n        var blocked = await Clink.RunAsync(\"--db\", Db, \"--lock-timeout\", \"0\", \"() ((1 2))\");\n        Assert.Equal(1, blocked.ExitCode);\n        Assert.Contains($\"{Db}.lock is held by shared readers;\", blocked.Stderr, StringComparison.Ordinal);\n        var after = await Clink.RunAsync(\"--db\", Db, \"--lock-timeout\", \"0\", \"--after\");\n        if (OperatingSystem.IsWindows())\n        {\n            // Windows gives the store, mapped for writing, to one process, so\n            // readers there take the lock alone too.\n            Assert.Equal(1, after.ExitCode);\n            Assert.Contains($\"{Db}.lock is held by shared readers;\", after.Stderr, StringComparison.Ordinal);\n            return;\n        }\n        // Elsewhere readers share it.\n        Clink.AssertSucceeded(after);\n        Assert.Equal(\"(1: 1 1)\\n\", after.Stdout);\n    }\n\n    [Fact]\n    public async Task ReadersOfAStoreNotCreatedYetTakeTheLockAlone()\n    {\n","exit_code":0,"status":"completed"}}
