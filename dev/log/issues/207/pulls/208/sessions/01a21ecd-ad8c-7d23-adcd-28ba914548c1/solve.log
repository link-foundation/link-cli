red-pr.diff\n/tmp/link-cli-207-public-client.log\n/tmp/link-cli-207-public-server.log\n/tmp/link-cli-207-python.log\n/tmp/link-cli-207-quality-install.log\n/tmp/link-cli-207-registry-link-cli-client.json\n/tmp/link-cli-207-registry-link-cli-server.json\n/tmp/link-cli-207-regression-before.log\n/tmp/link-cli-207-running-windows.log\n/tmp/link-cli-207-rust-fmt.log\n/tmp/link-cli-207-secretlint.log\n/tmp/link-cli-207-secrets-evidence.log\n/tmp/link-cli-207-server-pack.log\ncsharp/Foundation.Data.Doublets.Cli/bin/Debug\nrust/target/CACHEDIR.TAG\nrust/target/debug\nrust/target/tmp\n","exit_code":0,"status":"completed"}}
