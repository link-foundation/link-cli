te proves it loaded the shared golden fixtures (issue #111)', () => {\n   for (const [name, suite, job] of [\n     ['rust.yml', 'rust', 'test'],\ndiff --git a/.github/scripts/npm-release.test.mjs b/.github/scripts/npm-release.test.mjs\nindex bc5aa186..dec13054 100644\n--- a/.github/scripts/npm-release.test.mjs\n+++ b/.github/scripts/npm-release.test.mjs\n@@ -1,63 +1,20 @@\n import assert from 'node:assert/strict';\n-import { spawnSync } from 'node:child_process';\n-import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\n-import { tmpdir } from 'node:os';\n-import { join } from 'node:path';\n import test from 'node:test';\n+import { readJobs, workflows } from './workflow-files.mjs';\n \n-const workflow = readFileSync(new URL('../workflows/js-client.yml', import.meta.url), 'utf8');\n-const step = workflow.split('      - name: Dry-run the release\\n')[1]?.split(/\\n {6}- name:/)[0];\n-assert.ok(step, 'npm release must validate pull requests');\n-const run = /^ {8}run: (.+)$/m.exec(step);\n-assert.ok(run, 'release validation needs a run command');\n-const script =\n-  run[1] === '|'\n-    ? step\n-        .slice(run.index + run[0].length)\n-        .split('\\n')\n-        .filter((line) => line.startsWith('          '))\n-        .map((line) => line.slice(10))\n-        .join('\\n')\n-    : run[1];\n-\n-test('npm release validation uses the actual registry lookup result', () => {\n-  assert.match(step, /PUBLISHED: \\$\\{\\{ steps\\.check\\.outputs\\.published \\}\\}/);\n-});\n-\n-for (const published of ['true', 'false']) {\n-  test(`npm release validation succeeds when published=${published}`, () => {\n-    const root = mkdtempSync(join(tmpdir(), 'npm-release-136-'));\n-    try {\n-      writeFileSync(\n-        join(root, 'npm'),\n-        `#!/usr/bin/env bash\n-set -eu\n-printf '%s\\\\n' \"$*\" >> \"$INVOCATIONS\"\n-if [[ \"$PUBLISHED\" == true && \"$1\" == publish ]]; then\n-  echo 'You cannot publish over the previously published versions: 0.1.