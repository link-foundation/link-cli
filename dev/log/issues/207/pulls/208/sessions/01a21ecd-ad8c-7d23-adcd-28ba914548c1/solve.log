[2026-11-27T21:44:17.393Z] [STDOUT] {"type":"item.completed","item":{"id":"item_577","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' .pre-commit-config.yaml && sed -n '1,180p' experiments/issue-207/compare-ci-files.py\"","aggregated_output":"# Local mirror of the cheap CI gates, so the same defects fail on `git commit`\n# instead of ten minutes into a workflow run. Ported from the AI driven\n# development pipeline templates for issue #96 and adapted to this monorepo:\n# every hook has to point at the stack-specific manifest, because the three\n# projects live under csharp/, rust/ and js/.\n#\n# Install once with:\n#   pip install pre-commit && pre-commit install\nrepos:\n  - repo: https://github.com/pre-commit/pre-commit-hooks\n    rev: v5.0.0\n    # Preserve verbatim investigation inputs, including large compressed logs.\n    # The separate secrets hook still checks all tracked evidence.\n    exclude: ^(dev/log/|docs/case-studies/)\n    hooks:\n      - id: trailing-whitespace\n      - id: end-of-file-fixer\n      - id: check-yaml\n      - id: check-json\n      - id: check-toml\n      - id: check-xml\n      - id: check-merge-conflict\n      - id: check-added-large-files\n\n  - repo: local\n    hooks:\n      # Mirrors the \"Lint and Format Check\" job of rust.yml.\n      - id: cargo-fmt\n        name: cargo fmt\n        entry: cargo fmt --manifest-path rust/Cargo.toml --all --\n        language: system\n        types: [rust]\n        pass_filenames: false\n\n      - id: cargo-clippy\n        name: cargo clippy\n        entry: cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings\n        language: system\n        types: [rust]\n        pass_filenames: false\n\n      # Mirrors the \"Lint and Format Check\" job of csharp.yml. The solution sets\n      # TreatWarningsAsErrors in csharp/Directory.Build.props, so a plain build\n      # is already the warning gate.\n      - id: dotnet-format\n        name: dotnet format\n        entry: dotnet format csharp --verify-no-changes\n        language: system\n        types: [c#]\n        pass_filenames: false\n\n      # Mirrors the workflow policy and repository layout guards. These are pure\n      # Node with no dependencies, so they are fast enough for every commit.\n      - id: workflow-policy\n        name: workflow policy and repository layout tests\n        entry: node --test .github/scripts/*.test.mjs js/test/*.test.mjs csharp/scripts/*.test.mjs\n        language: system\n        files: ^(\\.github/|js/|csharp/|rust/|\\.lycheeignore|README\\.md)\n        pass_filenames: false\n\n      - id: javascript-quality\n        name: JavaScript lint and formatting\n        entry: node .github/scripts/check-javascript-quality.mjs\n        language: system\n        files: \\.(js|mjs|cjs|jsx)$\n        exclude: ^(dev/log/|docs/case-studies/)\n        pass_filenames: false\n\n      - id: secrets\n        name: secrets in tracked files including ignored evidence\n        entry: node .github/scripts/check-secrets.mjs\n        language: system\n        pass_filenames: false\n\n      - id: python-quality\n        name: Python lint, formatting and CI helper types\n        entry: python .github/scripts/check-python-quality.py\n        language: python\n        additional_dependencies: [ruff==0.17.4, mypy==2.4.1]\n        types: [python]\n        exclude: ^(dev/log/|docs/case-studies/)\n        pass_filenames: false\n\"\"\"Inventory CI inputs from link-cli and downloaded recursive template trees.\"\"\"\n\nimport json\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nTEMPLATES = (\"rust\", \"js\", \"csharp\", \"python\", \"java\", \"cpp\")\n\n\ndef ci_input(path: str) -> bool:\n    \"\"\"Include workflow-owned files, CI helpers, hooks, and root CI policies.\"\"\"\n    filename = Path(path).name\n    return (\n        path.startswith(\n            (\n                \".github/\",\n                \".githooks/\",\n                \".husky/\",\n                \".ci/\",\n                \".config/\",\n                \"ci/\",\n                \"scripts/\",\n                \"parity/\",\n            )\n        )\n        or re.match(r\"^(csharp|js|rust)/scripts/\", path) is not None\n        or re.search(\n            r\"^\\.(pre-commit|lychee|secretlint|actionlint|zizmor|codecov|package-registry-manager\"\n            r\"|prettier|editorconfig|clang-format|shellcheck)\",\n            filename,\n        )\n        is not None\n        or filename.startswith((\"eslint.config.\", \"rustfmt.\"))\n    )\n\n\ndef stem(path: str) -> str:\n    return Path(path).stem.replace(\"_\", \"-\")\n\n\ndef purpose(path: str) -> str:\n    matched = (\n        (\n            \"change detection and stage gate\",\n            r\"detect|fresh-merge|javascript-first|javascript-stage|parity\",\n        ),\n        (\n            \"registry and release\",\n            r\"version|changelog|changeset|release|publish|registry|npm|pypi|nuget|crates|vcpkg|maven|package\",\n        ),\n        (\n            \"workflow validation and status\",\n            r\"workflow|status|gate|policy|concurrency|zizmor|actionlint\",\n        ),\n        (\n            \"security and dependencies\",\n            r\"security|secrets|codeql|audit|depend|sarif|credential|preflight\",\n        ),\n        (\"documentation and links\", r\"docs|lychee|links|web-archive|pages\"),\n        (\n            \"runner and artifact handling\",\n            r\"runner|unacquired|rerun|artifact|archive|budget|buildx\",\n        ),\n        (\n            \"source and test quality\",\n            r\"lint|format|file-size|line-limit|coverage|warnings|test\",\n        ),\n    )\n    for description, pattern in matched:\n        if re.search(pattern, path):\n            return description\n    return \"repository or language-specific infrastructure\"\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n    base = sys.argv[2]\n    local_tree = subprocess.check_output(\n        [\"git\", \"ls-tree\", \"-rz\", base], cwd=ROOT, text=True\n    )\n    local = {}\n    for entry in local_tree.rstrip(\"\\0\").split(\"\\0\"):\n        metadata, path = entry.split(\"\\t\", 1)\n        if ci_input(path):\n            local[path] = metadata.split()[2]\n    snapshots = {\"link-cli\": local}\n    template_paths = {}\n    for name in TEMPLATES:\n        tree = json.loads((directory / f\"{name}-tree.json\").read_text())[\"tree\"]\n        snapshot = {\n            file[\"path\"]: file[\"sha\"]\n            for file in tree\n            if file[\"type\"] == \"blob\" and ci_input(file[\"path\"])\n        }\n        template_paths.update(\n            {f\"{name}/{path}\": digest for path, digest in snapshot.items()}\n        )\n        snapshots[name] = snapshot\n\n    print(\"repository\\tpath\\tblob\\tpurpose\\tother repository matches\")\n    for name, snapshot in snapshots.items():\n        other = template_paths if name == \"link-cli\" else local\n        for path, blob in sorted(snapshot.items()):\n            peers = [\n                f\"{item} ({'identical' if digest == blob else 'same stem'})\"\n                for item, digest in other.items()\n                if digest == blob or stem(item) == stem(path)\n            ]\n            print(name, path, blob, purpose(path), \", \".join(peers) or \"-\", sep=\"\\t\")\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
