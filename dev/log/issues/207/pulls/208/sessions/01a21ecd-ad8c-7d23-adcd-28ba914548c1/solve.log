        \"fingerprint\": \"5a1bed84443ac276\"\n      }\n    },\n    {\n      \"id\": \"engine-core\",\n      \"title\": \"Staged engine: sessions, rows, journal, commit logs, savepoints, branches, group commit\",\n      \"csharp\": {\n        \"status\": \"implemented\",\n        \"sources\": [\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/LinksEngine.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/Engine{Session,Rows,Journal,Savepoint,Fork,QueryReservations}.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/{QueryReservations,QueryAddressScope,QueryMatching,QueryPreview}.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/{CommitLog,DeltaCommitLog,TimedCommitLog,GroupCommit,PessimisticWrites,ConstraintIndex}.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/{ImmutableObjectCache,BackgroundCompaction,ChangeRevisionJournal,RevisionJournal}.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Library/Engine/{JournalMaintenance,SortedRunRows}.cs\"\n        ],\n        \"tests\": [\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/Engine*.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/DeltaCommitLogTests.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/TimedCommitLogTests.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/PessimisticEngineTests.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/SortedRunRowsTests.cs\",\n          \"csharp/Foundation.Data.Doublets.Cli.Tests/JournalLiveTailTests.cs\"\n        ],\n","exit_code":0,"status":"completed"}}
