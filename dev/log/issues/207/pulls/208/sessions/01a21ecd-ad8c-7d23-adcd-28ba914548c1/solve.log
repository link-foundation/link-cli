--dir csharp/.changeset --package-name Foundation.Data.Doublets.Cli\n */\n\nimport { execSync } from 'child_process';\nimport { readFileSync, readdirSync, existsSync } from 'fs';\nimport { join } from 'path';\n\n/**\n * Parse command-line options.\n * @returns {{changesetDir: string, packageName: string}}\n */\nfunction parseArgs() {\n  const args = process.argv.slice(2);\n  const getArg = (name, fallback) => {\n    const index = args.indexOf(`--${name}`);\n    if (index === -1) {\n      return fallback;\n    }\n    return args[index + 1] ?? fallback;\n  };\n\n  return {\n    changesetDir: getArg('dir', process.env.CHANGESET_DIR || 'csharp/.changeset'),\n    packageName: getArg('package-name', process.env.PACKAGE_NAME || 'Foundation.Data.Doublets.Cli'),\n  };\n}\n\nconst { changesetDir, packageName } = parseArgs();\n\n/**\n * Ensure a git commit is available locally, fetching if necessary\n * @param {string} sha The commit SHA to check\n */\nfunction ensureCommitAvailable(sha) {\n  try {\n    execSync(`git cat-file -e ${sha}`, { stdio: 'ignore' });\n  } catch {\n    console.log('Base commit not available locally, attempting fetch...');\n    try {\n      execSync(`git fetch origin ${sha}`, { stdio: 'inherit' });\n    } catch {\n      execSync(`git fetch origin`, { stdio: 'inherit' });\n    }\n  }\n}\n\n/**\n * Parse git diff output and extract added changeset files\n","exit_code":0,"status":"completed"}}
