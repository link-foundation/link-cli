[2026-11-28T00:15:26.370Z] [STDOUT] {"type":"item.completed","item":{"id":"item_1563","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' /tmp/link-cli-207-collect-live.sh && sed -n '1,190p' /tmp/link-cli-207-collect-reviews.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\nrepo=link-foundation/link-cli\nbranch=issue-207-ac4b1e2ba1ef\nlogs=dev/log/issues/207/pulls/208/ci-logs\nmkdir -p \"$logs\"/{reviews,runs}\nfields=databaseId,name,status,conclusion,createdAt,updatedAt,headSha,url,event\ngh run list --repo \"$repo\" --branch \"$branch\" --limit 25 --json \"$fields\" > \"$logs/branch-runs.json.tmp\"\nmv \"$logs/branch-runs.json.tmp\" \"$logs/branch-runs.json\"\ngh run list --repo \"$repo\" --branch main --event push --limit 25 --json \"$fields\" > \"$logs/main-runs.json.tmp\"\nmv \"$logs/main-runs.json.tmp\" \"$logs/main-runs.json\"\n{\n  jq -r --arg head \"$(git rev-parse \"origin/$branch\")\" '.[]|select(.headSha == $head and .status == \"completed\")|[.databaseId,.conclusion]|@tsv' \"$logs/branch-runs.json\"\n  jq -r --arg base \"$(git rev-parse origin/main)\" '.[]|select(.headSha == $base and .status == \"completed\")|[.databaseId,.conclusion]|@tsv' \"$logs/main-runs.json\"\n} | while IFS=$'\\t' read -r id conclusion; do\n  if [[ -f \"$logs/runs/$id.log.gz\" || -f \"$logs/runs/$id.unavailable.txt\" || -f \"${logs%/ci-logs}/runs/$id.log.gz\" ]]; then\n    continue\n  fi\n  gh run view \"$id\" --repo \"$repo\" --json databaseId,name,status,conclusion,createdAt,updatedAt,headSha,url,event,jobs,attempt > \"$logs/runs/$id.json.tmp\"\n  mv \"$logs/runs/$id.json.tmp\" \"$logs/runs/$id.json\"\n  if gh run view \"$id\" --repo \"$repo\" --log 2>\"$logs/runs/$id.stderr\" | gzip -n > \"$logs/runs/$id.log.gz.tmp\"; then\n    mv \"$logs/runs/$id.log.gz.tmp\" \"$logs/runs/$id.log.gz\"\n    rm -f \"$logs/runs/$id.stderr\"\n  else\n    rm -f \"$logs/runs/$id.log.gz.tmp\"\n    if [[ \"$conclusion\" == skipped ]] && rg -q 'log not found|no logs' \"$logs/runs/$id.stderr\"; then\n      mv \"$logs/runs/$id.stderr\" \"$logs/runs/$id.unavailable.txt\"\n    fi\n  fi\n  if [[ \"$conclusion\" == failure || \"$conclusion\" == cancelled || \"$conclusion\" == timed_out ]]; then\n    if ! gh run view \"$id\" --repo \"$repo\" --log-failed > \"$logs/runs/$id.failed.log\" 2>\"$logs/runs/$id.failed.stderr\"; then\n      continue\n    fi\n    rm -f \"$logs/runs/$id.failed.stderr\"\n  fi\n  jq -r '[.databaseId,.name,.conclusion]|@tsv' \"$logs/runs/$id.json\"\ndone\n#!/usr/bin/env bash\nset -euo pipefail\nrepo=link-foundation/link-cli\nlogs=dev/log/issues/207/pulls/208/ci-logs\nfor spec in issues/208/comments pulls/208/comments pulls/208/reviews issues/208/reactions issues/208/timeline; do\n  file=\"$logs/reviews/$(tr / - <<< \"$spec\").json\"\n  gh api \"repos/$repo/$spec\" --paginate --slurp > \"$file.tmp\"\n  mv \"$file.tmp\" \"$file\"\n  jq -r --arg spec \"$spec\" '[.[][]] | [$spec,(length|tostring),([.[]|(.user.login // .actor.login // empty)]|unique|join(\",\"))]|@tsv' \"$file\"\ndone\nfile=\"$logs/reviews/threads.json\"\ngh api graphql -f query='query {\n  repository(owner:\"link-foundation\",name:\"link-cli\") {\n    pullRequest(number:208) {\n      reviewThreads(first:50) {\n        nodes { id isResolved isOutdated comments(first:20) { nodes { author { login } body url createdAt } } }\n        pageInfo { hasNextPage }\n      }\n    }\n  }\n}' > \"$file.tmp\"\nmv \"$file.tmp\" \"$file\"\njq -r '.data.repository.pullRequest.reviewThreads.nodes|[length,([.[]|select(.isResolved == false)]|length)]|@tsv' \"$file\"\n","exit_code":0,"status":"completed"}}
