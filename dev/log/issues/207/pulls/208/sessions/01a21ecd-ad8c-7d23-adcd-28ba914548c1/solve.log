[2026-11-27T22:25:07.569Z] [STDOUT] {"type":"item.completed","item":{"id":"item_869","type":"command_execution","command":"/bin/bash -lc \"sed -n '68,167p' js/client/test/support/ipc-listener.mjs && sed -n '196,233p' js/client/test/ipc-endpoint.test.mjs && rg -n 'Windows|case|timeline|Upcoming|Verification' docs/case-studies/issue-207/README.md; cat /tmp/link-cli-207-pr-body.md\"","aggregated_output":"}\n\n/**\n * Listens on the rendezvous directory `dir` for `kind`: every request goes to\n * `answer(id, request)`, which resolves to the ack fields (the default opens\n * the kind's channel and hands the server stream to `onStream`). `null`\n * leaves the request unanswered. A `fifo` or `pipe` greeting waits\n * `greetAfter` ms.\n */\nexport class Listener {\n  #timer;\n  #busy = false;\n  streams = [];\n  requests = [];\n\n  constructor(dir, kind, { answer, onStream = () => {}, fields = {}, greetAfter = 0 } = {}) {\n    this.dir = dir;\n    this.kind = kind;\n    this.greetAfter = greetAfter;\n    this.answer = answer ?? ((id, request) => this.#open(id, request));\n    this.onStream = onStream;\n    writeListener(dir, { kind: kind === 'pipe' ? 'fifo' : kind, ...fields });\n    this.#timer = setInterval(() => this.#scan(), 2);\n  }\n\n  async #scan() {\n    if (this.#busy) return;\n    this.#busy = true;\n    try {\n      for (const name of fs.readdirSync(this.dir)) {\n        if (!name.endsWith('.req')) continue;\n        const id = name.slice(0, -'.req'.length);\n        const file = path.join(this.dir, name);\n        const request = JSON.parse(fs.readFileSync(file, 'utf8'));\n        fs.rmSync(file);\n        this.requests.push(request);\n        const ack = await this.answer(id, request);\n        if (ack !== null) {\n          writeAtomically(path.join(this.dir, `${id}.ack`), toJson({ v: 1, ...ack }));\n        }\n      }\n    } finally {\n      this.#busy = false;\n    }\n  }\n\n  #open(id, request) {\n    const file = (suffix) => path.join(this.dir, `${id}.${suffix}`);\n    if (this.kind === 'fifo' || this.kind === 'pipe') {\n      const { O_RDONLY, O_WRONLY, O_NONBLOCK } = fs.constants;\n      const incoming = fs.openSync(file('c2s'), O_RDONLY | O_NONBLOCK);\n      const outgoing = fs.openSync(file('s2c'), O_WRONLY | O_NONBLOCK);\n      const reader = new net.Socket({ fd: incoming, readable: true, writable: false });\n      const writer = new net.Socket({ fd: outgoing, readable: false, writable: true });\n      const greet = () => {\n        writer.write(Buffer.of(0));\n        this.#hand(new JoinedStream(reader, writer, { greeting: true }));\n      };\n      if (this.greetAfter > 0) setTimeout(greet, this.greetAfter);\n      else greet();\n      return { pid: process.pid };\n    }\n    const region = this.kind === 'shm' ? `/dev/shm/lc${id}` : file(SUFFIX[this.kind]);\n    const size = fs.statSync(region).size;\n    const signal = this.kind === 'signal';\n    const notifier = signal ? new SignalNotifier(request.pid, request.signal) : new PollNotifier(1);\n    this.#hand(\n      new RingStream({\n        kind: this.kind,\n        region: new FileRegion(fs.openSync(region, 'r+'), size),\n        client: false,\n        notifier,\n        peerPid: request.pid,\n      }),\n    );\n    return signal ? { pid: process.pid, signal: request.signal } : { pid: process.pid };\n  }\n\n  #hand(stream) {\n    this.streams.push(stream);\n    this.onStream(stream);\n  }\n\n  close() {\n    clearInterval(this.#timer);\n    for (const stream of this.streams) stream.destroy();\n    fs.rmSync(path.join(this.dir, 'listener.json'), { force: true });\n  }\n}\n\n/**\n * A `udp:` listener on `host`: answers each HELLO with a WELCOME (its token\n * and `chunk`) from a fresh socket, then runs a session on that socket.\n * `welcome(own, reply)` may send other frames first, or return false to stay\n * silent; `early` frames follow the WELCOME at once.\n */\nexport async function udpListener({\n  host = '127.0.0.1',\n  chunk = 1200,\n  early = [],\n\ntest('random ids are twenty hex digits', () => {\n  const [a, b] = [randomId(), randomId()];\n  assert.match(a, /^[0-9a-f]{20}$/);\n  assert.notEqual(a, b);\n});\n\nconst ringPair = (capacity) => {\n  const region = new MemoryRegion(regionSize(capacity));\n  initialize(region, capacity);\n  const side = (client) =>\n    new RingStream({\n      kind: 'test',\n      region,\n      client,\n      notifier: new PollNotifier(1),\n      peerPid: process.pid,\n    });\n  return [side(true), side(false), region];\n};\n\ntest('a ring carries both directions through wrap-around and ends', async () => {\n  const [client, server, region] = ringPair(64);\n  const up = payload(5_000, 1);\n  const down = payload(3_333, 2);\n  const [atServer, atClient] = [collect(server), collect(client)];\n  client.end(up);\n  server.end(down);\n  assert.deepEqual(await atServer, up);\n  assert.deepEqual(await atClient, down);\n  // Writer state 1 (ended) on both rings.\n  assert.equal(region.bytes.readUInt32LE(64 + 8), 1);\n  assert.equal(region.bytes.readUInt32LE(64 + 128 + 64 + 8), 1);\n  client.destroy();\n  server.destroy();\n});\n\ntest('a ring hang-up ends the peer stream after the data before it', async () => {\n11:| 20:18–20:21 | After the C# release advanced `main` to `df8b0f8`, JS client conformance for `03f44dd` was cancelled while reopening native pages. The earlier Rust Windows test was cancelled mid-suite. Their status gates correctly rejected the cancellations. |\n17:| 21:53 | The Windows Rust suite and release jobs finished on `d8a26c9`. The JS server registry preflight remained the only failed workflow on that main revision. [Rust pipeline](https://github.com/link-foundation/link-cli/actions/runs/46067149253) · [Server preflight](https://github.com/link-foundation/link-cli/actions/runs/46067149214) |\n18:| 22:11 | All 14 workflows passed on the first PR revision, `b2c74235`. Windows Rust passed the full suite, golden receipt check and native LSM example runs within its existing budget. [Rust pipeline](https://github.com/link-foundation/link-cli/actions/runs/46069793342) |\n33:| Deliver one PR with evidence and release verification | [PR #208](https://github.com/link-foundation/link-cli/pull/208) owns this work. Issue #207 had no required sub-issues or blocking-issue links when its timeline was captured. npm server release remains dependent on maintainer setup. |\nFixes #207\n\n## Changes\n\n- Keep read-only checks for each default-branch revision and independent dispatch. Replace only superseded PR synchronization checks. Queue repository release writers so a later publish cannot displace a pending one.\n- Remove the generated root `.gitkeep`. Preserve required status checks, language stage order, and golden fixture receipts.\n- Verify the replacement etcd leader while the original member is paused. After it rejoins, verify convergence, refusal of the stale transaction, and a linearizable read through the resumed member. Set `ETCD_TEST_VERBOSE=1` or dispatch JS Client CI with **Record etcd election status and member debug logs** to capture election evidence.\n- Validate both npm tarballs and their size against the JS template’s budget on pull requests and checks-only dispatches. Main publishing requires a successful trusted-publisher preflight. A separate read-only job downloads the exact published version anonymously. Registry diagnostics distinguish package setup from a lookup outage.\n- Cover shared stage inputs and integration examples in JS package triggers. Enforce a 30-minute workflow job timeout ceiling with documented caps for longer suites and release jobs. Resolve the Rust and C# source-size warnings and include release fragments.\n\n## Reproduce and verify\n\n- Draft #208 at `26852bd` fails `node --test js/test/repositoryLayout.test.mjs`. This test passes after removal of the placeholder.\n- The original run reproduces the etcd failure. JS Client CI runs the real cluster in both journal modes. Run `node --test experiments/issue-138/etcd-harness.test.mjs` for the focused election checks. [Original failure](https://github.com/link-foundation/link-cli/actions/runs/46062568123)\n- Overlapping `main` revisions cancelled conformance and Rust tests. Run the CI governance and workflow policy tests in `.github/scripts` to exercise the policy. [Client cancellation](https://github.com/link-foundation/link-cli/actions/runs/46059980457) · [Rust cancellation](https://github.com/link-foundation/link-cli/actions/runs/46059980682)\n- Hosted etcd passed the revised scenario in both journal modes. The anonymous package check downloaded `@link-foundation/link-cli-client@0.5.0` and reproduced npm HTTP 404 for `@link-foundation/link-cli-server@0.1.1`. [Hosted conformance](https://github.com/link-foundation/link-cli/actions/runs/46069793278/job/140744356887)\n- Run `npm --prefix js run lint`, `npm --prefix js run test:js`, `node parity/check-parity.mjs --base origin/main`, and `npm pack --dry-run --json | node ../../.github/scripts/check-npm-tarball-size.mjs` from each npm package directory.\n- This environment has no installed pre-commit hooks. The relevant checks were run manually, including workflow policy, JavaScript and Python quality, secrets, Rust formatting and lint, .NET formatting on the CI SDK, Actionlint and zizmor.\n\n## Registry setup still needed\n\nThe npm server package is absent from the public registry, and its OIDC exchange returns HTTP 404. An npm scope maintainer needs to publish the first public version or make an existing private package public, configure GitHub trusted publishing for `link-foundation/link-cli` and `js-server.yml`, and run JS server CI on `main` with **Verify npm trusted publishing** enabled before retrying the main workflow. The PR’s tarball and code checks run independently. The real publishing criterion remains open until the maintainer steps and main verification succeed. [Failed preflight](https://github.com/link-foundation/link-cli/actions/runs/46067149214)\n\n## Evidence and upstream reports\n\n- [Investigation, timeline and requirements](https://github.com/link-foundation/link-cli/blob/issue-207-ac4b1e2ba1ef/docs/case-studies/issue-207/README.md)\n- [Run logs, template file comparison and local verification](https://github.com/link-foundation/link-cli/blob/issue-207-ac4b1e2ba1ef/dev/log/issues/207/pulls/208/README.md)\n- [Rust template #275](https://github.com/link-foundation/rust-ai-driven-development-pipeline-template/issues/275), [JS template #325](https://github.com/link-foundation/js-ai-driven-development-pipeline-template/issues/325), [C# template #121](https://github.com/link-foundation/csharp-ai-driven-development-pipeline-template/issues/121), [Python template #173](https://github.com/link-foundation/python-ai-driven-development-pipeline-template/issues/173), [Java template #39](https://github.com/link-foundation/java-ai-driven-development-pipeline-template/issues/39), [C++ template #45](https://github.com/link-foundation/cpp-ai-driven-development-pipeline-template/issues/45), [Hive Mind #4186](https://github.com/link-assistant/hive-mind/issues/4186)\n","exit_code":0,"status":"completed"}}
