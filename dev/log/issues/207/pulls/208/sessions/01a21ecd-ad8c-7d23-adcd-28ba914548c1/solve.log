[2026-11-27T21:45:29.814Z] [STDOUT] {"type":"item.completed","item":{"id":"item_607","type":"command_execution","command":"/bin/bash -lc \"sed -n '340,408p' .github/workflows/js-server.yml && sed -n '595,665p' .github/workflows/js-client.yml && sed -n '1,200p' .github/workflows/dependencies.yml\"","aggregated_output":"  release:\n    name: Release to npm\n    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.release-preflight.result == 'success'\n    needs: [release-preflight, package-check, unit, portability, differential]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    # Writer group: never cancel a publish that may already be under way.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: read\n      # Trusted publishing and npm provenance use a GitHub OIDC token.\n      id-token: write\n    defaults:\n      run:\n        working-directory: js/server\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Check whether this version is published\n        id: check\n        run: |\n          name=$(node -p \"require('./package.json').name\")\n          version=$(node -p \"require('./package.json').version\")\n          # Only E404 means \"not published\". Any other failure (an unreachable\n          # registry, a 5xx after npm's own retries) must not count as \"not on\n          # npm yet\", or main would try to publish an existing version.\n          if output=$(npm view \"$name@$version\" version 2>&1); then\n            echo \"$name@$version is already on npm.\"\n            echo \"published=true\" >> \"$GITHUB_OUTPUT\"\n          elif grep -q 'code E404' <<< \"$output\"; then\n            echo \"$name@$version is not on npm yet.\"\n            echo \"published=false\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"$output\"\n            echo \"::error title=npm lookup failed::Could not ask npm whether $name@$version is published. How to fix: re-run the job.\"\n            exit 1\n          fi\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n\n      # The package's OIDC policy is verified through the authentication-only\n      # dispatch above (issue #136). No long-lived publishing token is used.\n      - name: Publish to npm\n        if: steps.check.outputs.published == 'false'\n        env:\n          VERSION: ${{ steps.check.outputs.version }}\n        run: | # zizmor: ignore[adhoc-packages] -- exact pinned release, see below\n          # Trusted publishing needs npm 11.5.1+. Pinned to an exact release\n          # of the 11 line (Node.js ^20.17.0 || >=22.9.0, so 26.x included),\n          # so the npm that publishes does not change with the runner's Node.js.\n          npm install --global npm@11.21.1\n          if npm publish --access public --provenance --loglevel verbose; then\n            exit 0\n          fi\n          echo \"::error title=npm trusted publishing failed::@link-foundation/link-cli-server $VERSION could not be published. Add this repository and js-server.yml as a trusted publisher of @link-foundation/link-cli-server on npmjs.com (a maintainer publishes the first version by hand if the package does not exist yet), run the authentication-only verification dispatch, then retry.\"\n          exit 1\n\n  pipeline-status:\n    name: Pipeline Status (js-server)\n    name: Release to npm\n    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.release-preflight.result == 'success'\n    needs: [release-preflight, package-check, unit, conformance]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    # Writer group: never cancel a publish that may already be under way.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: read\n      # Trusted publishing and npm provenance use a GitHub OIDC token.\n      id-token: write\n    defaults:\n      run:\n        working-directory: js/client\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          registry-url: 'https://registry.npmjs.org'\n\n      - name: Check whether this version is published\n        id: check\n        run: |\n          name=$(node -p \"require('./package.json').name\")\n          version=$(node -p \"require('./package.json').version\")\n          # Only E404 means \"not published\". Any other failure (an unreachable\n          # registry, a 5xx after npm's own retries) used to count as \"not on\n          # npm yet\", so main then tried to publish an existing version.\n          if output=$(npm view \"$name@$version\" version 2>&1); then\n            echo \"$name@$version is already on npm.\"\n            echo \"published=true\" >> \"$GITHUB_OUTPUT\"\n          elif grep -q 'code E404' <<< \"$output\"; then\n            echo \"$name@$version is not on npm yet.\"\n            echo \"published=false\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"$output\"\n            echo \"::error title=npm lookup failed::Could not ask npm whether $name@$version is published. How to fix: re-run the job.\"\n            exit 1\n          fi\n          echo \"version=$version\" >> \"$GITHUB_OUTPUT\"\n\n      # The package's OIDC policy is verified through the authentication-only\n      # dispatch above (issue #136). No long-lived publishing token is used.\n      - name: Publish to npm\n        if: steps.check.outputs.published == 'false'\n        env:\n          VERSION: ${{ steps.check.outputs.version }}\n        run: | # zizmor: ignore[adhoc-packages] -- exact pinned release, see below\n          # Trusted publishing needs npm 11.5.1+. Pinned to an exact release\n          # of the 11 line (Node.js ^20.17.0 || >=22.9.0, so 26.x included),\n          # so the npm that publishes does not change with the runner's Node.js.\n          npm install --global npm@11.21.1\n          if npm publish --access public --provenance --loglevel verbose; then\n            exit 0\n          fi\n          echo \"::error title=npm trusted publishing failed::@link-foundation/link-cli-client $VERSION could not be published. Check the js-client.yml trusted publisher policy on npmjs.com (including permission to publish directly), then run the authentication-only verification dispatch and retry.\"\n          exit 1\n\n  pipeline-status:\n    name: Pipeline Status (js-client)\n    needs:\n      - javascript\n      - release-preflight\nname: Dependencies\n\n# Every dependency stays on its latest release (PR #106 review): Cargo crates\n# and their lock files, NuGet packages, npm packages, GitHub Actions, and the\n# Node.js and .NET versions the workflows set up. Dependabot\n# (.github/dependabot.yml) opens the pull requests that bump them; this check\n# fails while anything is still behind, on every pull request and daily on\n# main, so a new upstream release is noticed within a day. A dependency that\n# cannot be updated yet carries a comment linking the open issue that blocks\n# it (issue #104); see the header of check-latest-dependencies.mjs.\n\non:\n  push:\n    branches: [main]\n  pull_request:\n    types: [opened, synchronize, reopened]\n  schedule:\n    - cron: '0 5 * * *'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  # A dependency held back by a manifest comment links an issue; the check\n  # reads that issue to make sure it is still open. The tracking-issue job\n  # alone gets issues: write.\n  issues: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git, which otherwise prints the\n# default-branch hint into every log.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # === STAGE GATE (issue #111) ===\n  # Jobs that install Rust or .NET wait for the JavaScript stage (lint,\n  # `npm run test:js`, parity check) of the same commit; a failed, cancelled\n  # or skipped stage leaves them skipped.\n  javascript:\n    name: javascript\n    uses: ./.github/workflows/javascript-stage.yml\n\n  latest:\n    name: Dependencies are on their latest versions\n    needs: [javascript]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-${{ github.event_name }}-latest\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Compare every dependency with its registry\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n          CHECK_DEPENDENCIES_MODE: ${{ github.event_name == 'push' && 'report' || 'enforce' }}\n        run: node .github/scripts/check-latest-dependencies.mjs\n\n  # A red check on main used to stay silently red (issue #111): the daily\n  # runs of 2026-10-08 and 2026-10-09 failed and nobody acted. A failure on\n  # main now opens or updates a tracking issue. A passing enforcement audit\n  # on main closes it. A push runs in report mode, so a passing push audit\n  # alone cannot confirm that the issue is resolved.\n  tracking-issue:\n    name: Track a red check on main\n    needs:\n      - javascript\n      - latest\n    if: >-\n      ${{ !cancelled() && github.ref == 'refs/heads/main' &&\n      (github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' ||\n      needs.latest.result == 'failure' || needs.javascript.result == 'failure') }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: dependencies-tracking-${{ github.ref }}\n      cancel-in-progress: false\n    permissions:\n      contents: read\n      issues: write\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Open, update or close the tracking issue\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          GITHUB_TOKEN: ${{ github.token }}\n          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\n          TRACKING_ISSUE_DEBUG: ${{ runner.debug }}\n        run: node .github/scripts/dependency-tracking-issue.mjs\n\n  pipeline-status:\n    name: Pipeline Status (dependencies)\n    needs:\n      - javascript\n      - latest\n      - tracking-issue\n    if: ${{ !cancelled() }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-pipeline-status\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Check every prerequisite\n        working-directory: .\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n        run: node .github/scripts/pipeline-status.mjs\n","exit_code":0,"status":"completed"}}
