ple finite child supervision from caller context\n\n .../FiniteExitChild.cs                             | 12 ++--\n .../FiniteExitChildTests.cs                        | 13 +++-\n .../FiniteExitContextTests.cs                      | 61 ++++++++++++++++\n .../issues/138/pulls/139/phase-context-before.txt  | 52 ++++++++++++++\n dev/log/issues/138/pulls/139/phase-context.txt     | 31 ++++++++\n .../138/pulls/139/reclaiming-chunks-ci-before.txt  | 27 +++++++\n docs/case-studies/issue-138/PHASE-CONTEXT-PLAN.md  | 34 +++++++++\n docs/case-studies/issue-138/PLAN.md                | 20 ++++++\n docs/case-studies/issue-138/VERIFICATION.md        | 19 +++++\n .../phase-context-probe/PhaseContextProbe.csproj   | 13 ++++\n .../issue-138/phase-context-probe/Program.cs       | 82 ++++++++++++++++++++++\n experiments/issue-138/run-phase-context-before.sh  | 21 ++++++\n 12 files changed, 378 insertions(+), 7 deletions(-)\nd4d18960 fix(csharp): lock clink stores for the whole run (#194)\n949ecb2f fix(js): lock clink stores and save through unique temp files (#194)\nbd65b9ec fix(rust): keep the flock owner record in <db>.lock.owner (#194)\n090bc9d8 fix(rust): lock clink stores and save through unique temp files (#194)\n491e263a chore(deps): update links-notation to 0.31.5 (#111)\n57817cb9 fix(ipc): read a socket shut both ways on macOS and wake a stopping server's readers on Windows\n555de0a8 feat(js-client): connect to every IPC endpoint, natively or through clink\n90d9a675 fix(links): treat lychee's timed-out links as failures (issue #172)\n1f286358 fix(ci): restore cargo caches everywhere but save them only from main (issue #172)\n6559ccf1 test(etcd): delay the slow leader past etcd's longest randomized election timeout\n6a47d862 test(etcd): slow real peer links past the election timeout\nfba5259e feat(rust): a store kept as a cache, with deadlines and eviction of what is used least\n09f30ab9 docs: specify causal reconciliation from primary sources and finite models\n950bcb34 test: supervise finite children independently of shared workers\n9e23b1fb test: decouple finite child supervision from caller context\n3dfbc742 test: supervise finite version exits by phase progress\nf523b5cc test: supervise finite movement phases before enforcing idle deadline\n5155c804 fix(js): preserve queued requests when deadlines expire during registration\nusing System.Collections.Concurrent;\n\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\npublic class FiniteExitContextTests\n{\n    [Fact(Timeout = 15000)]\n    public async Task DeferredCallerContextCannotDelayFiniteProgressSupervision()\n    {\n        await FiniteExitChild.WithDirectory(\"finite-exit-context-\", async directory =>\n        {\n            using var child = FiniteExitChildTests.Start(directory, \"deferred-context\");\n            var context = new DeferredContext();\n            Task? supervision = null;\n            try\n            {\n                using var readyDeadline = new CancellationTokenSource(TimeSpan.FromSeconds(5));\n                while (!File.Exists(Path.Combine(directory, \"ready\"))) await Task.Delay(10, readyDeadline.Token);\n                var previous = SynchronizationContext.Current;\n                try\n                {\n                    SynchronizationContext.SetSynchronizationContext(context);\n                    supervision = FiniteExitChild.Wait(child, 0, \"deferred context control\", TimeSpan.FromMilliseconds(500));\n                }\n                finally { SynchronizationContext.SetSynchronizationContext(previous); }\n                // Release actual work only after supervision starts, so a busy\n                // runner cannot finish all phases before the controlled await.\n                File.WriteAllText(Path.Combine(directory, \"continue\"), \"continue\");\n                using var deadline = new CancellationTokenSource(TimeSpan.FromSeconds(5));\n                await child.WaitForExitAsync(deadline.Token);\n                int queuedBeforeDrain = context.Count;\n                // Deliberately service the caller only after the finite child\n                // finishes. Progress capture must run independently of it.\n                while (!supervision.IsCompleted)\n                {\n                    context.Drain();\n                    await Task.Delay(10, deadline.Token);\n                }\n                await supervision;\n                Assert.Equal(0, queuedBeforeDrain);\n                Assert.Equal(0, context.Count);\n                File.Delete(Path.Combine(directory, \"held\"));\n            }\n            finally\n            {\n                if (!child.HasExited) { child.Kill(entireProcessTree: true); await child.WaitForExitAsync(); }\n                context.Drain();\n                if (supervision is not null)\n                    try { await supervision; } catch { /* Preserve the primary failure above. */ }\n            }\n        });\n    }\n\n    private sealed class DeferredContext : SynchronizationContext\n    {\n        private readonly ConcurrentQueue<(SendOrPostCallback Callback, object? State)> callbacks = new();\n        internal int Count => callbacks.Count;\n        public override void Post(SendOrPostCallback callback, object? state) => callbacks.Enqueue((callback, state));\n        internal void Drain() { while (callbacks.TryDequeue(out var item)) item.Callback(item.State); }\n    }\n}\nrg: csharp/Foundation.Data.Doublets.Cli.Library/*Job*: No such file or directory (os error 2)\ncsharp/Foundation.Data.Doublets.Cli.Library/TransactionsDecorator.cs:489:            _backgroundWorker.GetAwaiter().GetResult();\n","exit_code":0,"status":"completed"}}
