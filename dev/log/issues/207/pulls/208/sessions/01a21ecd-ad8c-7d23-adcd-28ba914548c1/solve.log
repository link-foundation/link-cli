[2026-11-27T23:33:52.600Z] [STDOUT] {"type":"item.completed","item":{"id":"item_1301","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' .pre-commit-config.yaml && git diff -- .github/workflows/csharp.yml csharp/Foundation.Data.Doublets.Cli.Tests/VersionMovementRestartFailureTests.cs\"","aggregated_output":"# Local mirror of the cheap CI gates, so the same defects fail on `git commit`\n# instead of ten minutes into a workflow run. Ported from the AI driven\n# development pipeline templates for issue #96 and adapted to this monorepo:\n# every hook has to point at the stack-specific manifest, because the three\n# projects live under csharp/, rust/ and js/.\n#\n# Install once with:\n#   pip install pre-commit && pre-commit install\nrepos:\n  - repo: https://github.com/pre-commit/pre-commit-hooks\n    rev: v5.0.0\n    # Preserve verbatim investigation inputs, including large compressed logs.\n    # The separate secrets hook still checks all tracked evidence.\n    exclude: ^(dev/log/|docs/case-studies/)\n    hooks:\n      - id: trailing-whitespace\n      - id: end-of-file-fixer\n      - id: check-yaml\n      - id: check-json\n      - id: check-toml\n      - id: check-xml\n      - id: check-merge-conflict\n      - id: check-added-large-files\n\n  - repo: local\n    hooks:\n      # Mirrors the \"Lint and Format Check\" job of rust.yml.\n      - id: cargo-fmt\n        name: cargo fmt\n        entry: cargo fmt --manifest-path rust/Cargo.toml --all --\n        language: system\n        types: [rust]\n        pass_filenames: false\n\n      - id: cargo-clippy\n        name: cargo clippy\n        entry: cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings\n        language: system\n        types: [rust]\n        pass_filenames: false\n\n      # Mirrors the \"Lint and Format Check\" job of csharp.yml. The solution sets\n      # TreatWarningsAsErrors in csharp/Directory.Build.props, so a plain build\n      # is already the warning gate.\n      - id: dotnet-format\n        name: dotnet format\n        entry: dotnet format csharp --verify-no-changes\n        language: system\n        types: [c#]\n        pass_filenames: false\n\n      # Mirrors the workflow policy and repository layout guards. These are pure\n      # Node with no dependencies, so they are fast enough for every commit.\n      - id: workflow-policy\n        name: workflow policy and repository layout tests\n        entry: node --test .github/scripts/*.test.mjs js/test/*.test.mjs csharp/scripts/*.test.mjs\n        language: system\n        files: ^(\\.github/|js/|csharp/|rust/|\\.lycheeignore|README\\.md)\n        pass_filenames: false\n\n      - id: javascript-quality\n        name: JavaScript lint and formatting\n        entry: node .github/scripts/check-javascript-quality.mjs\n        language: system\n        files: \\.(js|mjs|cjs|jsx)$\n        exclude: ^(dev/log/|docs/case-studies/)\n        pass_filenames: false\n\n      - id: secrets\n        name: secrets in tracked files including ignored evidence\n        entry: node .github/scripts/check-secrets.mjs\n        language: system\n        pass_filenames: false\n\n      - id: python-quality\n        name: Python lint, formatting and CI helper types\n        entry: python .github/scripts/check-python-quality.py\n        language: python\n        additional_dependencies: [ruff==0.17.4, mypy==2.4.1]\n        types: [python]\n        exclude: ^(dev/log/|docs/case-studies/)\n        pass_filenames: false\ndiff --git a/.github/workflows/csharp.yml b/.github/workflows/csharp.yml\nindex a68934dc..eefa69d6 100644\n--- a/.github/workflows/csharp.yml\n+++ b/.github/workflows/csharp.yml\n@@ -333,6 +333,7 @@ jobs:\n       - name: Run tests\n         env:\n           GOLDEN_FIXTURES_RECEIPT: ${{ runner.temp }}/golden-csharp.json\n+          LINK_CSHARP_RECOVERY_TRACE: ${{ vars.CI_VERBOSE == 'true' && '1' || '0' }}\n         run: dotnet test --no-build --configuration Release --verbosity normal --collect:\"XPlat Code Coverage;Format=json,cobertura\"\n \n       - name: Verify every compiled causal branch\ndiff --git a/csharp/Foundation.Data.Doublets.Cli.Tests/VersionMovementRestartFailureTests.cs b/csharp/Foundation.Data.Doublets.Cli.Tests/VersionMovementRestartFailureTests.cs\nindex 53c1100f..90868356 100644\n--- a/csharp/Foundation.Data.Doublets.Cli.Tests/VersionMovementRestartFailureTests.cs\n+++ b/csharp/Foundation.Data.Doublets.Cli.Tests/VersionMovementRestartFailureTests.cs\n@@ -1,11 +1,38 @@\n+using System.Diagnostics;\n using Platform.Data;\n using Platform.Data.Doublets;\n+using Xunit.Abstractions;\n using static Foundation.Data.Doublets.Cli.Tests.VersionPublicationIntentFailureTests;\n \n namespace Foundation.Data.Doublets.Cli.Tests;\n \n-public class VersionMovementRestartFailureTests\n+public class VersionMovementRestartFailureTests(\n+  VersionMovementRestartFailureTests.InterruptedMovement fixture, ITestOutputHelper output)\n+  : IClassFixture<VersionMovementRestartFailureTests.InterruptedMovement>\n {\n+    public sealed class InterruptedMovement : IAsyncLifetime\n+    {\n+        private readonly string _directory = Directory.CreateTempSubdirectory(\"movement-restart-image-\").FullName;\n+        internal (uint Id, long Original, long Attempted) Position { get; private set; }\n+\n+        // All cases start at the same persisted cut. Each recovery runs on\n+        // its own copy, so no case can change the fixture or another case.\n+        public async Task InitializeAsync() =>\n+            Position = await VersionProcessExitTests.ExitChild(_directory, \"intent-flush-after\", true, \"movement-exit\");\n+\n+        internal void CopyTo(string directory)\n+        {\n+            foreach (var file in Directory.EnumerateFiles(_directory))\n+                File.Copy(file, Path.Combine(directory, Path.GetFileName(file)));\n+        }\n+\n+        public Task DisposeAsync()\n+        {\n+            Directory.Delete(_directory, recursive: true);\n+            return Task.CompletedTask;\n+        }\n+    }\n+\n     public static TheoryData<string> Cases\n     {\n         get\n@@ -21,25 +48,40 @@ public class VersionMovementRestartFailureTests\n     [MemberData(nameof(Cases))]\n     public async Task FailedConstructorKeepsRecoveryOwnerReachable(string point)\n     {\n-        await FiniteExitChild.WithDirectory(\"movement-restart-failure-\", async directory =>\n+        await FiniteExitChild.WithDirectory(\"movement-restart-failure-\", directory =>\n         {\n-            var (id, original, attempted) = await VersionProcessExitTests.ExitChild(directory, \"intent-flush-after\", true, \"movement-exit\");\n+            var elapsed = Stopwatch.StartNew();\n+            var verbose = Environment.GetEnvironmentVariable(\"LINK_CSHARP_RECOVERY_TRACE\") == \"1\";\n+            void Phase(string phase)\n+            {\n+                if (verbose)\n+                    output.WriteLine($\"{point}: {phase} at {elapsed.ElapsedMilliseconds} ms (queued work: {ThreadPool.PendingWorkItemCount})\");\n+            }\n+\n+            fixture.CopyTo(directory);\n+            var (id, original, attempted) = fixture.Position;\n+            Phase(\"copied interrupted movement\");\n             using var data = new NamedTypesDecorator<uint>(Path.Combine(directory, \"data.links\"));\n             using var log = new NamedTypesDecorator<uint>(Path.Combine(directory, \"log.links\"));\n             var fault = new Fault { Point = point, Flushes = 1 };\n+            if (verbose) fault.OnCheck = Phase;\n             using var branches = new Metadata(Path.Combine(directory, \"branches.links\"), fault);\n             using var tx = new TransactionsDecorator(data, log);\n+            Phase(\"opened stores\");\n             try\n             {\n                 var error = Assert.Throws<IOException>(() => new VersionControlDecorator(tx, branches));\n+                Phase(\"first recovery attempt returned\");\n                 Assert.Contains(point, error.Message);\n                 Assert.Throws<InvalidOperationException>(() => tx.CreateAndUpdate(71u, 72u));\n                 Assert.Throws<InvalidOperationException>(() => tx.BeginTransaction());\n                 Assert.Throws<InvalidOperationException>(() => tx.Shutdown());\n                 fault.Point = \"flush-before\";\n                 Assert.Throws<IOException>(() => new VersionControlDecorator(tx, branches));\n+                Phase(\"second recovery attempt returned\");\n                 Assert.Throws<InvalidOperationException>(() => tx.CreateAndUpdate(71u, 72u));\n                 using var recovered = new VersionControlDecorator(tx, branches);\n+                Phase(\"recovered version\");\n                 Assert.Equal(VersionMovementExitTests.Topic, recovered.CurrentBranch);\n                 Assert.Equal(original, recovered.CurrentSequence);\n                 Assert.Equal(11u, recovered.GetSource(id));\n@@ -47,13 +89,16 @@ public class VersionMovementRestartFailureTests\n                 recovered.Update(new[] { id }, new[] { id, 31u, 32u }, null);\n                 Assert.Equal(attempted + 1, recovered.CurrentSequence);\n                 data.Flush(); log.Flush(); branches.Flush();\n+                Phase(\"flushed recovered stores\");\n             }\n             finally\n             {\n                 // Release fixture resources even when the pre-fix orphaned\n                 // lease makes the assertions fail. No following writes occur.\n                 tx.FinishVersionReplay();\n+                Phase(\"released recovery owner\");\n             }\n+            return Task.CompletedTask;\n         });\n     }\n }\n","exit_code":0,"status":"completed"}}
