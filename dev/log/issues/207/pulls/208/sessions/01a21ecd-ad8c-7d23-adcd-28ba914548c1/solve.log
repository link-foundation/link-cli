ke-checkpoint-page-vectors.py'\n      - 'experiments/issue-138/make-checkpoint-root-vectors.py'\n      - 'experiments/issue-138/make-maintenance-vectors.py'\n      - 'experiments/issue-138/verify-maintenance-lazy.mjs'\n      - 'experiments/issue-138/*reclamation*'\n      - 'experiments/issue-138/native-checkpoint-cut.mjs'\n      - 'experiments/issue-138/*chunk*'\n  pull_request:\n    branches:\n      - main\n    paths:\n      - '.github/workflows/js-client.yml'\n      - '.github/scripts/**'\n      - '.github/scripts/verify-npm-trust*'\n      - '.github/scripts/check-sqlite-optional.mjs'\n      - 'js/client/**'\n      - 'examples/composition/**'\n      - 'rust/**'\n      - 'csharp/**'\n      - 'docs/protocol/**'\n      - 'examples/cluster-csharp/**'\n      - 'examples/journal-maintenance-csharp/**'\n      - 'examples/journal-reclamation-csharp/**'\n      - 'examples/sqlite-csharp/**'\n      - 'examples/native-lsm-js/**'\n      - 'examples/journal-chunks/**'\n      - 'examples/native-pages/**'\n      - 'examples/native-pages-csharp/**'\n      - 'examples/sorted-tables/**'\n      - 'examples/sorted-tables-csharp/**'\n      - 'examples/journal-checkpoints/**'\n      - 'experiments/issue-138/generate-checkpoint-vectors.py'\n      - 'experiments/issue-138/etcd-*.mjs'\n      - 'experiments/issue-138/sqlite-adapter-contracts.mjs'\n      - 'experiments/issue-138/make-native-page-vectors.py'\n      - 'experiments/issue-138/*sorted-table*'\n      - 'experiments/issue-138/*lsm-wal*'\n      - 'experiments/issue-138/*lsm-store*'\n      - 'experiments/issue-138/run-lsm-readonly-inspection.sh'\n      - 'experiments/issue-138/make-mirrored-page-vectors.py'\n      - 'experiments/issue-138/make-checkpoint-page-vectors.py'\n      - 'experiments/issue-138/make-checkpoint-root-vectors.py'\n      - 'experiments/issue-138/make-maintenance-vectors.py'\n      - 'experiments/issue-138/verify-maintenance-lazy.mjs'\n      - 'experiments/issue-138/*reclamation*'\n      - 'experiments/issue-138/native-checkpoint-cut.mjs'\n      - 'experiments/issue-138/*chunk*'\n  workflow_dispatch:\n    inputs:\n      verify_trusted_publishing:\n        description: 'Verify npm OIDC authentication without publishing'\n        type: boolean\n        default: false\n\n# Concurrency is set per job (issue #134): superseded read-only checks are\n# cancelled on every branch, main included (issue #172), while writer jobs\n# share a never-cancelled group. A workflow-level group held the whole run,\n# including the release and the registry wait, so a third push to main\n# cancelled the queued run.\n\n# Least privilege by default; the release job opts into more below.\npermissions:\n  contents: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git, which otherwise prints the\n# default-branch hint into every log.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # === STAGE GATE (issue #111) ===\n  # Jobs that install Rust or .NET wait for the JavaScript stage (lint,\n  # `npm run test:js`, parity check) of the same commit; a failed, cancelled\n  # or skipped stage leaves them skipped.\n  javascript:\n    name: javascript\n    if: inputs.verify_trusted_publishing != true\n    uses: ./.github/workflows/javascript-stage.yml\n\n  release-preflight:\n    name: Release authentication preflight\n    if: inputs.verify_trusted_publishing != true\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-release-preflight\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Prove authentication before version writes or publishing\n        working-directory: .\n        env:\n          NPM_PACKAGE: '@link-foundation/link-cli-client'\n        run: node .github/scripts/release-preflight.mjs npm\n\n  verify-trusted-publishing:\n    name: Verify npm trusted publishing\n    if: github.event_name == 'workflow_dispatch' && inputs.verify_trusted_publishing\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-verify-trusted-publishing\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Verify npm OIDC exchange\n        run: node .github/scripts/verify-npm-trust.mjs\n\n  unit:\n    if: inputs.verify_trusted_publishing != true\n    name: Unit tests and types\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-unit\n      cancel-in-progress: true\n    defaults:\n      run:\n        working-directory: js/client\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          cache: npm\n          cache-dependency-path: js/client/package-lock.json\n\n      - name: Install npm dependencies\n        run: npm ci\n\n      - name: Verify default imports and native logs need no SQLite\n        run: node ../../.github/scripts/check-sqlite-optional.mjs js\n\n      - name: Verify independently generated native page vectors\n        run: |\n          python3 ../../experiments/issue-138/make-native-page-vectors.py ../../experiments/issue-138/native-pages-regenerated.json\n          cmp ../../docs/protocol/native-pages-v1.json ../../experiments/issue-138/native-pages-regenerated.json\n          python3 ../../experiments/issue-138/make-sorted-table-vectors.py ../../experiments/issue-138/sorted-table-regenerated.json\n          cmp ../../docs/protocol/native-sorted-table-v1.json ../../experiments/issue-138/sorted-table-regenerated.json\n          node ../../experiments/issue-138/verify-sorted-table-lazy.mjs\n          python3 ../../experiments/issue-138/make-lsm-wal-vectors.py ../../experiments/issue-138/lsm-wal-regenerated.json\n          cmp ../../docs/protocol/native-lsm-wal-v1.json ../../experiments/issue-138/lsm-wal-regenerated.json\n          node ../../experiments/issue-138/verify-lsm-wal-lazy.mjs\n          node ../../experiments/issue-138/verify-lsm-store-lazy.mjs\n          python3 ../../experiments/issue-138/make-mirrored-page-vectors.py ../../experiments/issue-138/mirrored-pages-regenerated.json\n          cmp ../../docs/protocol/native-pages-mirrored-v1.json ../../experiments/issue-138/mirrored-pages-regenerated.json\n          python3 ../../experiments/issue-138/generate-checkpoint-vectors.py ../../experiments/issue-138/engine-checkpoint-regenerated.json\n          cmp ../../docs/protocol/engine-checkpoint-vectors.json ../../experiments/issue-138/engine-checkpoint-regenerated.json\n          python3 ../../experiments/issue-138/make-checkpoint-page-vectors.py ../../experiments/issue-138/checkpoint-pages-regenerated.json\n          cmp ../../docs/protocol/checkpoint-pages-v1.json ../../experiments/issue-138/checkpoint-pages-regenerated.json\n          python3 ../../experiments/issue-138/make-checkpoint-root-vectors.py ../../experiments/issue-138/checkpoint-root-regenerated.json\n          cmp ../../docs/protocol/checkpoint-root-mirror-v1.json ../../experiments/issue-138/checkpoint-root-regenerated.json\n          python3 ../../experiments/issue-138/make-maintenance-vectors.py ../../experiments/issue-138/maintenance-regenerated.json\n          cmp ../../docs/protocol/journal-maintenance-v1.json ../../experiments/issue-138/maintenance-regenerated.json\n          node ../../experiments/issue-138/verify-maintenance-lazy.mjs\n          python3 ../../experiments/issue-138/make-reclamation-vectors.py ../../experiments/issue-138/reclamation-regenerated.json\n          cmp ../../docs/protocol/reclamation-v1.json ../../experiments/issue-138/reclamation-regenerated.json\n          node ../../experiments/issue-138/verify-reclamation-lazy.mjs\n          node ../../experiments/issue-138/verify-reclamation-memory.mjs\n          python3 ../../experiments/issue-138/model-object-reclamation.py\n          python3 ../../experiments/issue-138/model-reclamation-readers.py\n          python3 ../../experiments/issue-138/model-chunked-journal.py\n          python3 ../../experiments/issue-138/model-chunk-reclamation.py\n          python3 ../../experiments/issue-138/model-chunk-readers.py\n          python3 ../../experiments/issue-138/build-chunk-vectors.py ../../experiments/issue-138/chunks-regenerated.json\n          cmp ../../docs/protocol/chunked-journal-vectors.json ../../experiments/issue-138/chunks-regenerated.json\n          python3 ../../experiments/issue-138/build-reclaiming-chunk-vectors.py ../../experiments/issue-138/reclaiming-chunks-regenerated.json\n          cmp ../../docs/protocol/reclaiming-chunks-vectors.json ../../experiments/issue-138/reclaiming-chunks-regenerated.json\n\n      - name: Verify finite physical LSM composition experiments\n        run: |\n          bash ../../experiments/issue-138/run-lsm-store-prototype.sh node\n          node --max-old-space-size=128 --stack-size=512 --test --test-concurrency=1 --test-timeout=30000 ../../experiments/issue-138/inspect-lsm-wal-pages.test.mjs\n\n      - name: Unit tests and complete production coverage\n        run: >-\n          node --test --test-concurrency=1 --test-timeout=30000\n          --experimental-test-coverage --test-coverage-include='src/**'\n          --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100\n          test/*.test.mjs\n\n      - name: Verify independent local batch models and vectors\n        run: |\n          python3 ../../experiments/issue-138/causal-batch-model.py\n          python3 ../../experiments/issue-138/generate-causal-batch-vectors.py ../../experiments/issue-138/causal-batch-regenerated.json\n          cmp ../../docs/protocol/causal-batch-v1.json ../../experiments/issue-138/causal-batch-regenerated.json\n\n      - name: Verify independent author takeover and guarded publication model\n        run: |\n          python3 ../../experiments/issue-138/author-fence-model.py ../../experiments/issue-138/author-fence-regenerated.json\n          cmp ../../docs/protocol/author-fence-v1.json ../../experiments/issue-138/author-fence-regenerated.json\n\n      - name: Verify independent permanent address allocation model and vectors\nname: JS server CI\n\n# @link-foundation/link-cli-server (js/server, issue #111): the pure\n# JavaScript server and embedded store. Unit tests with complete coverage on\n# Node.js, the same tests on Bun and Deno, differential runs against the Rust\n# `clink` (byte-identical output and database files), the client conformance\n# runner against `clink --serve` of this package, and the npm release.\non:\n  # Only main on push: PR branches are covered by the pull_request trigger\n  # (issue #96).\n  push:\n    branches:\n      - main\n    paths:\n      - '.github/workflows/js-server.yml'\n      - '.github/scripts/**'\n      - 'js/server/**'\n      - 'js/client/**'\n      - 'rust/**'\n      - 'docs/protocol/**'\n      - 'examples/concurrent-writers/**'\n  pull_request:\n    branches:\n      - main\n    paths:\n      - '.github/workflows/js-server.yml'\n      - '.github/scripts/**'\n      - 'js/server/**'\n      - 'js/client/**'\n      - 'rust/**'\n      - 'docs/protocol/**'\n      - 'examples/concurrent-writers/**'\n  workflow_dispatch:\n    inputs:\n      verify_trusted_publishing:\n        description: 'Verify npm OIDC authentication without publishing'\n        type: boolean\n        default: false\n\n# Concurrency is set per job (issue #134): superseded read-only checks are\n# cancelled on every branch, main included (issue #172), while writer jobs\n# share a never-cancelled group.\n\n# Least privilege by default; the release job opts into more below.\npermissions:\n  contents: read\n\n# Provide Git config to actions/checkout itself; checkout runs git init before\n# any workflow step can configure Git, which otherwise prints the\n# default-branch hint into every log.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # === STAGE GATE (issue #111) ===\n  # The job that builds the Rust oracle waits for the JavaScript stage (lint,\n  # `npm run test:js`, parity check) of the same commit; a failed, cancelled\n  # or skipped stage leaves it skipped.\n  javascript:\n    name: javascript\n    if: inputs.verify_trusted_publishing != true\n    uses: ./.github/workflows/javascript-stage.yml\n\n  release-preflight:\n    name: Release authentication preflight\n    if: inputs.verify_trusted_publishing != true\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-release-preflight\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Prove authentication before version writes or publishing\n        working-directory: .\n        env:\n          NPM_PACKAGE: '@link-foundation/link-cli-server'\n        run: node .github/scripts/release-preflight.mjs npm\n\n  verify-trusted-publishing:\n    name: Verify npm trusted publishing\n    if: github.event_name == 'workflow_dispatch' && inputs.verify_trusted_publishing\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-verify-trusted-publishing\n      cancel-in-progress: true\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Verify npm OIDC exchange\n        env:\n          NPM_PACKAGE: '@link-foundation/link-cli-server'\n        run: node .github/scripts/verify-npm-trust.mjs\n\n  unit:\n    if: inputs.verify_trusted_publishing != true\n    name: Unit tests on Node.js, Bun and Deno\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-unit\n      cancel-in-progress: true\n    defaults:\n      run:\n        working-directory: js/server\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          cache: npm\n          cache-dependency-path: js/server/package-lock.json\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version: latest\n\n      - name: Setup Deno\n        uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5\n        with:\n          deno-version: v2.x\n\n      - name: Install npm dependencies\n        run: npm ci\n\n      - name: Unit tests and complete production coverage\n        run: npm run test:coverage\n\n      # Write N+100 of `clink --transactions` must not be much slower than\n      # write N on a constant-size store (issue #195).\n      - name: Benchmark transactional writes\n        run: node ../../.github/scripts/transactions-benchmark.mjs -- node bin/clink.js\n\n      - name: Unit tests on Bun\n        run: bun test --timeout 60000 test/\n\n      # The package is plain JavaScript without type declarations; without\n      # --no-check Deno's TypeScript host stops before any test runs because\n      # it cannot resolve npm:@types/node, which the package does not use.\n      - name: Unit tests on Deno\n        run: deno test --allow-all --no-check test/\n\n      # The embedded-store example (the twin of rust/examples/embedded_store.rs)\n      # on every runtime: each run asserts recovery, the lock and the in-place\n      # writes, and all three must leave the same database file.\n      - name: Embedded store example on Node.js, Bun and Deno\n        run: |\n          example=../../examples/embedded-store/embedded-store.mjs\n          node \"$example\" \"$RUNNER_TEMP/embedded-node\"\n          bun \"$example\" \"$RUNNER_TEMP/embedded-bun\"\n          deno run --allow-all --node-modules-dir=manual \"$example\" \"$RUNNER_TEMP/embedded-deno\"\n          cmp \"$RUNNER_TEMP/embedded-node/db.links\" \"$RUNNER_TEMP/embedded-bun/db.links\"\n          cmp \"$RUNNER_TEMP/embedded-node/db.links\" \"$RUNNER_TEMP/embedded-deno/db.links\"\n\n  # The package supports Node.js 20 and later on every desktop and server\n  # operating system (`engines` in package.json), so the unit tests also run\n  # on the oldest supported Node.js and on macOS and Windows. Tests of\n  # primitives a platform lacks (FIFOs, Unix sockets on old Windows, ...)\n  # skip with the reason the port reports there.\n  portability:\n    if: inputs.verify_trusted_publishing != true\n    name: Unit tests on ${{ matrix.os }} with Node.js ${{ matrix.node }}\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-portability-${{ matrix.os }}-${{ matrix.node }}\n      cancel-in-progress: true\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-15, windows-2025]\n        node: ['20.x', '22.x', '26.x']\n        exclude:\n          # Node.js 26 on Ubuntu is the coverage run of the unit job.\n          - os: ubuntu-24.04\n            node: '26.x'\n    defaults:\n      run:\n        shell: bash\n        working-directory: js/server\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n          cache-dependency-path: js/server/package-lock.json\n\n      - name: Install npm dependencies\n        run: npm ci\n\n      - name: Unit tests\n        run: npm test\n\n  differential:\n    needs: [javascript, unit]\n    if: inputs.verify_trusted_publishing != true\n    name: Differential runs against the Rust clink and client conformance\n    runs-on: ubuntu-24.04\n    timeout-minutes: 40\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-differential\n      cancel-in-progress: true\n    env:\n      CLINK_RUST: ${{ github.workspace }}/rust/target/release/clink\n      # The Rust `DoubletsStorage` driver test/differential/doublets-storage\n      # replays the unit-store scenarios through (rust/examples/unit_store_trace.rs).\n      CLINK_RUST_UNIT_STORE: ${{ github.workspace }}/rust/target/release/examples/unit_store_trace\n      CLINK_JS: ${{ github.workspace }}/js/server/bin/clink.js\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n          cache: npm\n          cache-dependency-path: js/server/package-lock.json\n\n      - name: Install npm dependencies\n        working-directory: js/server\n        run: npm ci\n\n      - name: Restore cargo cache\n        id: cargo-cache\n        uses: actions/cache/restore@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ runner.os }}-js-server-cargo-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-js-server-cargo-\n\n      - name: Build the Rust clink and the unit-store driver\n        run: >-\n          cargo build --release --manifest-path rust/Cargo.toml\n          --bin clink --example unit_store_trace\n\n      # The same invocations through both executables: stdout, stderr, exit\n      # status and every file they write must be identical.\n      - name: Differential runs against the Rust clink\n","exit_code":0,"status":"completed"}}
