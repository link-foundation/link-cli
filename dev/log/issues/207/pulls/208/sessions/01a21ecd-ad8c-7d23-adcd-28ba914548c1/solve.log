[2026-11-27T23:20:34.089Z] [STDOUT] {"type":"item.completed","item":{"id":"item_1154","type":"command_execution","command":"/bin/bash -lc \"cat csharp/Foundation.Data.Doublets.Cli.Tests/FiniteExitChild.cs && sed -n '1,140p' csharp/Foundation.Data.Doublets.Cli.Tests/VersionProcessExitTests.cs && rg -n 'xunit|dotnet test' .github/workflows/csharp.yml csharp/Foundation.Data.Doublets.Cli.Tests\"","aggregated_output":"using System.Diagnostics;\nusing System.Text;\n\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\n// Supervision only: phases and elapsed times do not prove persistence.\ninternal static class FiniteExitChild\n{\n    private static readonly object phaseGate = new();\n    private static readonly Stopwatch phaseElapsed = Stopwatch.StartNew();\n    private static int phaseNumber;\n    internal static void Phase(string phase)\n    {\n        lock (phaseGate) Console.Error.WriteLine($\"@link-progress:{++phaseNumber} phase={phase} elapsed={phaseElapsed.ElapsedMilliseconds}ms\");\n    }\n\n    private static string Capture(StreamReader reader, FinitePhaseWatch? progress = null)\n    {\n        const int limit = 65536;\n        var text = new StringBuilder();\n        var buffer = new char[1024];\n        int read;\n        bool truncated = false;\n        // This dedicated reader must not queue behind test-runner workers.\n        while ((read = reader.Read(buffer, 0, buffer.Length)) != 0)\n        {\n            progress?.Observe(buffer.AsSpan(0, read));\n            int keep = Math.Min(read, limit - text.Length);\n            text.Append(buffer, 0, keep);\n            truncated |= keep != read;\n        }\n        progress?.Complete();\n        if (truncated) text.Append(\"\\n[finite diagnostic capture truncated]\");\n        return text.ToString();\n    }\n\n    internal static async Task Run(ProcessStartInfo info, int expectedExit, string description)\n    {\n        info.Environment[\"DOTNET_GCHeapHardLimit\"] = \"0x10000000\";\n        using var child = Process.Start(info)!;\n        await Wait(child, expectedExit, description).ConfigureAwait(false);\n    }\n\n    internal static Task Wait(Process child, int expectedExit, string description, TimeSpan? limit = null)\n        => Dedicated(() => WaitCore(child, expectedExit, description, limit));\n\n    private static Task<T> Dedicated<T>(Func<T> action)\n        => Task.Factory.StartNew(action, CancellationToken.None, TaskCreationOptions.LongRunning, TaskScheduler.Default);\n\n    private static bool WaitCore(Process child, int expectedExit, string description, TimeSpan? limit)\n    {\n        using var progress = new FinitePhaseWatch(limit ?? TimeSpan.FromSeconds(15));\n        var stdout = Dedicated(() => Capture(child.StandardOutput));\n        var stderr = Dedicated(() => Capture(child.StandardError, progress));\n        var elapsed = Stopwatch.StartNew();\n        Exception? failure = null;\n        try\n        {\n            // Both pipe readers and process observation run independently of\n            // the shared pool. A monotonic poll enforces the same idle bound\n            // even when timer and process-exit callbacks cannot be admitted.\n            while (!child.WaitForExit(progress.WaitMilliseconds)) progress.Token.ThrowIfCancellationRequested();\n        }\n        catch (Exception error) { failure = error; }\n        // Reap before either returning or allowing fixture cleanup, including\n        // exceptions other than deadline cancellation. Never abandon a child.\n        try\n        {\n            if (!child.HasExited) child.Kill(entireProcessTree: true);\n            child.WaitForExit();\n        }\n        catch (Exception cleanup)\n        {\n            throw failure is null ? cleanup : new AggregateException(failure, cleanup);\n        }\n        string output = stdout.GetAwaiter().GetResult(), errors = stderr.GetAwaiter().GetResult();\n        string detail = $\"{description}; pid={child.Id}; elapsed={elapsed.Elapsed}; phase={progress.LastPhase}; exited {child.ExitCode}\\nstdout:\\n{output}\\nstderr:\\n{errors}\";\n        if (progress.Failure is not null) throw new InvalidOperationException($\"{progress.Failure}; {detail}\", failure);\n        if (failure is OperationCanceledException) throw new TimeoutException(detail, failure);\n        if (failure is not null) throw new InvalidOperationException(detail, failure);\n        Assert.True(child.ExitCode == expectedExit, detail);\n        return true;\n    }\n\n    internal static async Task WithDirectory(string prefix, Func<string, Task> action, Action<string>? cleanup = null)\n    {\n        string directory = Directory.CreateTempSubdirectory(prefix).FullName;\n        Exception? failure = null;\n        try { await action(directory); }\n        catch (Exception error) { failure = error; throw; }\n        finally\n        {\n            try\n            {\n                if (cleanup is null) Directory.Delete(directory, recursive: true);\n                else cleanup(directory);\n            }\n            catch (Exception error) when (failure is not null) { throw new AggregateException(failure, error); }\n        }\n    }\n}\nusing System.Diagnostics;\nusing System.Globalization;\nusing Platform.Data;\nusing Platform.Data.Doublets;\n\nnamespace Foundation.Data.Doublets.Cli.Tests;\n\npublic class VersionProcessExitTests\n{\n    internal static async Task<(uint Id, long Original, long Attempted)> ExitChild(string directory, string mode, bool automatic, string probe = \"version-exit\")\n    {\n        var info = new ProcessStartInfo(\"dotnet\") { RedirectStandardOutput = true, RedirectStandardError = true };\n        info.ArgumentList.Add(typeof(VersionProcessExitTests).Assembly.Location);\n        foreach (var argument in new[] { probe, directory, mode, automatic.ToString() }) info.ArgumentList.Add(argument);\n        await FiniteExitChild.Run(info, 0, $\"{probe}/{mode}/{automatic}\");\n        var fields = File.ReadAllText(Path.Combine(directory, \"manifest\")).Split(',');\n        return (uint.Parse(fields[0], CultureInfo.InvariantCulture),\n            long.Parse(fields[1], CultureInfo.InvariantCulture), long.Parse(fields[2], CultureInfo.InvariantCulture));\n    }\n\n    [Theory(Timeout = 30000)]\n    [InlineData(\"success\", false, false)]\n    [InlineData(\"success\", true, false)]\n    [InlineData(\"checkpoint\", false, false)]\n    [InlineData(\"checkpoint\", true, false)]\n    [InlineData(\"pending\", false, false)]\n    [InlineData(\"rollback\", false, false)]\n    [InlineData(\"success\", false, true)]\n    [InlineData(\"success\", true, true)]\n    [InlineData(\"checkpoint\", false, true)]\n    [InlineData(\"checkpoint\", true, true)]\n    [InlineData(\"pending\", false, true)]\n    [InlineData(\"rollback\", false, true)]\n    public async Task AbruptExitRecoversExactBranchAttribution(string mode, bool automatic, bool names)\n    {\n        await FiniteExitChild.WithDirectory(\"version-process-exit-\", async directory =>\n        {\n            var (id, original, attempted) = await ExitChild(directory, mode, automatic, names ? \"name-exit\" : \"version-exit\");\n            var committed = mode is \"success\" or \"checkpoint\";\n            var expected = committed ? attempted : original;\n            long following = 0;\n            for (var reopen = 0; reopen < 2; ++reopen)\n            {\n                using var data = new NamedTypesDecorator<uint>(Path.Combine(directory, \"data.links\"));\n                using var log = new NamedTypesDecorator<uint>(Path.Combine(directory, \"log.links\"));\n                using var branches = new NamedTypesDecorator<uint>(Path.Combine(directory, \"branches.links\"));\n                using var tx = new TransactionsDecorator(data, log);\n                using var vc = new VersionControlDecorator(tx, branches);\n                Assert.Equal(VersionExitProbe.Topic, vc.CurrentBranch);\n                Assert.Equal(reopen == 0 ? expected : following, vc.CurrentSequence);\n                Assert.Equal(reopen == 0 ? expected : following, vc.ListBranches().Single(b => b.Name == VersionExitProbe.Topic).Head);\n                Assert.Equal(reopen == 1 ? 31u : committed && !names ? 21u : 11u, vc.GetSource(id));\n                Assert.Equal(committed && names ? \"changed 雪|\\0\\n\" : \"original\", vc.GetName(id));\n                if (reopen == 0)\n                {\n                    vc.Checkout(original);\n                    Assert.Equal(11u, vc.GetSource(id));\n                    Assert.Equal(\"original\", vc.GetName(id));\n                    if (committed)\n                    {\n                        vc.Checkout(attempted);\n                        Assert.Equal(names ? 11u : 21u, vc.GetSource(id));\n                        Assert.Equal(names ? \"changed 雪|\\0\\n\" : \"original\", vc.GetName(id));\n                    }\n                    else Assert.Throws<InvalidOperationException>(() => vc.Checkout(attempted));\n                    vc.Update(new[] { id }, new[] { id, 31u, 32u }, null);\n                    following = vc.CurrentSequence;\n                }\n                data.Flush(); log.Flush(); branches.Flush();\n            }\n        });\n    }\n}\n.github/workflows/csharp.yml:336:        run: dotnet test --no-build --configuration Release --verbosity normal --collect:\"XPlat Code Coverage;Format=json,cobertura\"\n.github/workflows/csharp.yml:445:            dotnet test csharp --no-build --configuration Release --verbosity normal\ncsharp/Foundation.Data.Doublets.Cli.Tests/Foundation.Data.Doublets.Cli.Tests.csproj:46:    <PackageReference Include=\"xunit\" Version=\"2.9.3\" />\ncsharp/Foundation.Data.Doublets.Cli.Tests/Foundation.Data.Doublets.Cli.Tests.csproj:47:    <PackageReference Include=\"xunit.runner.visualstudio\" Version=\"4.0.1\" />\n","exit_code":0,"status":"completed"}}
