[2026-11-27T21:15:49.472Z] [STDOUT] {"type":"item.completed","item":{"id":"item_219","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,127p' .github/workflows/workflows.yml; sed -n '143,240p' experiments/issue-138/etcd-cluster.mjs; sed -n '1,110p' experiments/issue-138/etcd-harness.mjs; git diff --stat\"","aggregated_output":"      - name: Audit workflow files\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          \"$RUNNER_TEMP/zizmor/bin/zizmor\" --format github --config .github/zizmor.yml .github\n\n      # The audits that cover container image references (`unpinned-images`\n      # among them) are pedantic-only, so the hash-pin policy is not enforced\n      # against `uses: docker://` by the regular pass above. Narrowing this\n      # pass to high severity and high confidence keeps that enforcement\n      # without the stylistic noise of the pedantic persona.\n      - name: Audit for pedantic-only high-severity findings\n        timeout-minutes: 5\n        run: |\n          \"$RUNNER_TEMP/zizmor/bin/zizmor\" --config .github/zizmor.yml \\\n            --persona pedantic --min-severity high --min-confidence high \\\n            .github\n\n  policy:\n    name: Workflow Policy Tests\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-policy\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n  await fresh.commit();\n  await stale.shard('a').delete(1);\n  await assert.rejects(stale.commit(), { outcome: 'failed' });\n  console.log('PASS real etcd: atomic multi-shard CAS and read-only dependency conflict');\n\n  let loseReply = true;\n  const lossy = new EtcdJournalStore(endpoints, {\n    ...options,\n    fetch: async (url, request) => {\n      const result = await fetch(url, request);\n      if (loseReply && JSON.parse(request.body).compare) {\n        loseReply = false;\n        await result.body.cancel();\n        throw Error('injected lost commit response');\n      }\n      return result;\n    },\n  });\n  const uncertain = await new ClusterEngine(binding, lossy, checkpointOptions).begin(['a', 'b']);\n  await uncertain.shard('a').setName(1, 'unknown committed');\n  await uncertain.shard('b').setName(1, 'unknown committed');\n  await assert.rejects(uncertain.commit(), { outcome: 'unknown' });\n  const recovered = await engine.begin(['a', 'b']);\n  assert.equal(await recovered.shard('a').getName(1), 'unknown committed');\n  assert.equal(await recovered.shard('b').getName(1), 'unknown committed');\n  await recovered.close();\n  console.log('PASS real etcd: dropped response discovers both committed shards without replay');\n\n  if (process.env.CLUSTER_RUST_EXAMPLE) {\n    const child = spawn(\n      process.env.CLUSTER_RUST_EXAMPLE,\n      [endpoints.join(','), '/issue138/', ...checkpointFlags],\n      { stdio: 'inherit' },\n    );\n    assert.equal((await once(child, 'exit'))[0], 0);\n  }\n  if (process.env.CLUSTER_CSHARP_EXAMPLE) {\n    const child = spawn(\n      'dotnet',\n      [process.env.CLUSTER_CSHARP_EXAMPLE, endpoints.join(','), '/issue138/', ...checkpointFlags],\n      { env: { ...process.env, DOTNET_GCHeapHardLimit: '0x18000000' }, stdio: 'inherit' },\n    );\n    assert.equal((await once(child, 'exit'))[0], 0);\n  }\n  const native = await engine.begin(['a', 'b']);\n  for (const key of ['a', 'b'])\n    assert.equal(\n      await native.shard(key).getName(1),\n      process.env.CLUSTER_CSHARP_EXAMPLE\n        ? 'C# coordinated 雪'\n        : process.env.CLUSTER_RUST_EXAMPLE\n          ? 'Rust coordinated 雪'\n          : 'unknown committed',\n    );\n  await native.close();\n  await javascriptExample([endpoints.join(','), '/issue138/'], engine);\n\n  // Two additional single-member consensus groups demonstrate physically\n  // independent bulk storage. The three-member catalog carries pointers only.\n  const dataEndpoints = ports.slice(6, 8).map((port) => `http://127.0.0.1:${port}`);\n  for (let i = 0; i < 2; i++) {\n    const name = `data${i}`;\n    const peer = `http://127.0.0.1:${ports[8 + i]}`;\n    const log = createWriteStream(join(directory, `${name}.log`));\n    const child = spawn(\n      binary,\n      [\n        '--name',\n        name,\n        '--data-dir',\n        join(directory, name),\n        '--listen-client-urls',\n        dataEndpoints[i],\n        '--advertise-client-urls',\n        dataEndpoints[i],\n        '--listen-peer-urls',\n        peer,\n        '--initial-advertise-peer-urls',\n        peer,\n        '--initial-cluster',\n        `${name}=${peer}`,\n        '--initial-cluster-token',\n        `issue-138-${ports[0]}-${name}`,\n        '--quota-backend-bytes',\n        '16777216',\n        '--log-level',\n        verbose ? 'debug' : 'warn',\n      ],\n      { env: { ...process.env, GOMEMLIMIT: '100MiB' }, stdio: ['ignore', 'pipe', 'pipe'] },\n    );\n    child.stdout.pipe(log);\n    child.stderr.pipe(log);\n    nodes.push({ child, exited: once(child, 'exit'), log });\n  }\n  await waitForMembers(dataEndpoints);\n  const prefix = '/partitioned/';\n  let catalogRequests = 0;\n  let dataRequests = 0;\nexport async function memberStatus(endpoint, fetch = globalThis.fetch) {\n  const response = await fetch(`${endpoint}/v3/maintenance/status`, {\n    method: 'POST',\n    body: '{}',\n    signal: AbortSignal.timeout(2000),\n  });\n  if (!response.ok) throw Error(`member status HTTP ${response.status}`);\n  const status = await response.json();\n  if (!status.header?.member_id || !status.leader || status.leader === '0') {\n    throw Error('member has no leader');\n  }\n  return status;\n}\n\n// Require agreement and a leader in the sampled group. A majority that still\n// reports the paused member has not elected its replacement yet.\nexport function electedMember(statuses) {\n  const leader = statuses[0]?.leader;\n  if (!leader || statuses.some((status) => status.leader !== leader)) {\n    throw Error(\n      `members disagree on leader: ${statuses.map((status) => status.leader).join(', ')}`,\n    );\n  }\n  const index = statuses.findIndex((status) => status.header.member_id === leader);\n  if (index < 0) throw Error(`reported leader ${leader} is outside the sampled group`);\n  return index;\n}\n\n// Each intended member must be ready before injecting failures. A majority's\n// readiness alone says nothing about a slower member's listening socket.\nexport async function waitForMembers(\n  endpoints,\n  {\n    fetch = globalThis.fetch,\n    attempts = 30,\n    pause = (ms) => new Promise((done) => setTimeout(done, ms)),\n  } = {},\n) {\n  return Promise.all(\n    endpoints.map(async (endpoint) => {\n      let failure;\n      for (let attempt = 0; attempt < attempts; attempt++) {\n        try {\n          return await memberStatus(endpoint, fetch);\n        } catch (error) {\n          failure = error;\n          await pause(100);\n        }\n      }\n      throw failure;\n    }),\n  );\n}\n","exit_code":0,"status":"completed"}}
