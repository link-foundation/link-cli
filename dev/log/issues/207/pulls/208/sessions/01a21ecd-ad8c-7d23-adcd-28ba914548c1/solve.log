orkflows/rust.yml:108:      group: check-${{ github.workflow }}-${{ github.ref }}-verify-trusted-publishing\n.github/workflows/rust.yml:109:      cancel-in-progress: true\n.github/workflows/rust.yml:128:      group: check-${{ github.workflow }}-${{ github.ref }}-detect-changes\n.github/workflows/rust.yml:129:      cancel-in-progress: true\n.github/workflows/rust.yml:186:      group: check-${{ github.workflow }}-${{ github.ref }}-changelog\n.github/workflows/rust.yml:187:      cancel-in-progress: true\n.github/workflows/rust.yml:217:      group: check-${{ github.workflow }}-${{ github.ref }}-lint\n.github/workflows/rust.yml:218:      cancel-in-progress: true\n.github/workflows/rust.yml:319:      group: check-${{ github.workflow }}-${{ github.ref }}-test-${{ matrix.os }}\n.github/workflows/rust.yml:320:      cancel-in-progress: true\n.github/workflows/rust.yml:417:      group: check-${{ github.workflow }}-${{ github.ref }}-coverage\n.github/workflows/rust.yml:418:      cancel-in-progress: true\n.github/workflows/rust.yml:470:      group: check-${{ github.workflow }}-${{ github.ref }}-fresh-merge\n.github/workflows/rust.yml:471:      cancel-in-progress: true\n.github/workflows/rust.yml:525:      group: check-${{ github.workflow }}-${{ github.ref }}-build\n.github/workflows/rust.yml:526:      cancel-in-progress: true\n.github/workflows/rust.yml:585:      group: main-writer-${{ github.repository }}\n.github/workflows/rust.yml:586:      cancel-in-progress: false\n.github/workflows/rust.yml:706:      group: main-writer-${{ github.repository }}\n.github/workflows/rust.yml:707:      cancel-in-progress: false\n.github/workflows/rust.yml:802:      group: main-writer-${{ github.repository }}\n.github/workflows/rust.yml:803:      cancel-in-progress: false\n.github/workflows/rust.yml:875:      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n.github/workflows/rust.yml:876:      cancel-in-progress: true\n// Repository governance rules of issue #111 that are not the stage gate\n// itself (the gate rule lives in workflow-policy.test.mjs): the required\n// status checks always report, every suite proves it loaded the golden\n// fixtures, no workflow closes or flags pull requests because of age, and a\n// red Dependencies check on main is tracked in an issue.\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { readJobs, workflows } from './workflow-files.mjs';\n\ntest('the required stage checks report on every pull request (issue #111)', () => {\n  for (const name of ['javascript.yml', 'rust.yml', 'csharp.yml']) {\n    const { text } = workflows.find((workflow) => workflow.name === name);\n    const on = text.slice(text.indexOf('\\non:\\n'), text.indexOf('\\njobs:\\n'));\n    assert.match(on, /^ {2}pull_request:/m, `${name} must run on pull requests`);\n    assert.doesNotMatch(\n      on,\n      /^ {4}paths(?:-ignore)?:/m,\n      `${name}: a path filter would skip the parity check and leave its required check pending`,\n    );\n    assert.match(text, /^ {2}pipeline-status:\\n {4}name: Pipeline Status \\(\\w+\\)/m);\n  }\n});\n\ntest('every suite proves it loaded the shared golden fixtures (issue #111)', () => {\n  for (const [name, suite, job] of [\n    ['rust.yml', 'rust', 'test'],\n    ['csharp.yml', 'csharp', 'test'],\n    ['javascript-stage.yml', 'javascript', 'stage'],\n  ]) {\n    const { text } = workflows.find((workflow) => workflow.name === name);\n    const tests = readJobs(text).find((candidate) => candidate.name === job).body;\n    assert.match(\n      tests,\n      new RegExp(`GOLDEN_FIXTURES_RECEIPT: \\\\$\\\\{\\\\{ runner\\\\.temp \\\\}\\\\}/golden-${suite}\\\\.json`),\n    );\n    assert.match(\n      tests,\n      new RegExp(`node parity/check-parity\\\\.mjs --receipt ${suite} \"\\\\$RECEIPT\"`),\n    );\n  }\n});\n\n// link-foundation repositories have no stale pull request policy: work on a\n// pull request can always continue, so nothing closes, labels or rebases one\n// because time has passed (the owner's review of PR #180 for issue #111).\ntest('no workflow flags or closes pull requests for inactivity (issue #111)', () => {\n  for (const { name, text } of workflows) {\n    assert.doesNotMatch(text, /uses: actions\\/stale@/, `${name}: actions/stale is not allowed`);\n    assert.doesNotMatch(\n      text,\n      /days-before-(?:pr-)?(?:stale|close)|stale-pr-label|close-pr-message/,\n      `${name}: a stale pull request setting is not allowed`,\n    );\n    assert.doesNotMatch(\n      text,\n      /gh pr close|pulls\\/[^\\n]*state[^\\n]*closed|pulls\\.update\\([^)]*state: ['\"]closed/,\n      `${name}: a workflow must not close pull requests`,\n    );\n  }\n  assert.ok(\n    !workflows.some(({ name }) => /^stale\\.ya?ml$/.test(name)),\n    'a stale workflow is not allowed',\n  );\n});\n\ntest('a red Dependencies check on main opens or updates a tracking issue (issue #111)', () => {\n  const { text } = workflows.find(({ name }) => name === 'dependencies.yml');\n  const jobs = readJobs(text);\n  const job = jobs.find(({ name }) => name === 'tracking-issue');\n  assert.ok(job, 'dependencies.yml has no tracking-issue job');\n  assert.match(job.body, /^ {6}- latest$/m);\n  assert.match(job.body, /\\$\\{\\{ !cancelled\\(\\) && github\\.ref == 'refs\\/heads\\/main'/);\n  assert.match(\n    job.body,\n    /\\(github\\.event_name == 'schedule' \\|\\| github\\.event_name == 'workflow_dispatch' \\|\\|\\s+needs\\.latest\\.result == 'failure' \\|\\| needs\\.javascript\\.result == 'failure'\\)/,\n  );\n  assert.match(\n    jobs.find(({ name }) => name === 'latest').body,\n    /CHECK_DEPENDENCIES_MODE: \\$\\{\\{ github\\.event_name == 'push' && 'report' \\|\\| 'enforce' \\}\\}/,\n  );\n  assert.doesNotMatch(text, /^concurrency:/m);\n  assert.match(job.body, /^ {6}issues: write$/m);\n  assert.match(job.body, /^ {6}group: dependencies-tracking-\\$\\{\\{ github\\.ref \\}\\}$/m);\n  assert.match(job.body, /^ {6}cancel-in-progress: false$/m);\n  assert.match(job.body, /run: node \\.github\\/scripts\\/dependency-tracking-issue\\.mjs/);\n  assert.match(text, /^ {2}schedule:/m);\n});\n\n// .github/zizmor.yml disables the self-repository audit because actionlint\n// cannot parse `uses: $/...` yet (rhysd/actionlint#711). That is safe only\n// while every local reference is a job-level reusable workflow call, which\n// GitHub resolves from the caller's commit rather than the workspace.\ntest('no step loads a local action from the workspace', () => {\n  for (const { name, text } of workflows) {\n    assert.doesNotMatch(text, /^\\s+- uses: \\.\\//m, `${name}: a step-level uses: ./ action`);\n    assert.doesNotMatch(text, /^ {6,}uses: \\.\\//m, `${name}: a step-level uses: ./ action`);\n  }\n});\n\n// The rules on main require the three stage checks, and the release jobs'\n// version commits are new commits without checks. Only the release deploy key\n// bypasses those rules; GITHUB_TOKEN cannot be a bypass actor (issue #111).\ntest('jobs that push a version commit to main use the release deploy key (issue #111)', () => {\n  const pushers = workflows.flatMap(({ name, text }) =>\n    readJobs(text)\n      .filter(({ body }) => /version-and-commit\\.(?:mjs|rs)/.test(body))\n      .map((job) => ({ workflow: name, ...job })),\n  );\n  assert.deepEqual(pushers.map(({ workflow, name }) => `${workflow}: ${name}`).sort(), [\n    'csharp.yml: instant-release',\n    'csharp.yml: release',\n    'rust.yml: auto-release',\n    'rust.yml: manual-release',\n  ]);\n  for (const { workflow, name, body } of pushers) {\n    const where = `${workflow}: ${name}`;\n    assert.match(\n      body,\n      /^ {4}environment: release$/m,\n      `${where} must run in the release environment`,\n    );\n    const checkout = /- uses: actions\\/checkout@\\S+\\n(?: {8}.*\\n)+/.exec(body)?.[0] ?? '';\n    assert.match(checkout, /^ {10}ssh-key: \\$\\{\\{ secrets\\.RELEASE_DEPLOY_KEY \\}\\}$/m, where);\n    assert.doesNotMatch(checkout, /^ {10}token:/m,…`);\n  }\n});\n});\n\n// Tests that never run in CI are the purest false negative: js/test held a\n// failing repository-layout test for months because no workflow invoked it.\ntest('the JavaScript unit tests are executed by a workflow', () => {\n  const jsTests = readdirSync(join(repoRoot, 'js', 'test')).filter((name) =>\n    name.endsWith('.test.mjs'),\n  );\n  assert.ok(jsTests.length > 0, 'expected JavaScript tests under js/test');\n  assert.ok(\n    workflows.some((workflow) => /npm run test:js/.test(workflow.text)),\n    'no workflow runs \"npm run test:js\", so js/test/*.test.mjs never executes in CI',\n  );\n});\n\nfor (const workflow of workflows) {\n  // A job without a timeout can hang for the runner's six-hour default and\n  // burn the whole CI budget before anyone notices.\n  // A job that calls a reusable workflow (`uses:`) cannot set\n  // timeout-minutes; the called workflow's own jobs carry it.\n  test(`${workflow.name}: every job declares timeout-minutes`, () => {\n    for (const job of readJobs(workflow.text).filter(({ body }) => !isCallerJob(body))) {\n      assert.match(\n        job.body,\n        /^ {4}timeout-minutes: \\d+$/m,\n        `job \"${job.name}\" in ${workflow.name} has no timeout-minutes`,\n      );\n    }\n  });\n\n  // Least privilege: the default token must be read-only unless a job opts in.\n  test(`${workflow.name}: declares a top-level permissions block`, () => {\n    assert.match(\n      workflow.text,\n      /^permissions:$/m,\n      `${workflow.name} does not declare top-level permissions`,\n    );\n  });\n\n  // Every job must be covered by a concurrency group, either its own (writers)\n  // or the workflow-level one (readers), so superseded runs do not pile up.\n  test(`${workflow.name}: every job is covered by a concurrency group`, () => {\n    const hasWorkflowLevel = /^concurrency:$/m.test(workflow.text);\n    for (const job of readJobs(workflow.text).filter(({ body }) => !isCallerJob(body))) {\n      assert.ok(\n        hasWorkflowLevel || /^ {4}concurrency:$/m.test(job.body),\n        `job \"${job.name}\" in ${workflow.name} has no concurrency group`,\n      );\n    }\n  });\n\n  // A workflow-level group holds the whole run, release and registry wait\n  // included, so on main a third push cancelled the queued second run, and a\n  // cancellable one would interrupt a writer that already pushed (issue #134).\n  // Writers own a never-cancelled group instead.\n  test(`${workflow.name}: writer jobs own a never-cancelled concurrency group`, () => {\n    const writers = readJobs(workflow.text).filter((job) => isWriterJob(job.body));\n    if (writers.length === 0) return;\n    assert.doesNotMatch(\n      workflow.text,\n      /^concurrency:$/m,\n      `${workflow.name} has writer jobs (${writers.map((job) => job.name).join(', ')}) but a workflow-level concurrency group`,\n    );\n    for (const job of writers) {\n      assert.match(\n        job.body,\n        /^ {4}concurrency:\\n {6}group: [^\\n]+\\n {6}cancel-in-progress: false$/m,\n        `writer job \"${job.name}\" in ${workflow.name} needs its own concurrency group with cancel-in-progress: false`,\n      );\n    }\n  });\n\n  // An authentication attempt may fail so the preflight can classify it or\n  // verify a fallback. The following preflight must enforce the final verdict.\n  test(`${workflow.name}: only classified authentication attempts may continue after failure`, () => {\n    for (const job of readJobs(workflow.text)) {\n      for (const step of readSteps(job.body).filter(({ text }) =>\n        /continue-on-error:/.test(text),\n      )) {\n        assert.equal(workflow.name, 'csharp.yml');\n        assert.equal(job.name, 'release-preflight');\n        assert.match(step.text, /id: preflight_nuget/);\n        assert.match(step.text, /uses: NuGet\\/login@/);\n        assert.match(job.body, /NUGET_OIDC_OUTCOME: \\$\\{\\{ steps\\.preflight_nuget\\.outcome \\}\\}/);\n        assert.match(job.body, /run: node \\.github\\/scripts\\/release-preflight\\.mjs nuget/);\n      }\n    }\n  });\n\n  // Trusted publishing that is not configured on crates.io fails with\n","exit_code":0,"status":"completed"}}
