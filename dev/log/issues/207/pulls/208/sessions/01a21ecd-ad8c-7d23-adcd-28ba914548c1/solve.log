 export async function verifyNpmTrust(\n       signal: AbortSignal.timeout(30_000),\n     },\n   );\n-  if (!exchange.ok || !(await exchange.json()).token) {\n+  if (!exchange.ok) {\n+    const context = `npm trusted publisher verification failed for ${packageName} (HTTP ${exchange.status})`;\n+    if (exchange.status === 404) {\n+      const packument = await fetch(\n+        `https://registry.npmjs.org/${encodeURIComponent(packageName)}`,\n+        { signal: AbortSignal.timeout(15_000) },\n+      ).catch(() => null);\n+      if (packument?.status === 404) {\n+        throw new Error(\n+          `${context}. A maintainer must publish the first public version, then configure ${NPM_WORKFLOWS[packageName] ?? 'the release workflow'} as its trusted publisher and rerun authentication-only verification on main.`,\n+        );\n+      }\n+      if (!packument?.ok) {\n+        throw new Error(\n+          `${context}. Public package lookup was inconclusive (${packument?.status ?? 'network error'}). Check registry availability and retry the authentication-only verification.`,\n+        );\n+      }\n+    }\n+    if ([401, 403, 404].includes(exchange.status)) {\n+      throw new Error(\n+        `${context}. Check the npm trusted publisher settings for this repository and ${NPM_WORKFLOWS[packageName] ?? 'its release workflow'}, including any required environment and permission to publish directly.`,\n+      );\n+    }\n     throw new Error(\n-      `npm trusted publisher verification failed (HTTP ${exchange.status}). Configure this repository and ${NPM_WORKFLOWS[packageName] ?? 'its release workflow'} in the trusted publisher settings of ${packageName} on npmjs.com (a package that is not on npm yet must be published once by a maintainer first).`,\n+      `${context}. Check registry availability and retry the authentication-only verification.`,\n     );\n   }\n+  if (!(await exchange.json()).token)\n+    throw new Error(`npm trusted publisher response for ${packageName} is missing a token`);\n   // Discard the short-lived credential. Never write it to logs, disk or outputs.\n }\n \ndiff --git a/.github/scripts/verify-npm-trust.test.mjs b/.github/scripts/verify-npm-trust.test.mjs\nindex f79c68a2..89243215 100644\n--- a/.github/scripts/verify-npm-trust.test.mjs\n+++ b/.github/scripts/verify-npm-trust.test.mjs\n@@ -71,3 +71,35 @@ test('npm trust failures name the workflow each package is published from', asyn\n   }\n   assert.deepEqual(Object.values(NPM_WORKFLOWS), ['js-client.yml', 'js-server.yml']);\n });\n+\n+test('npm OIDC exchange distinguishes a first publish, a missing trust mapping and an outage', async () => {\n+  const env = {\n+    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n+    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n+  };\n+  const name = '@link-foundation/link-cli-server';\n+  for (const [exchange, metadata, expected] of [\n+    [404, 404, /first public version.+js-server\\.yml/],\n+    [404, 200, /settings.+js-server\\.yml.+publish directly/],\n+    [404, 503, /lookup was inconclusive \\(503\\)/],\n+    [429, undefined, /HTTP 429.+registry availability/],\n+  ]) {\n+    const requests = [];\n+    await assert.rejects(\n+      verifyNpmTrust(name, {\n+        env,\n+        fetch: async (url, options) => {\n+          requests.push({ url: String(url), options });\n+          if (requests.length === 1) return Response.json({ value: 'oidc' });\n+          return new Response('', { status: requests.length === 2 ? exchange : metadata });\n+        },\n+      }),\n+      expected,\n+    );\n+    assert.equal(requests.length, metadata === undefined ? 2 : 3);\n+    if (metadata !== undefined) {\n+      assert.equal(requests[2].url, `https://registry.npmjs.org/${encodeURIComponent(name)}`);\n+      assert.equal(requests[2].options.headers, undefined);\n+    }\n+  }\n+});\ndiff --git a/.github/scripts/workflow-policy.test.mjs b/.github/scripts/workflow-policy.test.mjs\nindex ba2026de..f4fa7335 100644\n--- a/.github/scripts/workf