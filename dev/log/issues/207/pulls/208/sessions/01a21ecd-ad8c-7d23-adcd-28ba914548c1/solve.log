[2026-11-27T21:10:25.597Z] [STDOUT] {"type":"item.completed","item":{"id":"item_155","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' .github/scripts/ci-governance.test.mjs; sed -n '1,180p' .github/scripts/verify-npm-trust.mjs; sed -n '1,160p' /tmp/link-cli-207-template-concurrency.txt\"","aggregated_output":"// Repository governance rules of issue #111 that are not the stage gate\n// itself (the gate rule lives in workflow-policy.test.mjs): the required\n// status checks always report, every suite proves it loaded the golden\n// fixtures, no workflow closes or flags pull requests because of age, and a\n// red Dependencies check on main is tracked in an issue.\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { readJobs, workflows } from './workflow-files.mjs';\n\ntest('the required stage checks report on every pull request (issue #111)', () => {\n  for (const name of ['javascript.yml', 'rust.yml', 'csharp.yml']) {\n    const { text } = workflows.find((workflow) => workflow.name === name);\n    const on = text.slice(text.indexOf('\\non:\\n'), text.indexOf('\\njobs:\\n'));\n    assert.match(on, /^ {2}pull_request:/m, `${name} must run on pull requests`);\n    assert.doesNotMatch(\n      on,\n      /^ {4}paths(?:-ignore)?:/m,\n      `${name}: a path filter would skip the parity check and leave its required check pending`,\n    );\n    assert.match(text, /^ {2}pipeline-status:\\n {4}name: Pipeline Status \\(\\w+\\)/m);\n  }\n});\n\ntest('read-only concurrency only replaces superseded PR synchronizations (issue #207)', () => {\n  const scope =\n    \"${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}\";\n  const cancel = \"${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\";\n  for (const { name, text } of workflows) {\n    const groups = [...text.matchAll(/^ +group: (.*)\\n +cancel-in-progress: (.*)$/gm)];\n    assert.ok(groups.length, `${name}: missing concurrency groups`);\n    const queueCount = [...text.matchAll(/^ +queue\\s*:/gm)].length;\n    let writerGroups = 0;\n    for (const [block, group, policy] of groups) {\n      if (group.startsWith('main-writer-')) {\n        writerGroups++;\n        const nextLine = text.slice(text.indexOf(block) + block.length + 1).split('\\n')[0];\n        assert.equal(nextLine.trim(), 'queue: max', `${name}: writer lost its queue`);\n      }\n      if (policy === 'false') continue;\n      assert.equal(policy, cancel, `${name}: ${group} cancels unrelated runs`);\n      assert.ok(group.includes(scope), `${name}: ${group} can collide across revisions or events`);\n    }\n    assert.equal(queueCount, writerGroups, `${name}: queue is only supported for shared writers`);\n  }\n});\n\ntest('every suite proves it loaded the shared golden fixtures (issue #111)', () => {\n  for (const [name, suite, job] of [\n    ['rust.yml', 'rust', 'test'],\n    ['csharp.yml', 'csharp', 'test'],\n    ['javascript-stage.yml', 'javascript', 'stage'],\n  ]) {\n    const { text } = workflows.find((workflow) => workflow.name === name);\n    const tests = readJobs(text).find((candidate) => candidate.name === job).body;\n    assert.match(\n      tests,\n      new RegExp(`GOLDEN_FIXTURES_RECEIPT: \\\\$\\\\{\\\\{ runner\\\\.temp \\\\}\\\\}/golden-${suite}\\\\.json`),\n    );\n    assert.match(\n      tests,\n      new RegExp(`node parity/check-parity\\\\.mjs --receipt ${suite} \"\\\\$RECEIPT\"`),\n    );\n  }\n});\n\n// link-foundation repositories have no stale pull request policy: work on a\n// pull request can always continue, so nothing closes, labels or rebases one\n// because time has passed (the owner's review of PR #180 for issue #111).\ntest('no workflow flags or closes pull requests for inactivity (issue #111)', () => {\n  for (const { name, text } of workflows) {\n    assert.doesNotMatch(text, /uses: actions\\/stale@/, `${name}: actions/stale is not allowed`);\n    assert.doesNotMatch(\n      text,\n      /days-before-(?:pr-)?(?:stale|close)|stale-pr-label|close-pr-message/,\n      `${name}: a stale pull request setting is not allowed`,\n    );\n    assert.doesNotMatch(\n      text,\n      /gh pr close|pulls\\/[^\\n]*state[^\\n]*closed|pulls\\.update\\([^)]*state: ['\"]closed/,\n      `${name}: a workflow must not close pull requests`,\n    );\n  }\n  assert.ok(\n    !workflows.some(({ name }) => /^stale\\.ya?ml$/.test(name)),\n    'a stale workflow is not allowed',\n  );\n});\n\ntest('a red Dependencies check on main opens or updates a tracking issue (issue #111)', () => {\n  const { text } = workflows.find(({ name }) => name === 'dependencies.yml');\n  const jobs = readJobs(text);\n  const job = jobs.find(({ name }) => name === 'tracking-issue');\n  assert.ok(job, 'dependencies.yml has no tracking-issue job');\n  assert.match(job.body, /^ {6}- latest$/m);\n  assert.match(job.body, /\\$\\{\\{ !cancelled\\(\\) && github\\.ref == 'refs\\/heads\\/main'/);\n  assert.match(\n    job.body,\n    /\\(github\\.event_name == 'schedule' \\|\\| github\\.event_name == 'workflow_dispatch' \\|\\|\\s+needs\\.latest\\.result == 'failure' \\|\\| needs\\.javascript\\.result == 'failure'\\)/,\n  );\n  assert.match(\n    jobs.find(({ name }) => name === 'latest').body,\n    /CHECK_DEPENDENCIES_MODE: \\$\\{\\{ github\\.event_name == 'push' && 'report' \\|\\| 'enforce' \\}\\}/,\n  );\n  assert.doesNotMatch(text, /^concurrency:/m);\n  assert.match(job.body, /^ {6}issues: write$/m);\n  assert.match(job.body, /^ {6}group: dependencies-tracking-\\$\\{\\{ github\\.ref \\}\\}$/m);\n  assert.match(job.body, /^ {6}cancel-in-progress: false$/m);\n  assert.match(job.body, /run: node \\.github\\/scripts\\/dependency-tracking-issue\\.mjs/);\n  assert.match(text, /^ {2}schedule:/m);\n});\n\n// .github/zizmor.yml disables the self-repository audit because actionlint\n// cannot parse `uses: $/...` yet (rhysd/actionlint#711). That is safe only\n// while every local reference is a job-level reusable workflow call, which\n// GitHub resolves from the caller's commit rather than the workspace.\ntest('no step loads a local action from the workspace', () => {\n  for (const { name, text } of workflows) {\n    assert.doesNotMatch(text, /^\\s+- uses: \\.\\//m, `${name}: a step-level uses: ./ action`);\n    assert.doesNotMatch(text, /^ {6,}uses: \\.\\//m, `${name}: a step-level uses: ./ action`);\n  }\n});\n\n// The rules on main require the three stage checks, and the release jobs'\n// version commits are new commits without checks. Only the release deploy key\n// bypasses those rules; GITHUB_TOKEN cannot be a bypass actor (issue #111).\ntest('jobs that push a version commit to main use the release deploy key (issue #111)', () => {\n  const pushers = workflows.flatMap(({ name, text }) =>\n    readJobs(text)\n      .filter(({ body }) => /version-and-commit\\.(?:mjs|rs)/.test(body))\n      .map((job) => ({ workflow: name, ...job })),\n  );\n  assert.deepEqual(pushers.map(({ workflow, name }) => `${workflow}: ${name}`).sort(), [\n    'csharp.yml: instant-release',\n    'csharp.yml: release',\n    'rust.yml: auto-release',\n    'rust.yml: manual-release',\n  ]);\n  for (const { workflow, name, body } of pushers) {\n    const where = `${workflow}: ${name}`;\n    assert.match(\n      body,\n      /^ {4}environment: release$/m,\n      `${where} must run in the release environment`,\n    );\n    const checkout = /- uses: actions\\/checkout@\\S+\\n(?: {8}.*\\n)+/.exec(body)?.[0] ?? '';\n    assert.match(checkout, /^ {10}ssh-key: \\$\\{\\{ secrets\\.RELEASE_DEPLOY_KEY \\}\\}$/m, where);\n    assert.doesNotMatch(checkout, /^ {10}token:/m,…`);\n  }\n});\n// Verify the registry's trusted publisher policy without uploading a package.\n// API: https://api-docs.npmjs.com/#tag/OIDC\nimport { resolve } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\n// The packages this repository publishes, each from its own workflow: the\n// trusted publisher policy on npmjs.com names that workflow file.\nexport const NPM_WORKFLOWS = {\n  '@link-foundation/link-cli-client': 'js-client.yml',\n  '@link-foundation/link-cli-server': 'js-server.yml',\n};\n\nexport async function verifyNpmTrust(\n  packageName,\n  { env = process.env, fetch = globalThis.fetch } = {},\n) {\n  if (!env.ACTIONS_ID_TOKEN_REQUEST_URL || !env.ACTIONS_ID_TOKEN_REQUEST_TOKEN) {\n    throw new Error('npm verification requires GitHub Actions with id-token: [REDACTED]\n  }\n  const url = new URL(env.ACTIONS_ID_TOKEN_REQUEST_URL);\n  url.searchParams.set('audience', 'npm:registry.npmjs.org');\n  const oidc = await fetch(url, {\n    headers: { Authorization: [REDACTED] ${env.ACTIONS_ID_TOKEN_REQUEST_TOKEN}` },\n    signal: AbortSignal.timeout(30_000),\n  });\n  if (!oidc.ok) throw new Error(`GitHub OIDC request failed: HTTP ${oidc.status}`);\n  const { value } = await oidc.json();\n  if (!value) throw new Error('GitHub OIDC response is missing a token');\n  const exchange = await fetch(\n    `https://registry.npmjs.org/-/npm/v1/oidc/token/exchange/package/${encodeURIComponent(packageName)}`,\n    {\n      method: 'POST',\n      headers: { Authorization: [REDACTED] ${value}` },\n      signal: AbortSignal.timeout(30_000),\n    },\n  );\n  if (!exchange.ok) {\n    const context = `npm trusted publisher verification failed for ${packageName} (HTTP ${exchange.status})`;\n    if (exchange.status === 404) {\n      const packument = await fetch(\n        `https://registry.npmjs.org/${encodeURIComponent(packageName)}`,\n        { signal: AbortSignal.timeout(15_000) },\n      ).catch(() => null);\n      if (packument?.status === 404) {\n        throw new Error(\n          `${context}. A maintainer must publish the first public version, then configure ${NPM_WORKFLOWS[packageName] ?? 'the release workflow'} as its trusted publisher and rerun authentication-only verification on main.`,\n        );\n      }\n      if (!packument?.ok) {\n        throw new Error(\n          `${context}. Public package lookup was inconclusive (${packument?.status ?? 'network error'}). Check registry availability and retry the authentication-only verification.`,\n        );\n      }\n    }\n    if ([401, 403, 404].includes(exchange.status)) {\n      throw new Error(\n        `${context}. Check the npm trusted publisher settings for this repository and ${NPM_WORKFLOWS[packageName] ?? 'its release workflow'}, including any required environment and permission to publish directly.`,\n      );\n    }\n    throw new Error(\n      `${context}. Check registry availability and retry the authentication-only verification.`,\n    );\n  }\n  if (!(await exchange.json()).token)\n    throw new Error(`npm trusted publisher response for ${packageName} is missing a token`);\n  // Discard the short-lived credential. Never write it to logs, disk or outputs.\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {\n  try {\n    await verifyNpmTrust(process.env.NPM_PACKAGE || '@link-foundation/link-cli-client');\n    console.log('npm trusted publisher authentication succeeded. No package was uploaded.');\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n/tmp/link-cli-207-templates/rust/.github/workflows/javascript-first-gate.yml-45-      group: check-${{ github.workflow }}-${{ github.ref }}-javascript-prerequisite\n/tmp/link-cli-207-templates/rust/.github/workflows/javascript-first-gate.yml:46:      cancel-in-progress: true\n--\n/tmp/link-cli-207-templates/js/.github/workflows/example-app.yml-73-      group: check-${{ github.workflow }}-${{ github.ref }}-web-build\n/tmp/link-cli-207-templates/js/.github/workflows/example-app.yml:74:      cancel-in-progress: true\n--\n/tmp/link-cli-207-templates/js/.github/workflows/example-app.yml-145-      cancel-in-progress: false\n/tmp/link-cli-207-templates/js/.github/workflows/example-app.yml:146:      q