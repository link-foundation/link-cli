[2026-11-27T21:00:51.366Z] [STDOUT] {"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' experiments/issue-138/etcd-cluster.mjs && sed -n '350,470p' experiments/issue-138/etcd-cluster.mjs && sed -n '385,530p' .github/workflows/js-client.yml\"","aggregated_output":"// Bounded real consensus integration. All children are killed and reaped.\n// ETCD_BIN=/path/to/etcd node experiments/issue-138/etcd-cluster.mjs\nimport assert from 'node:assert/strict';\nimport { spawn } from 'node:child_process';\nimport { once } from 'node:events';\nimport { createWriteStream, mkdtempSync, readFileSync } from 'node:fs';\nimport net from 'node:net';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { ClusterEngine, EtcdJournalStore } from '../../js/client/src/cluster.js';\nimport { waitForMembers } from './etcd-harness.mjs';\nimport { verifyAuthorFence } from '../../examples/native-lsm-js/author-fence-consensus.mjs';\nimport { verifyAddressAllocation } from '../../examples/native-lsm-js/allocation-consensus.mjs';\nimport { PartitionedJournalStore } from '../../js/client/src/partitioned.js';\n\nconst wasmDirectory = resolve(process.env.CLINK_WASM ?? 'js/pkg');\nconst binding = await import(pathToFileURL(join(wasmDirectory, 'clink_wasm.js')).href);\nbinding.initSync({ module: readFileSync(join(wasmDirectory, 'clink_wasm_bg.wasm')) });\nconst binary =\n  process.env.ETCD_BIN ?? resolve('experiments/issue-138/etcd/etcd-v3.7.3-linux-amd64/etcd');\nconst directory = mkdtempSync(resolve('experiments/issue-138/etcd/run-'));\nconst checkpoint = process.env.CLUSTER_JOURNAL_CHECKPOINT_INTERVAL === '1';\nconst checkpointFlags = checkpoint ? ['--checkpoint'] : [];\nconst checkpointOptions = checkpoint ? { journalCheckpointInterval: 1 } : {};\nconst ports = [];\nconst reservations = [];\ntry {\n  for (let i = 0; i < 10; i++) {\n    const server = net.createServer();\n    reservations.push(server);\n    await new Promise((done, reject) => {\n      server.once('error', reject);\n      server.listen(0, '127.0.0.1', done);\n    });\n    ports.push(server.address().port);\n  }\n} finally {\n  await Promise.all(reservations.map((server) => new Promise((done) => server.close(done))));\n}\nconst endpoints = ports.slice(0, 3).map((port) => `http://127.0.0.1:${port}`);\nconst peers = ports.slice(3, 6).map((port) => `http://127.0.0.1:${port}`);\nconst cluster = peers.map((peer, i) => `n${i}=${peer}`).join(',');\nconst nodes = [];\nconst delay = (ms) => new Promise((done) => setTimeout(done, ms));\nasync function stop(node) {\n  if (node.child.exitCode === null && node.child.signalCode === null) node.child.kill('SIGKILL');\n  await node.exited;\n}\nasync function ready(action) {\n  let failure;\n  for (let attempt = 0; attempt < 30; attempt++) {\n    try {\n      return await action();\n    } catch (error) {\n      failure = error;\n      await delay(100);\n    }\n  }\n  throw failure;\n}\nasync function javascriptExample(args, engine) {\n  const child = spawn(\n    process.execPath,\n    ['js/client/examples/cluster.mjs', ...args, ...checkpointFlags],\n    {\n      env: { ...process.env, CLINK_WASM: wasmDirectory },\n      stdio: 'inherit',\n    },\n  );\n  assert.equal((await once(child, 'exit'))[0], 0);\n  const read = await engine.begin(['a', 'b']);\n  try {\n    for (const key of ['a', 'b'])\n      assert.equal(await read.shard(key).getName(1), 'JS coordinated 雪');\n  } finally {\n    await read.close();\n  }\n  console.log('PASS public JS HTTP example: native journals reopen through actual WASM');\n}\ntry {\n  for (let i = 0; i < 3; i++) {\n    const log = createWriteStream(join(directory, `n${i}.log`));\n    const child = spawn(\n      binary,\n      [\n        '--name',\n        `n${i}`,\n        '--data-dir',\n        join(directory, `n${i}`),\n        '--listen-client-urls',\n        endpoints[i],\n        '--advertise-client-urls',\n        endpoints[i],\n        '--listen-peer-urls',\n        peers[i],\n        '--initial-advertise-peer-urls',\n        peers[i],\n        '--initial-cluster',\n        cluster,\n        '--initial-cluster-token',\n        `issue-138-${ports[0]}`,\n        '--quota-backend-bytes',\n        '16777216',\n        '--snapshot-count',\n        '1000',\n        '--log-level',\n        'warn',\n      ],\n      { env: { ...process.env, GOMEMLIMIT: '100MiB' }, stdio: ['ignore', 'pipe', 'pipe'] },\n    );\n    child.stdout.pipe(log);\n    child.stderr.pipe(log);\n    nodes.push({ child, exited: once(child, 'exit'), log });\n  }\n  const options = { prefix: '/issue138/', timeoutMs: 700 };\n  await waitForMembers(endpoints);\n  await verifyAddressAllocation(endpoints, binding);\n  await verifyAuthorFence(endpoints, binding);\n  const store = new EtcdJournalStore(endpoints, options);\n  await ready(() => store.read(['a']));\n  const engine = new ClusterEngine(binding, store, {\n    requireDurableFlush: true,\n    ...checkpointOptions,\n  });\n  const seed = await engine.begin(['a', 'b']);\n  await seed.shard('a').create(0, 0);\n  await seed.shard('b').create(0, 0);\n  await seed.commit();\n  if (checkpoint)\n    for (const value of await store.read(['a', 'b'])) {\n      assert.equal(value.entries.length, 1);\n      assert.ok(value.entries[0].startsWith('engine3|'));\n    }\n  const stale = await engine.begin(['a', 'b']);\n  const other = new ClusterEngine(\n    binding,\n    new EtcdJournalStore(endpoints, options),\n    checkpointOptions,\n  );\n  const fresh = await other.begin(['b']);\n  await fresh.shard('b').setName(1, 'leader-safe 雪');\n  await fresh.commit();\n  await stale.shard('a').delete(1);\n  await assert.rejects(stale.commit(), { outcome: 'failed' });\n  console.log('PASS real etcd: atomic multi-shard CAS and read-only dependency conflict');\n\n  let loseReply = true;\n  const lossy = new EtcdJournalStore(endpoints, {\n    ...options,\n    fetch: async (url, request) => {\n      const result = await fetch(url, request);\n      if (loseReply && JSON.parse(request.body).compare) {\n        loseReply = false;\n        await result.body.cancel();\n        throw Error('injected lost commit response');\n      }\n      return result;\n    },\n  });\n  const uncertain = await new ClusterEngine(binding, lossy, checkpointOptions).begin(['a', 'b']);\n  await uncertain.shard('a').setName(1, 'unknown committed');\n  await uncertain.shard('b').setName(1, 'unknown committed');\n  await assert.rejects(uncertain.commit(), { outcome: 'unknown' });\n  const recovered = await engine.begin(['a', 'b']);\n  assert.equal(await recovered.shard('a').getName(1), 'unknown committed');\n  assert.equal(await recovered.shard('b').getName(1), 'unknown committed');\n  await recovered.close();\n  console.log('PASS real etcd: dropped response discovers both committed shards without replay');\n\n  if (process.env.CLUSTER_RUST_EXAMPLE) {\n    const child = spawn(\n      process.env.CLUSTER_RUST_EXAMPLE,\n      [endpoints.join(','), '/issue138/', ...checkpointFlags],\n      { stdio: 'inherit' },\n    );\n    assert.equal((await once(child, 'exit'))[0], 0);\n  }\n  if (process.env.CLUSTER_CSHARP_EXAMPLE) {\n    const child = spawn(\n      'dotnet',\n      [process.env.CLUSTER_CSHARP_EXAMPLE, endpoints.join(','), '/issue138/', ...checkpointFlags],\n      { env: { ...process.env, DOTNET_GCHeapHardLimit: '0x18000000' }, stdio: 'inherit' },\n    );\n    assert.equal((await once(child, 'exit'))[0], 0);\n  }\n  const native = await engine.begin(['a', 'b']);\n  for (const key of ['a', 'b'])\n    assert.equal(\n      await native.shard(key).getName(1),\n      process.env.CLUSTER_CSHARP_EXAMPLE\n        ? 'C# coordinated 雪'\n        : process.env.CLUSTER_RUST_EXAMPLE\n          ? 'Rust coordinated 雪'\n          : 'unknown committed',\n    );\n  await native.close();\n  await javascriptExample([endpoints.join(','), '/issue138/'], engine);\n\n  // Two additional single-member consensus groups demonstrate physically\n  // independent bulk storage. The three-member catalog carries pointers only.\n  const dataEndpoints = ports.slice(6, 8).map((port) => `http://127.0.0.1:${port}`);\n  for (let i = 0; i < 2; i++) {\n    const name = `data${i}`;\n    const peer = `http://127.0.0.1:${ports[8 + i]}`;\n    const log = createWriteStream(join(directory, `${name}.log`));\n    const child = spawn(\n      binary,\n      [\n        '--name',\n        name,\n        '--data-dir',\n        join(directory, name),\n        '--listen-client-urls',\n        dataEndpoints[i],\n        '--advertise-client-urls',\n        dataEndpoints[i],\n        '--listen-peer-urls',\n        peer,\n        '--initial-advertise-peer-urls',\n        peer,\n        '--initial-cluster',\n        `${name}=${peer}`,\n        '--initial-cluster-token',\n        `issue-138-${ports[0]}-${name}`,\n        '--quota-backend-bytes',\n        '16777216',\n        '--log-level',\n        'warn',\n      ],\n      { env: { ...process.env, GOMEMLIMIT: '100MiB' }, stdio: ['ignore', 'pipe', 'pipe'] },\n  await assert.rejects(unavailable.commit());\n  assert.deepEqual(await catalog.read(['a', 'b']), pointers);\n  if (cacheBytes > 0) {\n    const cachedWest = await partitionedEngine.begin(['b']);\n    assert.equal(await cachedWest.shard('b').getName(1), 'JS coordinated 雪');\n    await cachedWest.close();\n    console.log(\n      'PASS immutable object cache: previously verified west remains readable during its data-group outage',\n    );\n  } else await assert.rejects(partitionedEngine.begin(['b']));\n  const isolated = await partitionedEngine.begin(['a']);\n  await isolated.shard('a').setName(1, 'independent group available');\n  await isolated.commit();\n  const isolatedRead = await partitionedEngine.begin(['a']);\n  assert.equal(await isolatedRead.shard('a').getName(1), 'independent group available');\n  await isolatedRead.close();\n  console.log(\n    'PASS independent consensus groups: unavailable west publishes nothing; east still commits',\n  );\n\n  // The member each reachable endpoint names as leader, as an index.\n  async function leaderOf(indices) {\n    const status = await Promise.all(\n      indices.map(async (i) =>\n        (\n          await fetch(`${endpoints[i]}/v3/maintenance/status`, {\n            method: 'POST',\n            body: '{}',\n            signal: AbortSignal.timeout(2000),\n          })\n        ).json(),\n      ),\n    );\n    const leaders = new Set(status.map((item) => item.leader));\n    assert.equal(leaders.size, 1, 'reachable members agree on one leader');\n    const index = status.findIndex((item) => item.header.member_id === item.leader);\n    return index >= 0 ? indices[index] : null;\n  }\n\n  // A paused leader. SIGSTOP freezes it, so its peers stop hearing from it as\n  // if a partition cut it off, and on SIGCONT it comes back still believing it\n  // leads, as after a healed partition (Jepsen's \"pause\" fault). A transaction\n  // staged before the pause must not commit after it: the majority moved on.\n  const paused = await leaderOf([0, 1, 2]);\n  assert.ok(paused !== null);\n  const beforePause = await engine.begin(['a', 'b']);\n  await beforePause.shard('a').setName(1, 'staged before the pause');\n  nodes[paused].child.kill('SIGSTOP');\n  try {\n    const majority = await ready(() => engine.begin(['a', 'b']));\n    await majority.shard('b').setName(1, 'majority while the leader is paused');\n    await majority.commit();\n    const others = [0, 1, 2].filter((i) => i !== paused);\n    const elected = await ready(async () => {\n      const leader = await leaderOf(others);\n      if (leader === null) throw new Error('no leader among the majority yet');\n      return leader;\n    });\n    assert.notEqual(elected, paused);\n  } finally {\n    nodes[paused].child.kill('SIGCONT');\n  }\n  // A conflict, or a timeout while the resumed member catches up. Either way\n  // the compare names the old revision, so it cannot apply; the read below\n  // checks that it did not.\n  await assert.rejects(beforePause.commit(), (error) =>\n    ['failed', 'unknown'].includes(error.outcome),\n  );\n  // Read through the resumed member alone: it serves the majority's history.\n  const throughResumed = new ClusterEngine(\n    binding,\n    new EtcdJournalStore([endpoints[paused]], options),\n    checkpointOptions,\n  );\n  const healed = await ready(() => throughResumed.begin(['a', 'b']));\n  assert.equal(await healed.shard('b').getName(1), 'majority while the leader is paused');\n  assert.notEqual(await healed.shard('a').getName(1), 'staged before the pause');\n  await healed.close();\n  assert.notEqual(await ready(() => leaderOf([0, 1, 2])), paused);\n  console.log(\n    `PASS real etcd: paused leader n${paused}; the majority elected another and committed, the stale transaction was refused, and the resumed member serves the new history`,\n  );\n\n  const leader = await leaderOf([0, 1, 2]);\n  assert.ok(leader !== null);\n  await stop(nodes[leader]);\n  const after = await ready(() => engine.begin(['a', 'b']));\n  assert.equal(await after.shard('a').count(), 1n);\n  assert.equal(await after.shard('b').count(), 1n);\n  await after.shard('a').setName(1, 'after failover');\n  await after.commit();\n  console.log(`PASS real etcd: killed leader n${leader}; surviving majority elected and committed`);\n  const second = [0, 1, 2].find((i) => i !== leader);\n  await stop(nodes[second]);\n  await assert.rejects(engine.begin(['a', 'b']));\n  await assert.rejects(partitionedEngine.begin(['a']));\n  console.log('PASS real etcd: majority loss refuses a fresh linearizable snapshot');\n} finally {\n  await Promise.all(nodes.map(stop));\n  for (const node of nodes) node.log.end();\n  console.log(`etcd evidence: ${directory}`);\n}\n          bun examples/journal-chunks/measure.mjs > experiments/issue-138/chunks-bun-payloads.json\n          deno run --allow-read --allow-env examples/journal-chunks/measure.mjs > experiments/issue-138/chunks-deno-payloads.json\n          cmp experiments/issue-138/chunks-node-payloads.json experiments/issue-138/chunks-bun-payloads.json\n          cmp experiments/issue-138/chunks-node-payloads.json experiments/issue-138/chunks-deno-payloads.json\n          node --max-old-space-size=256 examples/journal-chunks/reclaim.mjs > experiments/issue-138/chunks-reclaim-node-payloads.json\n          bun examples/journal-chunks/reclaim.mjs > experiments/issue-138/chunks-reclaim-bun-payloads.json\n          deno run --allow-read --allow-env examples/journal-chunks/reclaim.mjs > experiments/issue-138/chunks-reclaim-deno-payloads.json\n          cmp experiments/issue-138/chunks-reclaim-node-payloads.json experiments/issue-138/chunks-reclaim-bun-payloads.json\n          cmp experiments/issue-138/chunks-reclaim-node-payloads.json experiments/issue-138/chunks-reclaim-deno-payloads.json\n\n      - name: Verify complete native LSM store handoffs\n        env:\n          RUST_NATIVE_LSM_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/native_lsm\n        run: |\n          cargo build --release --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm,causal-merkle,causal-batches,causal-sessions,address-reservations,author-fencing --example native_lsm\n          python3 examples/native-lsm-js/run-interop.py\n          NATIVE_LSM_LAYOUT=chunks python3 examples/native-lsm-js/run-interop.py\n          NATIVE_LSM_LAYOUT=reclaiming-chunks python3 examples/native-lsm-js/run-interop.py\n          NATIVE_LSM_LAYOUT=causal python3 examples/native-lsm-js/run-interop.py\n          python3 examples/native-lsm-js/run-causal-faults.py\n          NATIVE_LSM_LAYOUT='batch' python3 examples/native-lsm-js/run-interop.py\n          NATIVE_CAUSAL_LAYOUT='batch' python3 examples/native-lsm-js/run-causal-faults.py\n          NATIVE_LSM_LAYOUT='session' python3 examples/native-lsm-js/run-interop.py\n          NATIVE_CAUSAL_LAYOUT='session' python3 examples/native-lsm-js/run-causal-faults.py\n          NATIVE_LSM_LAYOUT='fence' python3 examples/native-lsm-js/run-interop.py\n          NATIVE_LSM_LAYOUT='allocation' python3 examples/native-lsm-js/run-interop.py\n          NATIVE_CAUSAL_LAYOUT='allocation' python3 examples/native-lsm-js/run-causal-faults.py\n          NATIVE_CAUSAL_LAYOUT='fence' python3 examples/native-lsm-js/run-causal-faults.py\n          python3 examples/native-lsm-js/run-merkle-interop.py\n\n      - name: Verify actual consensus and language interoperability\n        env:\n          ETCD_BIN: ${{ github.workspace }}/experiments/issue-138/etcd/etcd-v3.7.3-linux-amd64/etcd\n          MAINTENANCE_RUST_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/journal_maintenance\n          MAINTENANCE_CSHARP_EXAMPLE: ${{ github.workspace }}/examples/journal-maintenance-csharp/bin/Release/net10.0/JournalMaintenanceExample.dll\n          RECLAMATION_RUST_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/journal_reclamation\n          RECLAMATION_CSHARP_EXAMPLE: ${{ github.workspace }}/examples/journal-reclamation-csharp/bin/Release/net10.0/JournalReclamationExample.dll\n          CLUSTER_RUST_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/cluster\n          FENCE_RUST_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/author_fence\n          ALLOCATION_RUST_EXAMPLE: ${{ github.workspace }}/rust/target/release/examples/address_allocation\n          CLUSTER_CSHARP_EXAMPLE: ${{ github.workspace }}/examples/cluster-csharp/bin/Release/net10.0/ClusterExample.dll\n        run: |\n          mkdir -p experiments/issue-138/etcd\n          curl --fail --location --retry 3 --output experiments/issue-138/etcd/etcd-v3.7.3-linux-amd64.tar.gz https://github.com/etcd-io/etcd/releases/download/v3.7.3/etcd-v3.7.3-linux-amd64.tar.gz\n          printf '%s  %s\\n' '5df…775' 'experiments/issue-138/etcd/etcd-v3.7.3-linux-amd64.tar.gz' | sha256sum --check\n          tar -xzf experiments/issue-138/etcd/etcd-v3.7.3-linux-amd64.tar.gz -C experiments/issue-138/etcd\n          node --test --test-timeout=10000 experiments/issue-138/etcd-harness.test.mjs\n          node experiments/issue-138/etcd-maintenance.mjs\n          node experiments/issue-138/etcd-reclamation.mjs\n          RECLAMATION_CHUNKS=1 node experiments/issue-138/etcd-reclamation.mjs\n          node experiments/issue-138/etcd-cluster.mjs\n          CLUSTER_JOURNAL_CHECKPOINT_INTERVAL=1 node experiments/issue-138/etcd-cluster.mjs\n          node experiments/issue-138/etcd-partition.mjs\n          PARTITION_SEED=2026 node experiments/issue-138/etcd-partition.mjs\n\n      - name: Verify finite checkpoint payloads with actual WASM\n        run: |\n          node examples/journal-checkpoints/measure.mjs > experiments/issue-138/checkpoint-node.json\n          bun examples/journal-checkpoints/measure.mjs > experiments/issue-138/checkpoint-bun.json\n          deno run --allow-all examples/journal-checkpoints/measure.mjs > experiments/issue-138/checkpoint-deno.json\n          cmp experiments/issue-138/checkpoint-node.json experiments/issue-138/checkpoint-bun.json\n          cmp experiments/issue-138/checkpoint-node.json experiments/issue-138/checkpoint-deno.json\n\n      - name: Verify checkpoint and physical delta composition with actual WASM\n        run: |\n          node examples/journal-checkpoints/delta.mjs > experiments/issue-138/checkpoint-delta-node.json\n          bun examples/journal-checkpoints/delta.mjs > experiments/issue-138/checkpoint-delta-bun.json\n          deno run --allow-all examples/journal-checkpoints/delta.mjs > experiments/issue-138/checkpoint-delta-deno.json\n          cmp experiments/issue-138/checkpoint-delta-node.json experiments/issue-138/checkpoint-delta-bun.json\n          cmp experiments/issue-138/checkpoint-delta-node.json experiments/issue-138/checkpoint-delta-deno.json\n\n      - name: Verify engine compaction with actual WASM and both bank modes\n        run: |\n          node examples/journal-checkpoints/compact.mjs > experiments/issue-138/checkpoint-compact-node.json\n          bun examples/journal-checkpoints/compact.mjs > experiments/issue-138/checkpoint-compact-bun.json\n          deno run --allow-all examples/journal-checkpoints/compact.mjs > experiments/issue-138/checkpoint-compact-deno.json\n          cmp experiments/issue-138/checkpoint-compact-node.json experiments/issue-138/checkpoint-compact-bun.json\n          cmp experiments/issue-138/checkpoint-compact-node.json experiments/issue-138/checkpoint-compact-deno.json\n\n      - name: Preserve checkpoint payload measurements\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-138-checkpoint-payloads\n          path: experiments/issue-138/checkpoint-*.json\n          if-no-files-found: ignore\n\n      - name: Preserve journal chunk payload measurements\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-138-journal-chunk-payloads\n          path: experiments/issue-138/chunks-*-payloads.json\n          if-no-files-found: ignore\n\n      - name: Preserve consensus member logs\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-138-etcd-logs\n          path: |\n            experiments/issue-138/etcd/run-*/*.log\n            experiments/issue-138/etcd/maintenance-*/*.log\n            experiments/issue-138/etcd/reclamation-*/*.log\n            experiments/issue-138/etcd/partition-*/*.log\n          if-no-files-found: ignore\n\n      - name: Conformance on Node.js\n        working-directory: js/client\n        run: node test/conformance/run.mjs\n\n      - name: Deterministic disk, backend power loss, network and Raft fault simulation\n        working-directory: js/client\n        run: node --test test/engine-simulation.test.mjs test/engine-power-loss-backends.test.mjs test/engine-raft-simulation.test.mjs\n\n      - name: Conformance on Bun\n        working-directory: js/client\n        run: bun test/conformance/run.mjs\n\n      - name: Conformance on Deno\n        working-directory: js/client\n        run: deno run --allow-all test/conformance/run.mjs\n\n      - name: SQLite journal providers and cross-language reopening\n        env:\n          CLINK_WASM: ${{ github.workspace }}/js/pkg\n        run: |\n          node experiments/issue-138/sqlite-adapter-contracts.mjs\n          bun experiments/issue-138/sqlite-adapter-contracts.mjs\n          deno run --allow-all experiments/issue-138/sqlite-adapter-contracts.mjs\n          cargo build --release --manifest-path rust/Cargo.toml --features sqlite --example engine_sqlite\n          dotnet build examples/sqlite-csharp --configuration Release\n          sqlite_data=$(mktemp -d)\n          for validation in scan indexed; do\n            for structure in shared flat; do\n              for encoding in changes snapshot; do\n                for physical in plain delta; do\n                  flags=(--references)\n                  if [[ \"$validation\" == indexed ]]; then flags+=(--indexed-constraints); fi\n                  if [[ \"$structure\" == flat ]]; then flags+=(--flat); fi\n                  if [[ \"$encoding\" == snapshot ]]; then flags+=(--snapshot); fi\n                  if [[ \"$physical\" == delta ]]; then flags+=(--delta); fi\n                  database=\"$sqlite_data/$validation-$structure-$encoding-$physical.db\"\n                  rust/target/release/examples/engine_sqlite \"$database\" \"${flags[@]}\"\n                  dotnet examples/sqlite-csharp/bin/Release/net10.0/SqliteExample.dll \"$database\" \"${flags[@]}\"\n                  node js/client/examples/engine-sqlite.mjs \"$database\" \"${flags[@]}\"\n","exit_code":0,"status":"completed"}}
