[2026-11-27T21:12:53.168Z] [STDOUT] {"type":"item.started","item":{"id":"item_189","type":"command_execution","command":"/bin/bash -lc \"mkdir -p experiments/issue-207\ncat > experiments/issue-207/compare-ci-files.py <<'EOF'\n\\\"\\\"\\\"Inventory CI inputs from link-cli and downloaded recursive template trees.\\\"\\\"\\\"\n\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\n\nROOT = Path(__file__).resolve().parents[2]\nTEMPLATES = (\\\"rust\\\", \\\"js\\\", \\\"csharp\\\", \\\"python\\\", \\\"java\\\", \\\"cpp\\\")\n\n\ndef ci_input(path: str) -> bool:\n    \\\"\\\"\\\"Include workflow-owned files, CI helpers, hooks, and root CI policies.\\\"\\\"\\\"\n    return (\n        path.startswith((\\\".github/\\\", \\\"scripts/\\\", \\\"parity/\\\"))\n        or re.match(r\\\"\"'^(csharp|js|rust)/scripts/\", path) is not None\n        or re.search(\n            r\"''^'\"\\\\.(pre-commit|lychee|secretlint|actionlint|zizmor|codecov|package-registry-manager)\\\",\n            path,\n        )\n        is not None\n    )\n\n\ndef stem(path: str) -> str:\n    return Path(path).stem.replace(\\\"_\\\", \\\"-\\\")\n\n\ndef purpose(path: str) -> str:\n    matched = (\n        (\\\"change detection and stage gate\\\", r\\\"detect|fresh-merge|javascript-first|javascript-stage|parity\\\"),\n        (\\\"registry and release\\\", r\\\"version|changelog|changeset|release|publish|registry|npm|pypi|nuget|crates|vcpkg|maven|package\\\"),\n        (\\\"workflow validation and status\\\", r\\\"workflow|status|gate|policy|concurrency|zizmor|actionlint\\\"),\n        (\\\"security and dependencies\\\", r\\\"security|secrets|codeql|audit|depend|sarif|credential|preflight\\\"),\n        (\\\"documentation and links\\\", r\\\"docs|lychee|links|web-archive|pages\\\"),\n        (\\\"runner and artifact handling\\\", r\\\"runner|unacquired|rerun|artifact|archive|budget|buildx\\\"),\n        (\\\"source and test quality\\\", r\\\"lint|format|file-size|line-limit|coverage|warnings|test\\\"),\n    )\n    for description, pattern in matched:\n        if re.search(pattern, path):\n            return description\n    return \\\"repository or language-specific infrastructure\\\"\n\n\ndef main() -> None:\n    directory = Path(sys.argv[1])\n    base = sys.argv[2]\n    local_tree = subprocess.check_output(\n        [\\\"git\\\", \\\"ls-tree\\\", \\\"-rz\\\", base], cwd=ROOT, text=True\n    )\n    local = {}\n    for entry in local_tree.rstrip(\\\"\\\\0\\\").split(\\\"\\\\0\\\"):\n        metadata, path = entry.split(\\\"\\\\t\\\", 1)\n        if ci_input(path):\n            local[path] = metadata.split()[2]\n    print(\\\"repository\\\\tpath\\\\tblob\\\\tpurpose\\\\tother repository matches\\\")\n    for name in (\\\"link-cli\\\", *TEMPLATES):\n        snapshot = local\n        if name \"'!= \"link-cli\":\n            tree = json.loads((directory / f\"{name}-tree.json\").read_text())[\"tree\"]\n            snapshot = {\n                file[\"path\"]: file[\"sha\"]\n                for file in tree\n                if file[\"type\"] == \"blob\" and ci_input(file[\"path\"])\n            }\n        for path, blob in sorted(snapshot.items()):\n            other = {}\n            if name == \"link-cli\":\n                for template in TEMPLATES:\n                    tree = json.loads((directory / f\"{template}-tree.json\").read_text())[\"tree\"]\n                    other.update(\n                        {\n                            f\"{template}/{file['\"'path']}\\\": file[\\\"sha\\\"]\n                            for file in tree\n                            if file[\\\"type\\\"] == \\\"blob\\\" and ci_input(file[\\\"path\\\"])\n                        }\n                    )\n            else:\n                other = local\n            peers = [\n                f\\\"{item} ({'identical' if digest == blob else 'same stem'})\\\"\n                for item, digest in other.items()\n                if digest == blob or stem(item) == stem(path)\n            ]\n            print(name, path, blob, purpose(path), \\\", \\\".join(peers) or \\\"-\\\", sep=\\\"\\\\t\\\")\n\n\nif __name__ == \\\"__main__\\\":\n    main()\nEOF\npython3 experiments/issue-207/compare-ci-files.py dev/log/issues/207/pulls/208/templates origin/main > dev/log/issues/207/pulls/208/templates/ci-file-comparison.tsv\nwc -l dev/log/issues/207/pulls/208/templates/ci-file-comparison.tsv\ncat /tmp/link-cli-207-upstream-issues.tsv\ncat /tmp/link-cli-207-upstream-issues.err\ntail -n 10 /tmp/link-cli-207-dotnet-403-format.log\ngit fetch origin main >/tmp/link-cli-207-main-refresh.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
