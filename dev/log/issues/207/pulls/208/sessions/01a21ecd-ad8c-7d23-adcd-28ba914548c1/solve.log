ob.body, /run: node \\.github\\/scripts\\/release-preflight\\.mjs nuget/);\n.github/scripts/workflow-policy.test.mjs:654:        /release-preflight/,\n.github/scripts/workflow-policy.test.mjs:661:      assert.match(job.body, /needs: \\[release-preflight, /, `${name} ${releaseJob}`);\n.github/scripts/workflow-policy.test.mjs:663:      if (condition) assert.match(condition, /needs\\.release-preflight\\.result == 'success'/);\n.github/scripts/workflow-policy.test.mjs:666:    assert.match(gate.body, /- release-preflight/, `${name} gate ignores the preflight`);\n.github/scripts/ci-governance.test.mjs:81:  assert.doesNotMatch(text, /^concurrency:/m);\n.github/scripts/ci-governance.test.mjs:84:  assert.match(job.body, /^ {6}cancel-in-progress: false$/m);\n[{\"conclusion\":\"failure\",\"databaseId\":46067171135,\"headSha\":\"26852bd276b6cdeef98316fae6d2526e2de80483\",\"name\":\"JavaScript\",\"status\":\"completed\"},{\"conclusion\":\"failure\",\"databaseId\":46067171208,\"headSha\":\"26852bd276b6cdeef98316fae6d2526e2de80483\",\"name\":\"Rust CI/CD Pipeline\",\"status\":\"completed\"},{\"conclusion\":\"failure\",\"databaseId\":46067171151,\"headSha\":\"26852bd276b6cdeef98316fae6d2526e2de80483\",\"name\":\"Dependencies\",\"status\":\"completed\"},{\"conclusion\":\"failure\",\"databaseId\":46067171139,\"headSha\":\"26852bd276b6cdeef98316fae6d2526e2de80483\",\"name\":\"C# CI/CD Pipeline\",\"status\":\"completed\"},{\"conclusion\":\"\",\"databaseId\":46067171262,\"headSha\":\"26852bd276b6cdeef98316fae6d2526e2de80483\",\"name\":\"Security\",\"status\":\"in_progress\"}]\n","exit_code":0,"status":"completed"}}
