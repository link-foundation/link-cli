 the configuration is not validated within 2 days, it expires and can no longer be used or edited. To continue using trusted publishing, delete the expired configuration, create a new one, and complete the first publish within 2 days.\n648-Recommended: Restrict token access when using trusted publishers\n649-Once you've configured trusted publishers for your package, we strongly recommend restricting traditional token-based publishing access for enhanced security.\n650-How to configure maximum security\n651-After enabling trusted publishers, navigate to your package's\n652-Settings\n653-→\n654-Publishing access\n655-Select\n656-\"Require two-factor authentication and disallow tokens\"\n657-Save your changes by clicking on\n658-Update Package Settings\n659-Why this matters\n660-Trusted publishers use short-lived, scoped credentials that are generated on-demand during your CI/CD workflow, eliminating the need for long-lived tokens. By restricting traditional token access while using trusted publishers, you reduce potential security risks associated with credential management.\n661-For even stronger security, configure your trusted publisher with\n662-stage-only permissions\n663-(allow\n664-npm stage publish\n665-but not\n666-npm publish\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { NPM_WORKFLOWS, verifyNpmTrust } from './verify-npm-trust.mjs';\n\ntest('npm trust verification exchanges OIDC credentials without publishing or using a secret', async () => {\n  const requests = [];\n  await verifyNpmTrust('@link-foundation/link-cli-client', {\n    env: {\n      ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…lue',\n      ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n    },\n    fetch: async (url, options) => {\n      requests.push({ url: String(url), ...options });\n      return Response.json(\n        requests.length === 1 ? { value: 'oidc-token' } : { token: 'tem…ken' },\n      );\n    },\n  });\n  assert.equal(requests.length, 2);\n  const oidc = new URL(requests[0].url);\n  assert.equal(oidc.searchParams.get('audience'), 'npm:registry.npmjs.org');\n  assert.equal(oidc.searchParams.get('existing'), 'value');\n  assert.equal(requests[0].headers.Authorization, 'Bearer runner-token');\n  assert.equal(\n    requests[1].url,\n    'https://registry.npmjs.org/-/npm/v1/oidc/token/exchange/package/%40link-foundation%2Flink-cli-client',\n  );\n  assert.equal(requests[1].method, 'POST');\n  assert.equal(requests[1].headers.Authorization, 'Bearer oidc-token');\n});\n\ntest('npm trust verification fails clearly when OIDC or the registry policy is missing', async () => {\n  await assert.rejects(verifyNpmTrust('package', { env: {} }), /id-token: [REDACTED]\n  const env = {\n    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n  };\n  for (const [response, error] of [\n    [new Response('', { status: 403 }), /OIDC.*403/],\n    [Response.json({}), /OIDC.*token/],\n  ]) {\n    await assert.rejects(verifyNpmTrust('package', { env, fetch: async () => response }), error);\n  }\n  for (const response of [new Response('', { status: 404 }), Response.json({})]) {\n    let calls = 0;\n    await assert.rejects(\n      verifyNpmTrust('package', {\n        env,\n        fetch: async () => (++calls === 1 ? Response.json({ value: 'oidc' }) : response),\n      }),\n      /npm.*trusted publisher/,\n    );\n  }\n});\n\ntest('npm trust failures name the workflow each package is published from', async () => {\n  const env = {\n    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n  };\n  for (const [packageName, workflow] of Object.entries(NPM_WORKFLOWS)) {\n    let calls = 0;\n    await assert.rejects(\n      verifyNpmTrust(packageName, {\n        env,\n        fetch: async () =>\n          ++calls === 1 ? Response.json({ value: 'oidc' }) : new Response('', { status: 404 }),\n      }),\n      (error) => error.message.includes(workflow) && error.message.includes(packageName),\n    );\n  }\n  assert.deepEqual(Object.values(NPM_WORKFLOWS), ['js-client.yml', 'js-server.yml']);\n});\n\ntest('npm OIDC exchange distinguishes a first publish, a missing trust mapping and an outage', async () => {\n  const env = {\n    ACTIONS_ID_TOKEN_REQUEST_URL: 'htt…idc',\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN: '[REDACTED]',\n  };\n  const name = '@link-foundation/link-cli-server';\n  for (const [exchange, metadata, expected] of [\n    [404, 404, /first public version.+js-server\\.yml/],\n    [404, 200, /settings.+js-server\\.yml.+publish directly/],\n    [404, 503, /lookup was inconclusive \\(503\\)/],\n    [429, undefined, /HTTP 429.+registry availability/],\n  ]) {\n    const requests = [];\n    await assert.rejects(\n      verifyNpmTrust(name, {\n        env,\n        fetch: async (url, options) => {\n          requests.push({ url: String(url), options });\n          if (requests.length === 1) return Response.json({ value: 'oidc' });\n          return new Response('', { status: requests.length === 2 ? exchange : metadata });\n        },\n      }),\n      expected,\n    );\n    assert.equal(requests.length, metadata === undefined ? 2 : 3);\n    if (metadata !== undefined) {\n","exit_code":0,"status":"completed"}}
