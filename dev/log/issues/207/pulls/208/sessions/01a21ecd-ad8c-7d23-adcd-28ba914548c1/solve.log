# saves; every branch restores main's cache (issue #172).\\n      - name: Save cargo cache\\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\\n        uses: actions/cache/save@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\\n\\n  # === TEST ===\\n  test:\\n    name: Test (${{ matrix.os }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 45\\n    concurrency:\\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-test-${{ matrix.os }}\\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\\n    needs: [javascript, detect-changes, changelog, lint]\\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch' || needs.changelog.result == 'success' || needs.changelog.result == 'skipped') }}\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-24.04, macos-26, windows-2025]\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: false\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update\\n          rustup default stable\\n\\n      - name: Restore cargo cache\\n        id: cargo-cache\\n        uses: actions/cache/restore@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          # Its own key: sharing the lint job's key let lint's clippy-only\\n          # cache win the save race, so tests restored almost nothing.\\n          key: ${{ runner.os }}-cargo-test-${{ hashFiles('rust/Cargo.lock') }}\\n          restore-keys: |\\n            ${{ runner.os }}-cargo-test-\\n\\n      - name: Setup Node.js for dependency boundary checks\\n        uses: actions/setup-node@v7\\n        with:\\n          node-version: '26.x'\\n\\n      - name: Verify SQLite is optional\\n        run: node .github/scripts/check-sqlite-optional.mjs rust\\n\\n      # Compile everything first and save the cache before the long test\\n      # run, so saving (3-5 minutes for ~3 GB on Windows) can never be what\\n      # pushes a job whose tests passed past timeout-minutes (issue #172).\\n      - name: Build test binaries\\n        shell: bash\\n        run: |\\n          cargo test --manifest-path rust/Cargo.toml --no-default-features --test doublets_storage_tests --test engine_journal_tests --no-run\\n          cargo test --manifest-path rust/Cargo.toml --all-features --no-run\\n          cargo build --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm\\n\\n      # Pull request caches are scoped to their merge ref, so only main\\n      # saves; every branch restores main's cache (issue #172).\\n      - name: Save cargo cache\\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\\n        uses: actions/cache/save@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\\n\\n      - name: Test native stores without optional providers\\n        run: cargo test --manifest-path rust/Cargo.toml --no-default-features --test doublets_storage_tests --test engine_journal_tests\\n\\n      # golden_fixtures_tests writes the receipt that the next step checks,\\n      # so a filtered or skipped golden fixture test fails CI (issue #111).\\n      - name: Run tests\\n        env:\\n          GOLDEN_FIXTURES_RECEIPT: ${{ runner.temp }}/golden-rust.json\\n        run: cargo test --manifest-path rust/Cargo.toml --all-features --verbose\\n\\n      - name: Check that the Rust suite loaded every golden fixture\\n        shell: bash\\n        env:\\n          RECEIPT: ${{ runner.temp }}/golden-rust.json\\n        run: node parity/check-parity.mjs --receipt rust \\\"$RECEIPT\\\"\\n\\n      - name: Run doc tests\\n        run: cargo test --manifest-path rust/Cargo.toml --doc --verbose\\n\\n      - name: Native LSM cluster consumers without SQL or a coordinator\\n        shell: bash\\n        run: |\\n          cargo build --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm\\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster direct\\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster partitioned\\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster chunks\\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster reclaiming\\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster reclaiming-chunks\\n\\n  # === COVERAGE MEASUREMENT ===\\n  coverage:\\n    name: Rust coverage\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 30\\n    concurrency:\\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-coverage\\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\\n    needs: [javascript, detect-changes]\\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.stack-changed == 'true'\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: false\\n\\n      - name: Setup Rust coverage tools\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update --component llvm-tools-preview\\n          rustup default stable\\n          cargo install cargo-llvm-cov --version 0.9.2 --locked\\n\\n      - name: Measure Rust test coverage\\n        # Branch instrumentation is experimental. Limit the unstable compiler\\n        # option to this measurement; normal builds still use stable Rust.\\n        env:\\n          RUSTC_BOOTSTRAP: '1'\\n          # Crash tests kill child processes on purpose. A kill during the\\n          # child's exit leaves a truncated profile, which only loses that\\n          # child's counters, so it must not discard every other profile.\\n          LLVM_PROFDATA_FLAGS: --failure-mode=all\\n        run: |\\n          cargo llvm-cov --manifest-path rust/Cargo.toml --all-features --branch --lcov --output-path rust/coverage.lcov\\n          cargo llvm-cov report --manifest-path rust/Cargo.toml --branch --json --summary-only --output-path rust/coverage-summary.json\\n\\n      - name: Check author guard coverage\\n        run: python3 experiments/issue-138/check-author-fence-rust-coverage.py rust/coverage-summary.json\\n\\n      - name: Preserve coverage report\\n        if: always()\\n        uses: actions/upload-artifact@v7\\n        with:\\n          name: rust-coverage\\n          path: |\\n            rust/coverage.lcov\\n            rust/coverage-summary.json\\n          if-no-files-found: error\\n\\n  # === SEMANTIC MERGE CONFLICT CHECK ===\\n  # Every other job tests the pull request head. A pull request can be green in\\n  # isolation and still break `main`: two changes that merge without a textual\\n  # conflict can still contradict each other semantically, and the breakage only\\n  # appears after the merge lands (issue #96). This job merges the head into the\\n  # current tip of the base branch and re-runs the fast checks on that tree.\\n  # Ported from the Rust pipeline template's \\\"Simulate fresh merge\\\" step.\\n  fresh-merge:\\n    name: Simulate Fresh Merge\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 30\\n    concurrency:\\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-fresh-merge\\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\\n    if: github.event_name == 'pull_request'\\n    needs: [javascript, detect-changes, lint]\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: false\\n          fetch-depth: 0\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update --component rustfmt,clippy\\n          rustup default stable\\n\\n      - name: Restore cargo cache\\n        id: cargo-cache\\n        uses: actions/cache/restore@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ runner.os }}-cargo-fresh-merge-${{ hashFiles('rust/Cargo.lock') }}\\n          restore-keys: |\\n            ${{ runner.os }}-cargo-fresh-merge-\\n\\n      - name: Simulate fresh merge with base branch\\n        env:\\n          GITHUB_BASE_REF: ${{ github.base_ref }}\\n          FRESH_MERGE_CHECKS: |\\n            cargo fmt --manifest-path rust/Cargo.toml --all -- --check\\n            cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings\\n            cargo test --manifest-path rust/Cargo.toml --all-features\\n        run: bash .github/scripts/simulate-fresh-merge.sh\\n\\n      # Pull request caches are scoped to their merge ref, so only main\\n      # saves; every branch restores main's cache (issue #172).\\n      - name: Save cargo cache\\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\\n        uses: actions/cache/save@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\\n\\n  # === BUILD ===\\n  build:\\n    name: Build Package\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 30\\n    concurrency:\\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-build\\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\\n    needs: [javascript, lint, test]\\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && needs.test.result == 'success' }}\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: false\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update\\n          rustup default stable\\n\\n      - name: Restore cargo cache\\n        id: cargo-cache\\n        uses: actions/cache/restore@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ runner.os }}-cargo-build-${{ hashFiles('rust/Cargo.lock') }}\\n          restore-keys: |\\n            ${{ runner.os }}-cargo-build-\\n\\n      - name: Build release\\n        run: cargo build --manifest-path rust/Cargo.toml --release --verbose\\n\\n      # Write N+100 of `clink --transactions` must not be much slower than\\n      # write N on a constant-size store (issue #195).\\n      - name: Benchmark transactional writes\\n        run: node .github/scripts/transactions-benchmark.mjs -- rust/target/release/clink\\n\\n      - name: Check package\\n        run: cargo package --manifest-path rust/Cargo.toml --list --allow-dirty\\n\\n      # Pull request caches are scoped to their merge ref, so only main\\n      # saves; every branch restores main's cache (issue #172).\\n      - name: Save cargo cache\\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\\n        uses: actions/cache/save@v6\\n        with:\\n          path: |\\n            ~/.cargo/registry\\n            ~/.cargo/git\\n            rust/target\\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\\n\\n  # === AUTO RELEASE ===\\n  auto-release:\\n    name: Auto Release\\n    needs: [release-preflight, javascript, lint, test, build]\\n    if: ${{ !cancelled() && needs.release-preflight.result == 'success' && needs.javascript.result == 'success' && github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 60\\n    # Writer group: never cancel a release that may already have published a\\n    # crate or pushed a version commit.\\n    concurrency:\\n      group: main-writer-${{ github.repository }}\\n      cancel-in-progress: false\\n      queue: max\\n    permissions:\\n      id-token: write\\n      contents: write\\n    environment: release\\n    steps:\\n      - uses: actions/checkout@v7\\n        # Rules on main admit pushes only from the release deploy key (issue\\n        # #111). The key is a secret of the `release` environment, which only\\n        # main can use. Without it the version push is declined; see\\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\\n        with:\\n          persist-credentials: true\\n          fetch-depth: 0\\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update\\n          rustup default stable\\n\\n      - name: Install rust-script\\n        run: bash rust/scripts/install-rust-script.sh\\n\\n      - name: Configure git\\n        run: rust-script rust/scripts/git-config.rs\\n\\n      - name: Determine bump type from changelog fragments\\n        id: bump_type\\n        env:\\n          RUST_ROOT: rust\\n        run: rust-script rust/scripts/get-bump-type.rs\\n\\n      - name: Check if version already released or no fragments\\n        id: check\\n        env:\\n          HAS_FRAGMENTS: ${{ steps.bump_type.outputs.has_fragments }}\\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\\n          RUST_ROOT: rust\\n        run: |\\n          rust-script rust/scripts/check-release-needed.rs \\\\\\n            --tag-prefix rust-v \\\\\\n            --repository \\\"$GITHUB_REPOSITORY\\\"\\n\\n      - name: Collect changelog and bump version\\n        id: version\\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.skip_bump != 'true'\\n        working-directory: .\\n        env:\\n          BUMP_TYPE: ${{ steps.bump_type.outputs.bump_type }}\\n        run: |\\n          rust-script rust/scripts/version-and-commit.rs \\\\\\n            --rust-root rust \\\\\\n            --tag-prefix rust-v \\\\\\n            --bump-type \\\"$BUMP_TYPE\\\"\\n\\n      - name: Get current version\\n        id: current_version\\n        if: steps.check.outputs.should_release == 'true'\\n        env:\\n          RUST_ROOT: rust\\n        run: rust-script rust/scripts/get-version.rs\\n\\n      - name: Build release\\n        if: steps.check.outputs.should_release == 'true'\\n        run: cargo build --manifest-path rust/Cargo.toml --release\\n\\n      # Trusted publishing runs only once it is configured on crates.io and\\n      # the CRATES_IO_TRUSTED_PUBLISHING repository variable is 'true'.\\n      # Attempting it unconditionally with continue-on-error left a red\\n      # \\\"No Trusted Publishing config found\\\" annotation on every green\\n      # release (issue #134). Without the variable the publish step uses the\\n      # CARGO_REGISTRY_TOKEN/CARGO_TOKEN secret and fails when it is missing.\\n      - name: Authenticate with crates.io (trusted publishing)\\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\\n        id: prm_auth\\n        if: vars.CRATES_IO_TRUSTED_PUBLISHING == 'true' && (steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true')\\n\\n      - name: Publish to Crates.io\\n        id: publish_crate\\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true'\\n        env:\\n          CARGO_REGISTRY_TOKEN: ${{… }}\\n          RUST_ROOT: rust\\n        run: rust-script rust/scripts/publish-crate.rs\\n\\n      - name: Wait for Crate availability on Crates.io\\n        if: steps.check.outputs.should_release == 'true'\\n        env:\\n          RUST_ROOT: rust\\n          RELEASE_VERSION: ${{ steps.current_version.outputs.version }}\\n        run: rust-script rust/scripts/wait-for-crate.rs --release-version \\\"$RELEASE_VERSION\\\"\\n\\n      - name: Create GitHub Release\\n        if: steps.check.outputs.should_release == 'true'\\n        env:\\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\\n          NEW_VERSION: ${{ steps.version.outputs.new_version }}\\n          CURRENT_VERSION: ${{ steps.current_version.outputs.version }}\\n        run: |\\n          RELEASE_VERSION=\\\"${NEW_VERSION:-$CURRENT_VERSION}\\\"\\n\\n          rust-script rust/scripts/create-github-release.rs \\\\\\n            --rust-root rust \\\\\\n            --release-version \\\"$RELEASE_VERSION\\\" \\\\\\n            --repository \\\"$GITHUB_REPOSITORY\\\" \\\\\\n            --tag-prefix \\\"rust-v\\\" \\\\\\n            --language \\\"Rust\\\"\\n\\n  # === MANUAL RELEASE ===\\n  manual-release:\\n    name: Manual Release\\n    needs: [release-preflight, javascript, lint, test, build]\\n    if: ${{ !cancelled() && needs.release-preflight.result == 'success' && needs.javascript.result == 'success' && github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant' && needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 60\\n    # Writer group: never cancel a release that may already have published a\\n    # crate or pushed a version commit.\\n    concurrency:\\n      group: main-writer-${{ github.repository }}\\n      cancel-in-progress: false\\n      queue: max\\n    permissions:\\n      id-token: write\\n      contents: write\\n    environment: release\\n    steps:\\n      - uses: actions/checkout@v7\\n        # Rules on main admit pushes only from the release deploy key (issue\\n        # #111). The key is a secret of the `release` environment, which only\\n        # main can use. Without it the version push is declined; see\\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\\n        with:\\n          persist-credentials: true\\n          fetch-depth: 0\\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update\\n          rustup default stable\\n\\n      - name: Install rust-script\\n        run: bash rust/scripts/install-rust-script.sh\\n\\n      - name: Configure git\\n        run: rust-script rust/scripts/git-config.rs\\n\\n      - name: Version and commit\\n        id: version\\n        env:\\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\\n          DESCRIPTION: ${{ github.event.inputs.description }}\\n        run: |\\n          rust-script rust/scripts/version-and-commit.rs \\\\\\n            --rust-root rust \\\\\\n            --tag-prefix rust-v \\\\\\n            --bump-type \\\"$BUMP_TYPE\\\" \\\\\\n            --description \\\"$DESCRIPTION\\\"\\n\\n      - name: Build release\\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\\n        run: cargo build --manifest-path rust/Cargo.toml --release\\n\\n      # Trusted publishing runs only once it is configured on crates.io and\\n      # the CRATES_IO_TRUSTED_PUBLISHING repository variable is 'true'.\\n      # Attempting it unconditionally with continue-on-error left a red\\n      # \\\"No Trusted Publishing config found\\\" annotation on every green\\n      # release (issue #134). Without the variable the publish step uses the\\n      # CARGO_REGISTRY_TOKEN/CARGO_TOKEN secret and fails when it is missing.\\n      - name: Authenticate with crates.io (trusted publishing)\\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\\n        id: prm_auth\\n        if: vars.CRATES_IO_TRUSTED_PUBLISHING == 'true' && (steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true')\\n\\n      - name: Publish to Crates.io\\n        id: publish_crate\\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\\n        env:\\n          CARGO_REGISTRY_TOKEN: ${{… }}\\n          RUST_ROOT: rust\\n        run: rust-script rust/scripts/publish-crate.rs\\n\\n      - name: Wait for Crate availability on Crates.io\\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\\n        env:\\n          RUST_ROOT: rust\\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\\n        run: rust-script rust/scripts/wait-for-crate.rs --release-version \\\"$RELEASE_VERSION\\\"\\n\\n      - name: Create GitHub Release\\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\\n        env:\\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\\n        run: |\\n          rust-script rust/scripts/create-github-release.rs \\\\\\n            --rust-root rust \\\\\\n            --release-version \\\"$RELEASE_VERSION\\\" \\\\\\n            --repository \\\"$GITHUB_REPOSITORY\\\" \\\\\\n            --tag-prefix \\\"rust-v\\\" \\\\\\n            --language \\\"Rust\\\"\\n\\n  # === MANUAL CHANGELOG PR ===\\n  # Mirrors the C# 'changeset-pr' mode and the Rust pipeline template: instead of\\n  # releasing straight away, open a pull request carrying the changelog fragment\\n  # so the release goes through the normal review path (issue #96).\\n  changelog-pr:\\n    name: Create Changelog PR\\n    needs: [javascript]\\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr'\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 15\\n    # Writer group: never cancel a run that may already have pushed a branch.\\n    concurrency:\\n      group: main-writer-${{ github.repository }}\\n      cancel-in-progress: false\\n      queue: max\\n    permissions:\\n      contents: write\\n      pull-requests: write\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: true\\n          fetch-depth: 0\\n\\n      - name: Setup Rust\\n        shell: bash\\n        run: |\\n          rustup toolchain install stable --profile minimal --no-self-update\\n          rustup default stable\\n\\n      - name: Install rust-script\\n        run: bash rust/scripts/install-rust-script.sh\\n\\n      - name: Create changelog fragment\\n        env:\\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\\n          DESCRIPTION: ${{ github.event.inputs.description }}\\n        run: |\\n          rust-script rust/scripts/create-changelog-fragment.rs \\\\\\n            --rust-root rust \\\\\\n            --bump-type \\\"$BUMP_TYPE\\\" \\\\\\n            --description \\\"$DESCRIPTION\\\"\\n\\n      - name: Create Pull Request\\n        uses: peter-evans/create-pull-request@v8\\n        with:\\n          token: ${{ secrets.GITHUB_TOKEN }}\\n          commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'\\n          branch: changelog-manual-release-${{ github.run_id }}\\n          delete-branch: true\\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\\n          body: |\\n            ## Manual Release Request\\n\\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\\n\\n            ### Release Details\\n            - **Type:** ${{ github.event.inputs.bump_type }}\\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\\n            - **Triggered by:** @${{ github.actor }}\\n\\n            ### Next Steps\\n            1. Review the changelog fragment in this PR\\n            2. Merge this PR to main\\n            3. The automated release workflow will publish to crates.io and create a GitHub release\\n\\n  pipeline-status:\\n    name: Pipeline Status (rust)\\n    needs:\\n      - javascript\\n      - release-preflight\\n      - verify-trusted-publishing\\n      - detect-changes\\n      - changelog\\n      - lint\\n      - coverage\\n      - test\\n      - fresh-merge\\n      - build\\n      - auto-release\\n      - manual-release\\n      - changelog-pr\\n    if: ${{ !cancelled() }}\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    concurrency:\\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-pipeline-status\\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\\n    steps:\\n      - uses: actions/checkout@v7\\n        with:\\n          persist-credentials: false\\n      - uses: actions/setup-node@v7\\n        with:\\n          node-version: '26.x'\\n      - name: Check every prerequisite\\n        working-directory: .\\n        env:\\n          NEEDS_JSON: ${{ toJSON(needs) }}\\n        run: node .github/scripts/pipeline-status.mjs\\n\"\nDEBUG audit:audit{ident=\"superfluous-actions\" input=Workflow(file://.github/workflows/rust.yml)}: subfeature: attempting to locate Subfeature { after: 0, fragment: Raw(\"peter-evans/create-pull-request@v8\") } within \"peter-evans/create-pull-request@v8\"\nDEBUG audit:audit{ident=\"adhoc-packages\" input=Workflow(file://.github/workflows/rust.yml)}: zizmor::audit::adhoc_packages: adhoc-packages: couldn't determine shell for step SymbolicLocation {\n    key: Local(\n        LocalKey {\n            group: GroupID(\n                \".github/workflows\",\n            ),\n            prefix: Some(\n                \".github/workflows\",\n            ),\n            verbatim_path: \".github/workflows/rust.yml\",\n            native_path: \".github/workflows/rust.yml\",\n            root_relative_path: Some(\n                \".github/workflows/rust.yml\",\n            ),\n        },\n    ),\n    annotation: \"this step\",\n    link: None,\n    route: Route {\n        route: [\n            Key(\n                \"jobs\",\n            ),\n            Key(\n                \"test\",\n            ),\n            Key(\n                \"steps\",\n            ),\n            Index(\n                4,\n            ),\n