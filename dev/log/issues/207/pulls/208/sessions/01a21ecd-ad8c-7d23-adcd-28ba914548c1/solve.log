    verbose ? 'debug' : 'warn',\n      ],\n      { env: { ...process.env, GOMEMLIMIT: '100MiB' }, stdio: ['ignore', 'pipe', 'pipe'] },\n    );\n    child.stdout.pipe(log);\n    child.stderr.pipe(log);\n    nodes.push({ child, exited: once(child, 'exit'), log });\n  }\n  const options = { prefix: '/issue138/', timeoutMs: 700 };\n  await waitForMembers(endpoints);\n  await verifyAddressAllocation(endpoints, binding);\n  await verifyAuthorFence(endpoints, binding);\n  const store = new EtcdJournalStore(endpoints, options);\n  await ready(() => store.read(['a']));\n  const engine = new ClusterEngine(binding, store, {\n    requireDurableFlush: true,\n    ...checkpointOptions,\n  });\n  const seed = await engine.begin(['a', 'b']);\n  await seed.shard('a').create(0, 0);\n  await seed.shard('b').create(0, 0);\n  await seed.commit();\n  if (checkpoint)\n    for (const value of await store.read(['a', 'b'])) {\n      assert.equal(value.entries.length, 1);\n      assert.ok(value.entries[0].startsWith('engine3|'));\n    }\n  const stale = await engine.begin(['a', 'b']);\n  const other = new ClusterEngine(\n    binding,\n    new EtcdJournalStore(endpoints, options),\n    checkpointOptions,\n  );\n","exit_code":0,"status":"completed"}}
