t = net.connect({ host, port });\n    await new Promise((resolve, reject) => {\n      const stop = watchScope(scope, (errorOf) => {\n        socket.destroy();\n        reject(errorOf('not-sent'));\n      });\n      socket.once('connect', () => {\n        stop();\n        resolve();\n      });\n      socket.once('error', (error) => {\n        stop();\n        reject(\n          new ConnectionClosedError(`cannot connect to ${host}:${port}: ${error.message}`, {\n            outcome: 'not-sent',\n            cause: error,\n          }),\n        );\n      });\n    });\n    socket.setNoDelay(true);\n    return new TcpTransport(socket, { ...options, owned: true });\n  }\n\n  /** Sends one request (LiNo text) and resolves to the reply text. */\n      for (const resolve of this.#idleWaiters.splice(0)) resolve();\n    }\n  }\n\n  get closed() {\n    return this.#closedError !== null;\n  }\n\n  /**\n   * Waits for the requests already made, then closes the connection if this\n   * transport opened it. A socket handed in with `owned: false` is left open\n   * (its listeners removed) for its owner to close.\n   */\n  async close() {\n    if (this.#queue.length > 0 || this.#inFlight.length > 0) {\n      await new Promise((resolve) => this.#idleWaiters.push(resolve));\n    }\n    if (this.#closedError) {\n      if (this.#owned) await this.#closed;\n      return;\n    }\n    this.#closedError = new ConnectionClosedError('the client closed the connection', {\n      outcome: 'not-sent',\n    });\n    this.#endPushWaiters();\n    this.#detach();\n    if (!this.#owned) return;\n    this.#socket.end();\n    const timer = setTimeout(() => this.#socket.destroy(), 1000);\n    await this.#closed;\n    clearTimeout(timer);\n  }\n\n  /** Closes the connection now, failing whatever is in flight. */\n  destroy() {\n    this.#fail(new ConnectionClosedError('the client destroyed the connection'));\n  }\n}\n    return endpoint;\n  }\n  const host = endpoint.host ?? '127.0.0.1';\n  return `tcp:${net.isIPv6(host) ? `[${host}]` : host}:${Number(endpoint.port)}`;\n}\n\n/**\n * The links protocol over an IPC stream: a {@link TcpTransport} (pipelining,\n * pushes, limits) whose capabilities name the endpoint kind.\n */\nexport class IpcTransport extends TcpTransport {\n  #stream;\n  #onEnd;\n\n  /** Wraps a connected duplex stream; `owned: false` leaves it open on close. */\n  constructor(stream, options = {}) {\n    const { kind = 'ipc', endpoint, owned = true } = options;\n    super(stream, {\n      ...options,\n      capabilities: { transport: kind, rawTcp: kind === 'tcp', ...options.capabilities },\n    });\n    this.kind = kind;\n    this.endpoint = endpoint;\n    this.#stream = stream;\n    // The streams allow half-open connections: the server ending its side\n    // ends this one too (or, for a stream left open, just this transport).\n    this.#onEnd = () => {\n      if (owned) stream.end();\n      else this.onClose();\n    };\n    stream.on('end', this.#onEnd);\n  }\n\n  /**\n   * Connects to `endpoint` (also a TCP `{ host, port }`), honouring `signal`,\n   * `deadline` and `timeout`.\n   */\n  static async connect(endpoint, options = {}) {\n    const parsed = parseEndpoint(fromAddress(endpoint));\n    let stream;\n    try {\n      stream = await connectStream(parsed, options);\n    } catch (error) {\n      if (error instanceof LinksError) throw error;\n      throw new ConnectionClosedError(`cannot connect to ${parsed}: ${error.message}`, {\n        outcome: 'not-sent',\n        cause: error,\n      });\n    }\n    return new IpcTransport(stream, {\n      ...options,\n      owned: true,\n      kind: parsed.kind,\n      endpoint: parsed.toString(),\n    });\n  }\n\n  async close() {\n    try {\n      await super.close();\n    } finally {\n      this.#stream.off('end', this.#onEnd);\n    }\n  }\n\n  destroy() {\n    this.#stream.off('end', this.#onEnd);\n    super.destroy();\n  }\n\nThe Node.js client connects natively to `tcp`, `udp`, `unix` (POSIX), `pip