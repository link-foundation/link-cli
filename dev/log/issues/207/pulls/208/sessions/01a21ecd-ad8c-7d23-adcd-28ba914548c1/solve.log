[2026-11-27T22:24:53.786Z] [STDOUT] {"type":"item.completed","item":{"id":"item_864","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,175p' js/client/test/ipc-ring.test.mjs && sed -n '1,135p' js/client/src/ipc-ring.js && sed -n '380,485p' js/client/src/ipc-ring.js\"","aggregated_output":"// Unit tests of the ring kinds (`file`, `mmap`, `shm`, `signal`) against a JS\n// listener of the rendezvous directory (test/support/ipc-listener.mjs), and of\n// the ring stream's failure paths on in-memory regions. They need no `clink`.\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { test } from 'node:test';\nimport {\n  FileRegion,\n  MemoryRegion,\n  PollNotifier,\n  RING_HEADER,\n  RingStream,\n  SignalNotifier,\n  connectRing,\n  initialize,\n  installSignal,\n  peerSignal,\n  regionSize,\n  ringBase,\n  validate,\n} from '../src/ipc-ring.js';\nimport { connectStream, parseEndpoint } from '../src/ipc.js';\nimport {\n  Listener,\n  collect,\n  deadPid,\n  echo,\n  payload,\n  rejectsWith,\n  sleep,\n  tempDir,\n} from './support/ipc-listener.mjs';\n\nconst LINUX = process.platform === 'linux';\nconst SIGNALS = os.constants.signals;\n\n/** A region that fails every access once `fail` is set. */\nclass FailingRegion extends MemoryRegion {\n  fail = false;\n\n  read(offset, length) {\n    if (this.fail) throw new Error('region lost');\n    return super.read(offset, length);\n  }\n\n  close() {\n    if (this.fail) throw new Error('region lost');\n  }\n}\n\nconst side = (region, { client = true, peerPid = process.pid } = {}) =>\n  new RingStream({ kind: 'test', region, client, notifier: new PollNotifier(1), peerPid });\n\nconst fresh = (capacity = 64, Region = MemoryRegion) => {\n  const region = new Region(regionSize(capacity));\n  initialize(region, capacity);\n  return region;\n};\n\nconst written = (stream, bytes) =>\n  new Promise((resolve, reject) => {\n    stream.write(bytes, (error) => (error ? reject(error) : resolve()));\n  });\n\nconst ended = (stream) =>\n  new Promise((resolve, reject) => stream.end((error) => (error ? reject(error) : resolve())));\n\nfor (const kind of ['file', 'mmap', 'signal', 'shm']) {\n  test(\n    `${kind}: connects through the rendezvous and echoes`,\n    { skip: kind === 'shm' && !LINUX },\n    async (t) => {\n      const dir = tempDir(t);\n      const listener = new Listener(dir, kind, { onStream: echo });\n      t.after(() => listener.close());\n      const stream = await connectStream(`${kind}:${dir}?capacity=64&poll=1`);\n      assert.equal(stream.kind, kind);\n      assert.equal(stream.capacity, 64);\n      assert.equal(stream.peerPid, process.pid);\n      const sent = payload(5_000);\n      const received = collect(stream);\n      stream.end(sent);\n      assert.deepEqual(await received, sent);\n      stream.destroy();\n      assert.deepEqual(fs.readdirSync(dir), ['listener.json'], 'the region is removed at once');\n    },\n  );\n}\n\ntest('a ring keeps its file until it hangs up on Windows', async (t) => {\n  const dir = tempDir(t);\n  const listener = new Listener(dir, 'file', { onStream: echo });\n  t.after(() => listener.close());\n  const stream = await connectRing(parseEndpoint(`file:${dir}`), {}, 'win32');\n  assert.equal(fs.readdirSync(dir).filter((name) => name.endsWith('.ring')).length, 1);\n  await new Promise((resolve) => stream.destroy().once('close', resolve));\n  assert.deepEqual(fs.readdirSync(dir), ['listener.json']);\n});\n\ntest('a refused ring connection removes its region', async (t) => {\n  const dir = tempDir(t);\n  let answer = () => ({ error: 'no room' });\n  const listener = new Listener(dir, 'signal', { answer: () => answer() });\n  t.after(() => listener.close());\n  await assert.rejects(connectStream(`signal:${dir}`), rejectsWith('ECONNREFUSED', /no room/));\n  answer = () => ({ pid: process.pid });\n  await assert.rejects(connectStream(`signal:${dir}`), rejectsWith('EINVAL', /lacks the number/));\n  assert.deepEqual(fs.readdirSync(dir), ['listener.json']);\n});\n\ntest('a ring region that cannot be sized is removed', async (t) => {\n  const dir = tempDir(t);\n  const listener = new Listener(dir, 'mmap');\n  t.after(() => listener.close());\n  t.mock.method(fs, 'ftruncateSync', () => {\n    throw Object.assign(new Error('disk full'), { code: 'ENOSPC' });\n  });\n  await assert.rejects(connectStream(`mmap:${dir}`), /disk full/);\n  assert.deepEqual(fs.readdirSync(dir), ['listener.json']);\n});\n\ntest('ring handshakes check the signal numbers', () => {\n  assert.equal(peerSignal({ signal: 10 }), 10);\n  assert.throws(() => peerSignal({}), rejectsWith('EINVAL', /lacks/));\n  for (const signal of [0, 65]) {\n    assert.throws(() => peerSignal({ signal }), rejectsWith('EINVAL', /invalid signal/));\n  }\n  for (const signo of [999, SIGNALS.SIGKILL, SIGNALS.SIGSTOP]) {\n    assert.throws(() => installSignal(signo), rejectsWith('EINVAL', /cannot be caught/));\n  }\n});\n\ntest('the signal ring takes the report signal over', (t) => {\n  const report = process.report;\n  const saved = [report.signal, report.reportOnSignal];\n  t.after(() => {\n    report.signal = saved[0];\n    report.reportOnSignal = saved[1];\n  });\n  report.signal = 'SIGWINCH';\n  report.reportOnSignal = true;\n  installSignal(SIGNALS.SIGWINCH);\n  assert.equal(report.reportOnSignal, false);\n  // Installed once for the life of the process.\n  report.reportOnSignal = true;\n  installSignal(SIGNALS.SIGWINCH);\n  assert.equal(report.reportOnSignal, true);\n});\n\ntest('a signal the process cannot handle is reported', (t) => {\n  t.mock.method(process, 'on', () => {\n    throw new Error('uv_signal_start EINVAL');\n  });\n  assert.throws(() => installSignal(SIGNALS.SIGURG), rejectsWith('EINVAL', /cannot be caught/));\n});\n\ntest('the signal notifier waits for a signal or its limit', async () => {\n  const gone = new SignalNotifier(deadPid(), SIGNALS.SIGWINCH);\n  gone.notify();\n  const own = new SignalNotifier(process.pid, SIGNALS.SIGWINCH);\n  const generation = own.generation();\n  await own.wait(generation, 0, 1000);\n  const started = Date.now();\n  await own.wait(generation, 16, 20);\n  assert.ok(Date.now() - started >= 15);\n  const woken = own.wait(generation, 16, 10_000);\n  own.notify();\n  await woken;\n  assert.notEqual(own.generation(), generation);\n  await own.wait(generation, 16, 10_000);\n});\n\ntest('ring regions are checked before use', (t) => {\n// The two byte rings of `shm`, `mmap`, `file` and `signal` (the \"Ring region\"\n// section of docs/protocol/ipc-transports-v1.md; the reference is\n// rust/src/protocol/ipc/ring.rs). Node.js has no shared mappings, so the\n// region is accessed with positioned reads and writes of the file that backs\n// it; the counter complements make that safe against concurrent stores.\n\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport { Duplex } from 'node:stream';\nimport { brokenPipe, hungUp, IpcError, outgoingClosed } from './ipc-endpoint.js';\nimport { numberField, PeerWatch, Rendezvous } from './ipc-rendezvous.js';\nimport { trace } from './ipc-trace.js';\n\nexport const MAGIC = Buffer.from('LIPC', 'latin1');\nexport const VERSION = 1;\nexport const HEADER = 64;\nexport const RING_HEADER = 128;\nconst HEAD = 0;\nconst WRITER_STATE = 8;\nconst TAIL = 64;\nconst READER_STATE = 72;\nconst OPEN = 0;\nconst ENDED = 1;\nconst ABORTED = 2;\nconst GONE = 2;\nconst PEER_CHECK = 100;\nconst READ_CHUNK = 65536;\n\nexport const regionSize = (capacity) => HEADER + 2 * (RING_HEADER + capacity);\nexport const ringBase = (ring, capacity) => HEADER + ring * (RING_HEADER + capacity);\n\nconst immediate = () => new Promise((resolve) => setImmediate(resolve));\nconst sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));\n\n/** A region of bytes both processes see: any object with `read` and `write` at offsets. */\nexport class FileRegion {\n  constructor(fd, length) {\n    this.fd = fd;\n    this.length = length;\n  }\n\n  read(offset, length) {\n    const buffer = Buffer.alloc(length);\n    let done = 0;\n    while (done < length) {\n      const count = fs.readSync(this.fd, buffer, done, length - done, offset + done);\n      if (count === 0) throw new IpcError('the ring region is too small', 'EINVAL');\n      done += count;\n    }\n    return buffer;\n  }\n\n  write(offset, bytes) {\n    let done = 0;\n    while (done < bytes.length) {\n      done += fs.writeSync(this.fd, bytes, done, bytes.length - done, offset + done);\n    }\n  }\n\n  close() {\n    fs.closeSync(this.fd);\n  }\n}\n\n/** An in-memory region, for tests of the ring itself. */\nexport class MemoryRegion {\n  constructor(length) {\n    this.bytes = Buffer.alloc(length);\n    this.length = length;\n  }\n\n  read(offset, length) {\n    return Buffer.from(this.bytes.subarray(offset, offset + length));\n  }\n\n  write(offset, bytes) {\n    bytes.copy(this.bytes, offset);\n  }\n\n  close() {}\n}\n\nconst load = (region, offset) => region.read(offset, 4).readUInt32LE(0);\n\nconst store = (region, offset, value) => {\n  const bytes = Buffer.alloc(4);\n  bytes.writeUInt32LE(value >>> 0, 0);\n  region.write(offset, bytes);\n};\n\n/** Writes the header of a fresh, zero-filled region. */\nexport function initialize(region, capacity) {\n  region.write(0, MAGIC);\n  store(region, 4, VERSION);\n  store(region, 8, capacity);\n  for (const ring of [0, 1]) {\n    const base = ringBase(ring, capacity);\n    store(region, base + HEAD + 4, 0xffffffff);\n    store(region, base + TAIL + 4, 0xffffffff);\n  }\n}\n\n/** Checks the header and returns the capacity. */\nexport function validate(region) {\n  const fail = (message) => new IpcError(message, 'EINVAL');\n  if (region.length < HEADER) throw fail('the ring region is too small');\n  if (!region.read(0, 4).equals(MAGIC)) throw fail('the ring region lacks the `LIPC` magic');\n  if (load(region, 4) !== VERSION) throw fail('the ring region has another version');\n  const capacity = load(region, 8);\n  if (capacity < 64 || capacity > 1 << 30 || regionSize(capacity) > region.length) {\n    throw fail('the ring region has an invalid capacity');\n  }\n  return capacity;\n}\n\n/** A counter whose complement matches, read again while torn. */\nfunction counter(region, offset) {\n  for (let attempt = 0; attempt <= 1_000_000; attempt += 1) {\n    const bytes = region.read(offset, 8);\n    const value = bytes.readUInt32LE(0);\n    if (value === ~bytes.readUInt32LE(4) >>> 0) return value;\n  }\n  throw new IpcError('a ring counter stays torn', 'EINVAL');\n}\n\n/** Stores a counter: the value first, the complement second. */\nfunction publish(region, offset, value) {\n  store(region, offset, value);\n  store(region, offset + 4, ~value >>> 0);\n}\n\n/** `[head, tail]` of a ring, consistent with each other. */\nfunction positions(region, base, capacity) {\n  for (;;) {\n    const head = counter(region, base + HEAD);\n      callback();\n    } catch (error) {\n      callback(error);\n    }\n  }\n\n  _destroy(error, callback) {\n    if (!this.#released) {\n      this.#released = true;\n      trace(`${this.kind} ring to process ${this.peerPid} hung up`);\n      try {\n        if (load(this.#region, this.#outgoing + WRITER_STATE) === OPEN) {\n          store(this.#region, this.#outgoing + WRITER_STATE, ENDED);\n        }\n        store(this.#region, this.#incoming + READER_STATE, GONE);\n        this.#notifier.notify();\n      } catch {\n        // The region is unusable; the peer's liveness check notices.\n      }\n      try {\n        this.#region.close();\n      } catch {\n        // Already closed.\n      }\n      for (const file of this.#cleanup) fs.rmSync(file, { force: true });\n    }\n    callback(error);\n  }\n}\n\nconst SUFFIX = { mmap: 'mmap', file: 'ring', signal: 'sig' };\n\nfunction createFile(file, size) {\n  const { O_RDWR, O_CREAT, O_EXCL } = fs.constants;\n  const fd = fs.openSync(file, O_RDWR | O_CREAT | O_EXCL, 0o600);\n  try {\n    fs.ftruncateSync(fd, size);\n  } catch (error) {\n    fs.closeSync(fd);\n    fs.rmSync(file, { force: true });\n    throw error;\n  }\n  return fd;\n}\n\n/**\n * Connects to a `shm`, `mmap`, `file` or `signal` listener; `platform`\n * (default: this one) decides when the files are removed.\n */\nexport async function connectRing(endpoint, { signal } = {}, platform = process.platform) {\n  const kind = endpoint.kind;\n  const rendezvous = Rendezvous.begin(endpoint, kind);\n  const capacity = endpoint.number('capacity', 65536, 64, 1 << 30);\n  const size = regionSize(capacity);\n  // `shm` is the POSIX object `/lcID`, which Linux keeps in /dev/shm.\n  const file = kind === 'shm' ? `/dev/shm/lc${rendezvous.id}` : rendezvous.path(SUFFIX[kind]);\n  const region = new FileRegion(createFile(file, size), size);\n  const forget = () => fs.rmSync(file, { force: true });\n  try {\n    initialize(region, capacity);\n    const poll = endpoint.millis('poll', 5);\n    let fields = {};\n    if (kind === 'signal') {\n      const own = endpoint.number('signo', os.constants.signals.SIGUSR2, 1, 64);\n      installSignal(own);\n      fields = { signal: own };\n    }\n    const ack = await rendezvous.request(fields, signal);\n    const peer = rendezvous.peerOf(ack);\n    const notifier =\n      kind === 'signal' ? new SignalNotifier(peer, peerSignal(ack)) : new PollNotifier(poll);\n    // Both sides hold the region open now; nothing should outlive a crash.\n    const windows = platform === 'win32';\n    const cleanup = windows ? [file] : [];\n    if (!windows) forget();\n    const stream = new RingStream({ kind, region, notifier, peerPid: peer, cleanup });\n    trace(`${kind} connected as ${rendezvous.id} to process ${peer}, ${capacity} bytes per ring`);\n    return stream;\n  } catch (error) {\n    region.close();\n    forget();\n    throw error;\n  }\n}\n","exit_code":0,"status":"completed"}}
