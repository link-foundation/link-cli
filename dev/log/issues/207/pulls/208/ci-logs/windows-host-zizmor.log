DEBUG audit:audit{ident="secrets-outside-env" input=Workflow(file://.github/workflows/rust.yml)}: subfeature: attempting to locate Subfeature { after: 3395, fragment: Raw("secrets.CARGO_TOKEN") } within "name: Rust CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n  # No path filter (issue #111): the JavaScript stage and the parity check\n  # must run for every pull request, and \"Pipeline Status (rust)\" is a\n  # required check that a filtered-out run would never report. The\n  # detect-changes job skips the Rust jobs when no Rust input changed\n  # (.github/scripts/stack-paths.mjs).\n  pull_request:\n    types: [opened, synchronize, reopened]\n  workflow_dispatch:\n    inputs:\n      release_mode:\n        description: 'Release mode'\n        required: true\n        type: choice\n        default: 'instant'\n        options:\n          - instant\n          - changelog-pr\n          - verify-trusted-publishing\n      bump_type:\n        description: 'Version bump type'\n        required: true\n        type: choice\n        default: 'patch'\n        options:\n          - patch\n          - minor\n          - major\n      description:\n        description: 'Release description (optional)'\n        required: false\n        type: string\n\n# Read-only concurrency cancels superseded PR synchronizations. Each main\n# revision keeps its results. Release writers share the repository queue.\n\n# Least privilege by default; the publishing jobs opt into more below.\npermissions:\n  contents: read\n\n# The GIT_CONFIG_* entries provide Git config to actions/checkout itself;\n# checkout runs git init before any workflow step can configure Git, which\n# otherwise prints the default-branch hint into every log.\nenv:\n  CARGO_TERM_COLOR: always\n  RUSTFLAGS: -Dwarnings\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # === STAGE GATE (issue #111) ===\n  # Lint, JavaScript unit tests and the parity check. Every job that installs\n  # Rust lists `javascript` in its needs, so nothing Rust starts unless this\n  # stage succeeded for the same commit.\n  javascript:\n    name: javascript\n    if: inputs.release_mode != 'verify-trusted-publishing'\n    uses: ./.github/workflows/javascript-stage.yml\n\n  release-preflight:\n    name: Release authentication preflight\n    if: inputs.release_mode != 'verify-trusted-publishing'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-release-preflight\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Authenticate preflight with crates.io\n        if: vars.CRATES_IO_TRUSTED_PUBLISHING == 'true' && github.event_name != 'pull_request' && inputs.release_mode != 'changelog-pr' && inputs.release_mode != 'changeset-pr'\n        id: preflight_auth\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\n      - name: Prove authentication before version writes or publishing\n        working-directory: .\n        env:\n          RELEASE_MODE: ${{ inputs.release_mode }}\n          CARGO_REGISTRY_TOKEN: ${{… }}\n        run: node .github/scripts/release-preflight.mjs crates\n\n  # Authenticate without a version commit, tag, or package upload. This lets\n  # maintainers verify the registry policy before retiring the token fallback.\n  verify-trusted-publishing:\n    name: Verify crates.io trusted publishing\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'verify-trusted-publishing'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-verify-trusted-publishing\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - name: Authenticate with crates.io (trusted publishing)\n        id: auth\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\n\n      - name: Confirm short-lived credential\n        env:\n          CARGO_REGISTRY_TOKEN: ${{… }}\n        run: |\n          test -n \"$CARGO_REGISTRY_TOKEN\"\n          echo 'crates.io OIDC authentication succeeded; the action revokes its temporary token when this job ends.' >> \"$GITHUB_STEP_SUMMARY\"\n\n  # === DETECT CHANGES - determines which jobs should run ===\n  detect-changes:\n    name: Detect Changes\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-detect-changes\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript]\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      stack-changed: ${{ steps.stack.outputs.stack-changed }}\n      rs-changed: ${{ steps.changes.outputs.rs-changed }}\n      toml-changed: ${{ steps.changes.outputs.toml-changed }}\n      mjs-changed: ${{ steps.changes.outputs.mjs-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n      rust-code-changed: ${{ steps.changes.outputs.rust-code-changed }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: rust-script rust/scripts/detect-code-changes.rs\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      # Replaces the removed pull_request path filter: on a pull request\n      # that changes no Rust input, lint (and with it test, build and\n      # fresh-merge), coverage and the changelog check are skipped.\n      - name: Detect whether the Rust stack changed\n        id: stack\n        env:\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          STACK_PATHS_DEBUG: ${{ runner.debug }}\n        run: node .github/scripts/stack-paths.mjs rust\n\n  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n  changelog:\n    name: Changelog Fragment Check\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-changelog\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.stack-changed == 'true' && needs.detect-changes.outputs.rust-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Check for changelog fragments\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          RUST_ROOT: rust\n        run: rust-script rust/scripts/check-changelog-fragment.rs\n\n  # === LINT AND FORMAT CHECK ===\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-lint\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: |\n      !cancelled() && needs.javascript.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (\n        github.event_name != 'pull_request' || needs.detect-changes.outputs.stack-changed == 'true'\n      ) && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.rs-changed == 'true' ||\n        needs.detect-changes.outputs.toml-changed == 'true' ||\n        needs.detect-changes.outputs.mjs-changed == 'true' ||\n        needs.detect-changes.outputs.docs-changed == 'true' ||\n        needs.detect-changes.outputs.workflow-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update --component rustfmt,clippy\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Restore cargo cache\n        id: cargo-cache\n        uses: actions/cache/restore@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ runner.os }}-cargo-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-\n\n      - name: Check formatting\n        run: |\n          cargo fmt --manifest-path rust/Cargo.toml --all -- --check\n          cargo fmt --manifest-path rust/wasm/Cargo.toml --all -- --check\n\n      # `-D warnings` is what makes this a gate: without it clippy prints its\n      # findings and still exits 0, so lint warnings accumulated invisibly\n      # (issue #96). The wasm crate is a separate workspace and was not linted\n      # at all until now.\n      - name: Run Clippy\n        run: |\n          cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings\n          cargo clippy --manifest-path rust/wasm/Cargo.toml --all-targets --all-features -- -D warnings\n\n      - name: Check file size limit\n        run: rust-script rust/scripts/check-file-size.rs\n\n      # The release scripts commit and push straight to main, where no\n      # workflow re-checks their output; their own test suites are the gate\n      # (issue #134: a silently failing `git add` released 1.0.6-1.0.8\n      # without ever committing the version bump).\n      - name: Compile release scripts (non-test, warnings denied)\n        run: bash rust/scripts/check-scripts.sh\n\n      - name: Test release scripts\n        run: bash rust/scripts/test-scripts.sh\n\n      # A dependency bump in Cargo.toml without the matching Cargo.lock update\n      # otherwise passes CI while every job silently re-resolves the graph\n      # (issue #96). --locked turns that drift into a failure.\n      - name: Deny Cargo manifest warnings\n        run: |\n          bash .github/scripts/check-cargo-warnings.sh --manifest-path rust/Cargo.toml\n          bash .github/scripts/check-cargo-warnings.sh --manifest-path rust/wasm/Cargo.toml\n\n      - name: Verify Cargo.lock is up to date\n        run: |\n          cargo metadata --locked --format-version 1 --manifest-path rust/Cargo.toml > /dev/null\n          cargo metadata --locked --format-version 1 --manifest-path rust/wasm/Cargo.toml > /dev/null\n\n      # The workflow policy tests (issue #96) moved to the JavaScript stage,\n      # which runs them through `npm run test:js` before this job starts.\n\n      # Pull request caches are scoped to their merge ref, so only main\n      # saves; every branch restores main's cache (issue #172).\n      - name: Save cargo cache\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\n        uses: actions/cache/save@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\n\n  # === TEST ===\n  test:\n    name: Test (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 45\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-test-${{ matrix.os }}\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes, changelog, lint]\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch' || needs.changelog.result == 'success' || needs.changelog.result == 'skipped') }}\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-26, windows-2025]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Restore cargo cache\n        id: cargo-cache\n        uses: actions/cache/restore@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          # Its own key: sharing the lint job's key let lint's clippy-only\n          # cache win the save race, so tests restored almost nothing.\n          key: ${{ runner.os }}-cargo-test-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-test-\n\n      - name: Setup Node.js for dependency boundary checks\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Verify SQLite is optional\n        run: node .github/scripts/check-sqlite-optional.mjs rust\n\n      # Compile everything first and save the cache before the long test\n      # run, so saving (3-5 minutes for ~3 GB on Windows) can never be what\n      # pushes a job whose tests passed past timeout-minutes (issue #172).\n      - name: Build test binaries\n        shell: bash\n        run: |\n          cargo test --manifest-path rust/Cargo.toml --no-default-features --test doublets_storage_tests --test engine_journal_tests --no-run\n          cargo test --manifest-path rust/Cargo.toml --all-features --no-run\n          cargo build --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm\n\n      # Pull request caches are scoped to their merge ref, so only main\n      # saves; every branch restores main's cache (issue #172).\n      - name: Save cargo cache\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\n        uses: actions/cache/save@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\n\n      - name: Test native stores without optional providers\n        run: cargo test --manifest-path rust/Cargo.toml --no-default-features --test doublets_storage_tests --test engine_journal_tests\n\n      # golden_fixtures_tests writes the receipt that the next step checks,\n      # so a filtered or skipped golden fixture test fails CI (issue #111).\n      - name: Run tests\n        env:\n          GOLDEN_FIXTURES_RECEIPT: ${{ runner.temp }}/golden-rust.json\n        run: cargo test --manifest-path rust/Cargo.toml --all-features --verbose\n\n      - name: Check that the Rust suite loaded every golden fixture\n        shell: bash\n        env:\n          RECEIPT: ${{ runner.temp }}/golden-rust.json\n        run: node parity/check-parity.mjs --receipt rust \"$RECEIPT\"\n\n      - name: Run doc tests\n        run: cargo test --manifest-path rust/Cargo.toml --doc --verbose\n\n      - name: Native LSM cluster consumers without SQL or a coordinator\n        shell: bash\n        run: |\n          cargo build --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster direct\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster partitioned\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster chunks\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster reclaiming\n          cargo run --manifest-path rust/Cargo.toml --no-default-features --features native-pages,physical-lsm --example native_lsm -- cluster reclaiming-chunks\n\n  # === COVERAGE MEASUREMENT ===\n  coverage:\n    name: Rust coverage\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-coverage\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.stack-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust coverage tools\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update --component llvm-tools-preview\n          rustup default stable\n          cargo install cargo-llvm-cov --version 0.9.2 --locked\n\n      - name: Measure Rust test coverage\n        # Branch instrumentation is experimental. Limit the unstable compiler\n        # option to this measurement; normal builds still use stable Rust.\n        env:\n          RUSTC_BOOTSTRAP: '1'\n          # Crash tests kill child processes on purpose. A kill during the\n          # child's exit leaves a truncated profile, which only loses that\n          # child's counters, so it must not discard every other profile.\n          LLVM_PROFDATA_FLAGS: --failure-mode=all\n        run: |\n          cargo llvm-cov --manifest-path rust/Cargo.toml --all-features --branch --lcov --output-path rust/coverage.lcov\n          cargo llvm-cov report --manifest-path rust/Cargo.toml --branch --json --summary-only --output-path rust/coverage-summary.json\n\n      - name: Check author guard coverage\n        run: python3 experiments/issue-138/check-author-fence-rust-coverage.py rust/coverage-summary.json\n\n      - name: Preserve coverage report\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: rust-coverage\n          path: |\n            rust/coverage.lcov\n            rust/coverage-summary.json\n          if-no-files-found: error\n\n  # === SEMANTIC MERGE CONFLICT CHECK ===\n  # Every other job tests the pull request head. A pull request can be green in\n  # isolation and still break `main`: two changes that merge without a textual\n  # conflict can still contradict each other semantically, and the breakage only\n  # appears after the merge lands (issue #96). This job merges the head into the\n  # current tip of the base branch and re-runs the fast checks on that tree.\n  # Ported from the Rust pipeline template's \"Simulate fresh merge\" step.\n  fresh-merge:\n    name: Simulate Fresh Merge\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-fresh-merge\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    if: github.event_name == 'pull_request'\n    needs: [javascript, detect-changes, lint]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update --component rustfmt,clippy\n          rustup default stable\n\n      - name: Restore cargo cache\n        id: cargo-cache\n        uses: actions/cache/restore@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ runner.os }}-cargo-fresh-merge-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-fresh-merge-\n\n      - name: Simulate fresh merge with base branch\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          FRESH_MERGE_CHECKS: |\n            cargo fmt --manifest-path rust/Cargo.toml --all -- --check\n            cargo clippy --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings\n            cargo test --manifest-path rust/Cargo.toml --all-features\n        run: bash .github/scripts/simulate-fresh-merge.sh\n\n      # Pull request caches are scoped to their merge ref, so only main\n      # saves; every branch restores main's cache (issue #172).\n      - name: Save cargo cache\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\n        uses: actions/cache/save@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\n\n  # === BUILD ===\n  build:\n    name: Build Package\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-build\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, lint, test]\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && needs.test.result == 'success' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Restore cargo cache\n        id: cargo-cache\n        uses: actions/cache/restore@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ runner.os }}-cargo-build-${{ hashFiles('rust/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-build-\n\n      - name: Build release\n        run: cargo build --manifest-path rust/Cargo.toml --release --verbose\n\n      # Write N+100 of `clink --transactions` must not be much slower than\n      # write N on a constant-size store (issue #195).\n      - name: Benchmark transactional writes\n        run: node .github/scripts/transactions-benchmark.mjs -- rust/target/release/clink\n\n      - name: Check package\n        run: cargo package --manifest-path rust/Cargo.toml --list --allow-dirty\n\n      # Pull request caches are scoped to their merge ref, so only main\n      # saves; every branch restores main's cache (issue #172).\n      - name: Save cargo cache\n        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && steps.cargo-cache.outputs.cache-hit != 'true' }}\n        uses: actions/cache/save@v6\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            rust/target\n          key: ${{ steps.cargo-cache.outputs.cache-primary-key }}\n\n  # === AUTO RELEASE ===\n  auto-release:\n    name: Auto Release\n    needs: [release-preflight, javascript, lint, test, build]\n    if: ${{ !cancelled() && needs.release-preflight.result == 'success' && needs.javascript.result == 'success' && github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 60\n    # Writer group: never cancel a release that may already have published a\n    # crate or pushed a version commit.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      id-token: write\n      contents: write\n    environment: release\n    steps:\n      - uses: actions/checkout@v7\n        # Rules on main admit pushes only from the release deploy key (issue\n        # #111). The key is a secret of the `release` environment, which only\n        # main can use. Without it the version push is declined; see\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Configure git\n        run: rust-script rust/scripts/git-config.rs\n\n      - name: Determine bump type from changelog fragments\n        id: bump_type\n        env:\n          RUST_ROOT: rust\n        run: rust-script rust/scripts/get-bump-type.rs\n\n      - name: Check if version already released or no fragments\n        id: check\n        env:\n          HAS_FRAGMENTS: ${{ steps.bump_type.outputs.has_fragments }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RUST_ROOT: rust\n        run: |\n          rust-script rust/scripts/check-release-needed.rs \\\n            --tag-prefix rust-v \\\n            --repository \"$GITHUB_REPOSITORY\"\n\n      - name: Collect changelog and bump version\n        id: version\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.skip_bump != 'true'\n        working-directory: .\n        env:\n          BUMP_TYPE: ${{ steps.bump_type.outputs.bump_type }}\n        run: |\n          rust-script rust/scripts/version-and-commit.rs \\\n            --rust-root rust \\\n            --tag-prefix rust-v \\\n            --bump-type \"$BUMP_TYPE\"\n\n      - name: Get current version\n        id: current_version\n        if: steps.check.outputs.should_release == 'true'\n        env:\n          RUST_ROOT: rust\n        run: rust-script rust/scripts/get-version.rs\n\n      - name: Build release\n        if: steps.check.outputs.should_release == 'true'\n        run: cargo build --manifest-path rust/Cargo.toml --release\n\n      # Trusted publishing runs only once it is configured on crates.io and\n      # the CRATES_IO_TRUSTED_PUBLISHING repository variable is 'true'.\n      # Attempting it unconditionally with continue-on-error left a red\n      # \"No Trusted Publishing config found\" annotation on every green\n      # release (issue #134). Without the variable the publish step uses the\n      # CARGO_REGISTRY_TOKEN/CARGO_TOKEN secret and fails when it is missing.\n      - name: Authenticate with crates.io (trusted publishing)\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\n        id: prm_auth\n        if: vars.CRATES_IO_TRUSTED_PUBLISHING == 'true' && (steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true')\n\n      - name: Publish to Crates.io\n        id: publish_crate\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true'\n        env:\n          CARGO_REGISTRY_TOKEN: ${{… }}\n          RUST_ROOT: rust\n        run: rust-script rust/scripts/publish-crate.rs\n\n      - name: Wait for Crate availability on Crates.io\n        if: steps.check.outputs.should_release == 'true'\n        env:\n          RUST_ROOT: rust\n          RELEASE_VERSION: ${{ steps.current_version.outputs.version }}\n        run: rust-script rust/scripts/wait-for-crate.rs --release-version \"$RELEASE_VERSION\"\n\n      - name: Create GitHub Release\n        if: steps.check.outputs.should_release == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          NEW_VERSION: ${{ steps.version.outputs.new_version }}\n          CURRENT_VERSION: ${{ steps.current_version.outputs.version }}\n        run: |\n          RELEASE_VERSION=\"${NEW_VERSION:-$CURRENT_VERSION}\"\n\n          rust-script rust/scripts/create-github-release.rs \\\n            --rust-root rust \\\n            --release-version \"$RELEASE_VERSION\" \\\n            --repository \"$GITHUB_REPOSITORY\" \\\n            --tag-prefix \"rust-v\" \\\n            --language \"Rust\"\n\n  # === MANUAL RELEASE ===\n  manual-release:\n    name: Manual Release\n    needs: [release-preflight, javascript, lint, test, build]\n    if: ${{ !cancelled() && needs.release-preflight.result == 'success' && needs.javascript.result == 'success' && github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant' && needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 60\n    # Writer group: never cancel a release that may already have published a\n    # crate or pushed a version commit.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      id-token: write\n      contents: write\n    environment: release\n    steps:\n      - uses: actions/checkout@v7\n        # Rules on main admit pushes only from the release deploy key (issue\n        # #111). The key is a secret of the `release` environment, which only\n        # main can use. Without it the version push is declined; see\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Configure git\n        run: rust-script rust/scripts/git-config.rs\n\n      - name: Version and commit\n        id: version\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n        run: |\n          rust-script rust/scripts/version-and-commit.rs \\\n            --rust-root rust \\\n            --tag-prefix rust-v \\\n            --bump-type \"$BUMP_TYPE\" \\\n            --description \"$DESCRIPTION\"\n\n      - name: Build release\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        run: cargo build --manifest-path rust/Cargo.toml --release\n\n      # Trusted publishing runs only once it is configured on crates.io and\n      # the CRATES_IO_TRUSTED_PUBLISHING repository variable is 'true'.\n      # Attempting it unconditionally with continue-on-error left a red\n      # \"No Trusted Publishing config found\" annotation on every green\n      # release (issue #134). Without the variable the publish step uses the\n      # CARGO_REGISTRY_TOKEN/CARGO_TOKEN secret and fails when it is missing.\n      - name: Authenticate with crates.io (trusted publishing)\n        uses: rust-lang/crates-io-auth-action@3268eb413133e2960fa4ae0e963ca76380c54cd9 # v1.0.6\n        id: prm_auth\n        if: vars.CRATES_IO_TRUSTED_PUBLISHING == 'true' && (steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true')\n\n      - name: Publish to Crates.io\n        id: publish_crate\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        env:\n          CARGO_REGISTRY_TOKEN: ${{… }}\n          RUST_ROOT: rust\n        run: rust-script rust/scripts/publish-crate.rs\n\n      - name: Wait for Crate availability on Crates.io\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        env:\n          RUST_ROOT: rust\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\n        run: rust-script rust/scripts/wait-for-crate.rs --release-version \"$RELEASE_VERSION\"\n\n      - name: Create GitHub Release\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\n        run: |\n          rust-script rust/scripts/create-github-release.rs \\\n            --rust-root rust \\\n            --release-version \"$RELEASE_VERSION\" \\\n            --repository \"$GITHUB_REPOSITORY\" \\\n            --tag-prefix \"rust-v\" \\\n            --language \"Rust\"\n\n  # === MANUAL CHANGELOG PR ===\n  # Mirrors the C# 'changeset-pr' mode and the Rust pipeline template: instead of\n  # releasing straight away, open a pull request carrying the changelog fragment\n  # so the release goes through the normal review path (issue #96).\n  changelog-pr:\n    name: Create Changelog PR\n    needs: [javascript]\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    # Writer group: never cancel a run that may already have pushed a branch.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: write\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n\n      - name: Setup Rust\n        shell: bash\n        run: |\n          rustup toolchain install stable --profile minimal --no-self-update\n          rustup default stable\n\n      - name: Install rust-script\n        run: bash rust/scripts/install-rust-script.sh\n\n      - name: Create changelog fragment\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n        run: |\n          rust-script rust/scripts/create-changelog-fragment.rs \\\n            --rust-root rust \\\n            --bump-type \"$BUMP_TYPE\" \\\n            --description \"$DESCRIPTION\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@v8\n        with:\n          token: ${{ secrets.GITHUB_TOKEN }}\n          commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'\n          branch: changelog-manual-release-${{ github.run_id }}\n          delete-branch: true\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n          body: |\n            ## Manual Release Request\n\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n\n            ### Release Details\n            - **Type:** ${{ github.event.inputs.bump_type }}\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n            - **Triggered by:** @${{ github.actor }}\n\n            ### Next Steps\n            1. Review the changelog fragment in this PR\n            2. Merge this PR to main\n            3. The automated release workflow will publish to crates.io and create a GitHub release\n\n  pipeline-status:\n    name: Pipeline Status (rust)\n    needs:\n      - javascript\n      - release-preflight\n      - verify-trusted-publishing\n      - detect-changes\n      - changelog\n      - lint\n      - coverage\n      - test\n      - fresh-merge\n      - build\n      - auto-release\n      - manual-release\n      - changelog-pr\n    if: ${{ !cancelled() }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-pipeline-status\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Check every prerequisite\n        working-directory: .\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n        run: node .github/scripts/pipeline-status.mjs\n"
