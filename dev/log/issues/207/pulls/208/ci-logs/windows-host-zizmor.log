DEBUG audit:audit{ident="secrets-outside-env" input=Workflow(file://.github/workflows/csharp.yml)}: subfeature: attempting to locate Subfeature { after: 3814, fragment: Raw("secrets.NUGET_API_KEY") } within "name: C# CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n  # No path filter (issue #111): the JavaScript stage and the parity check\n  # must run for every pull request, and \"Pipeline Status (csharp)\" is a\n  # required check that a filtered-out run would never report. The\n  # detect-changes job skips the C# jobs when no C# input changed\n  # (.github/scripts/stack-paths.mjs).\n  pull_request:\n    types: [opened, synchronize, reopened]\n  workflow_dispatch:\n    inputs:\n      release_mode:\n        description: 'Release mode'\n        required: true\n        type: choice\n        default: 'instant'\n        options:\n          - instant\n          - publish-current\n          - changeset-pr\n          - verify-trusted-publishing\n      nuget_user:\n        description: 'NuGet account for authentication-only verification (defaults to NUGET_USER)'\n        required: false\n        type: string\n      bump_type:\n        description: 'Version bump type'\n        required: true\n        type: choice\n        default: 'patch'\n        options:\n          - patch\n          - minor\n          - major\n      description:\n        description: 'Release description (optional)'\n        required: false\n        type: string\n\n# Read-only concurrency cancels superseded PR synchronizations. Each main\n# revision keeps its results. Release writers share the repository queue.\n\n# Least privilege by default; the publishing jobs opt into more below.\npermissions:\n  contents: read\n\n# The GIT_CONFIG_* entries provide Git config to actions/checkout itself;\n# checkout runs git init before any workflow step can configure Git, which\n# otherwise prints the default-branch hint into every log.\nenv:\n  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true\n  DOTNET_CLI_TELEMETRY_OPTOUT: true\n  DOTNET_NOLOGO: true\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: ini…nch\n  GIT_CONFIG_VALUE_0: main\n\ndefaults:\n  run:\n    working-directory: csharp\n\njobs:\n  # === STAGE GATE (issue #111) ===\n  # Lint, JavaScript unit tests and the parity check. Every job that installs\n  # .NET lists `javascript` in its needs, so nothing C# starts unless this\n  # stage succeeded for the same commit.\n  javascript:\n    name: javascript\n    if: inputs.release_mode != 'verify-trusted-publishing'\n    uses: ./.github/workflows/javascript-stage.yml\n\n  release-preflight:\n    name: Release authentication preflight\n    if: inputs.release_mode != 'verify-trusted-publishing'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-release-preflight\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Authenticate preflight with NuGet\n        if: vars.NUGET_USER != '' && github.event_name != 'pull_request' && inputs.release_mode != 'changelog-pr' && inputs.release_mode != 'changeset-pr'\n        id: preflight_nuget\n        continue-on-error: true\n        uses: NuGet/login@8d196754b4036150537f80ac539e15c2f1028841 # v1.2.0\n        with:\n          user: ${{ vars.NUGET_USER }}\n      - name: Prove authentication before version writes or publishing\n        working-directory: .\n        env:\n          RELEASE_MODE: ${{ inputs.release_mode }}\n          NUGET_OIDC_OUTCOME: ${{ steps.preflight_nuget.outcome }}\n          NUGET_OIDC_KEY: ${{ steps.preflight_nuget.outputs.NUGET_API_KEY }}\n          NUGET_API_KEY: ${{… }}\n        run: node .github/scripts/release-preflight.mjs nuget\n\n  # Authenticate without a version commit, tag, or package upload. The input\n  # allows verification before setting NUGET_USER (which enables OIDC releases).\n  verify-trusted-publishing:\n    name: Verify NuGet trusted publishing\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'verify-trusted-publishing'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      id-token: write\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-verify-trusted-publishing\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - name: Validate NuGet account\n        working-directory: .\n        env:\n          NUGET_USER: ${{ vars.NUGET_USER || inputs.nuget_user }}\n        run: |\n          if [ -z \"$NUGET_USER\" ]; then\n            echo '::error::Supply nuget_user or set NUGET_USER to the account owning the trusted publishing policy on nuget.org.'\n            exit 1\n          fi\n\n      - name: NuGet login (OIDC)\n        id: auth\n        uses: NuGet/login@8d196754b4036150537f80ac539e15c2f1028841 # v1.2.0\n        with:\n          user: ${{ vars.NUGET_USER || inputs.nuget_user }}\n\n      - name: Confirm short-lived credential\n        working-directory: .\n        env:\n          NUGET_API_KEY: ${{… }}\n        run: |\n          test -n \"$NUGET_API_KEY\"\n          echo 'NuGet OIDC authentication succeeded; the temporary push key expires in one hour.' >> \"$GITHUB_STEP_SUMMARY\"\n\n  # === DETECT CHANGES - determines which jobs should run ===\n  detect-changes:\n    name: Detect Changes\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-detect-changes\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript]\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      stack-changed: ${{ steps.stack.outputs.stack-changed }}\n      cs-changed: ${{ steps.changes.outputs.cs-changed }}\n      csproj-changed: ${{ steps.changes.outputs.csproj-changed }}\n      sln-changed: ${{ steps.changes.outputs.sln-changed }}\n      props-changed: ${{ steps.changes.outputs.props-changed }}\n      mjs-changed: ${{ steps.changes.outputs.mjs-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n      csharp-code-changed: ${{ steps.changes.outputs.csharp-code-changed }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Detect changes\n        id: changes\n        working-directory: .\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: node csharp/scripts/detect-code-changes.mjs\n\n      # Replaces the removed pull_request path filter: on a pull request\n      # that changes no C# input, lint (and with it test, build and\n      # fresh-merge) and the changeset check are skipped.\n      - name: Detect whether the C# stack changed\n        id: stack\n        working-directory: .\n        env:\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          STACK_PATHS_DEBUG: ${{ runner.debug }}\n        run: node .github/scripts/stack-paths.mjs csharp\n\n  # === CHANGESET CHECK - only runs on PRs with code changes ===\n  changeset-check:\n    name: Changeset Validation\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-changeset-check\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.stack-changed == 'true' && needs.detect-changes.outputs.csharp-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Validate changeset\n        working-directory: .\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n          # Read head_ref through env, never interpolate it into the script: on\n          # a fork PR the branch name is attacker-controlled (issue #134).\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n        run: |\n          # Skip changeset check for automated release PRs\n          if [[ \"$GITHUB_HEAD_REF\" == \"changeset-release/\"* ]] || [[ \"$GITHUB_HEAD_REF\" == \"changeset-manual-release-\"* ]]; then\n            echo \"Skipping changeset check for automated release PR\"\n            exit 0\n          fi\n\n          # A C# code change without exactly one valid changeset never reaches\n          # a release, so this fails instead of warning (issue #134).\n          node csharp/scripts/validate-changeset.mjs\n\n  # === LINT AND FORMAT CHECK ===\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-lint\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes]\n    if: |\n      !cancelled() && needs.javascript.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (\n        github.event_name != 'pull_request' || needs.detect-changes.outputs.stack-changed == 'true'\n      ) && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.cs-changed == 'true' ||\n        needs.detect-changes.outputs.csproj-changed == 'true' ||\n        needs.detect-changes.outputs.sln-changed == 'true' ||\n        needs.detect-changes.outputs.props-changed == 'true' ||\n        needs.detect-changes.outputs.mjs-changed == 'true' ||\n        needs.detect-changes.outputs.docs-changed == 'true' ||\n        needs.detect-changes.outputs.workflow-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      # The release script and workflow policy tests moved to the JavaScript\n      # stage, which runs them through `npm run test:js` before this job.\n\n      - name: Restore dependencies\n        run: dotnet restore\n\n      - name: Verify core library has no SQLite provider\n        run: node ../.github/scripts/check-sqlite-optional.mjs csharp\n\n      - name: Verify formatting\n        run: dotnet format --verify-no-changes --verbosity diagnostic\n\n      - name: Build\n        run: dotnet build --no-restore --configuration Release\n\n      - name: Check file sizes\n        working-directory: .\n        run: node csharp/scripts/check-file-size.mjs --lang csharp\n\n  # === TEST ON MULTIPLE OS ===\n  test:\n    name: Test (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-test-${{ matrix.os }}\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, detect-changes, changeset-check, lint]\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && inputs.release_mode != 'verify-trusted-publishing' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch' || needs.changeset-check.result == 'success' || needs.changeset-check.result == 'skipped') }}\n    permissions:\n      contents: read\n      id-token: write\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-24.04, macos-26-intel, windows-2025]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      - name: Restore dependencies\n        run: dotnet restore\n\n      - name: Build\n        run: dotnet build --no-restore --configuration Release\n\n      # GoldenFixturesTests writes the receipt that a later step checks, so\n      # a filtered or skipped golden fixture test fails CI (issue #111).\n      - name: Run tests\n        env:\n          GOLDEN_FIXTURES_RECEIPT: ${{ runner.temp }}/golden-csharp.json\n          LINK_CSHARP_RECOVERY_TRACE: ${{ vars.CI_VERBOSE == 'true' && '1' || '0' }}\n        run: dotnet test --no-build --configuration Release --verbosity normal --collect:\"XPlat Code Coverage;Format=json,cobertura\"\n\n      - name: Verify every compiled causal branch\n        working-directory: .\n        shell: bash\n        run: |\n          reports=(csharp/Foundation.Data.Doublets.Cli.Tests/TestResults/*/coverage.json)\n          test \"${#reports[@]}\" -eq 1\n          test -f \"${reports[0]}\"\n          python3 experiments/issue-138/check-causal-raw-coverage.py \"${reports[0]}\" --require-session\n          python3 experiments/issue-138/check-author-fence-coverage.py \"${reports[0]}\"\n\n      - name: Build remaining examples\n        working-directory: .\n        run: |\n          dotnet build examples/engine-csharp --configuration Release\n          dotnet build examples/group-commit-csharp --configuration Release\n          dotnet build examples/transaction-names-csharp --configuration Release\n\n      - name: Native file LSM cluster consumers\n        working-directory: .\n        run: |\n          dotnet build examples/cluster-csharp --configuration Release\n          dotnet run --project examples/cluster-csharp --configuration Release --no-build -- --native-lsm direct\n          dotnet run --project examples/cluster-csharp --configuration Release --no-build -- --native-lsm partitioned\n          dotnet run --project examples/cluster-csharp --configuration Release --no-build -- --native-lsm chunks\n          dotnet run --project examples/cluster-csharp --configuration Release --no-build -- --native-lsm reclaiming\n          dotnet run --project examples/cluster-csharp --configuration Release --no-build -- --native-lsm reclaiming-chunks\n\n      - name: Setup Node.js for coverage\n        if: ${{ !cancelled() }}\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Check that the C# suite loaded every golden fixture\n        working-directory: .\n        shell: bash\n        env:\n          RECEIPT: ${{ runner.temp }}/golden-csharp.json\n        run: node parity/check-parity.mjs --receipt csharp \"$RECEIPT\"\n\n      - name: Write coverage summary\n        if: ${{ !cancelled() }}\n        working-directory: .\n        run: node .github/scripts/coverage.mjs summary csharp/Foundation.Data.Doublets.Cli.Tests/TestResults\n\n      - name: Retain raw and Cobertura reports\n        if: ${{ !cancelled() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: ${{ matrix.os == 'ubuntu-24.04' && 'csharp-coverage' || format('csharp-coverage-{0}', matrix.os) }}\n          path: |\n            csharp/Foundation.Data.Doublets.Cli.Tests/TestResults/**/coverage.cobertura.xml\n            csharp/Foundation.Data.Doublets.Cli.Tests/TestResults/**/coverage.json\n          if-no-files-found: error\n\n      # Only an explicitly inactive/missing Codecov repository relaxes upload\n      # errors. The preflight prints the reason as a warning; once activated,\n      # failed uploads fail CI. Coverage is retained independently above.\n      - name: Check Codecov activation\n        id: codecov\n        if: matrix.os == 'ubuntu-24.04'\n        working-directory: .\n        run: node .github/scripts/coverage.mjs codecov\n\n      - name: Upload coverage to Codecov (OIDC)\n        if: matrix.os == 'ubuntu-24.04'\n        timeout-minutes: 5\n        uses: codecov/codecov-action@v7\n        with:\n          use_oidc: true\n          directory: csharp/Foundation.Data.Doublets.Cli.Tests/TestResults\n          plugins: noop\n          fail_ci_if_error: ${{ steps.codecov.outputs.required }}\n\n  # === SEMANTIC MERGE CONFLICT CHECK ===\n  # The jobs above test the pull request head. Two pull requests that each pass\n  # can still break `main` once merged, because a clean textual merge does not\n  # imply a compiling one (issue #96). This job merges the head into the current\n  # tip of the base branch and rebuilds and retests that tree.\n  fresh-merge:\n    name: Simulate Fresh Merge\n    runs-on: ubuntu-24.04\n    timeout-minutes: 30\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-fresh-merge\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    if: github.event_name == 'pull_request'\n    needs: [javascript, detect-changes, lint]\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      # The script rewrites the working tree (detached checkout + merge), so it\n      # has to run from the repository root, not from the csharp/ default.\n      - name: Simulate fresh merge with base branch\n        working-directory: .\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n          FRESH_MERGE_CHECKS: |\n            dotnet build csharp --configuration Release\n            dotnet test csharp --no-build --configuration Release --verbosity normal\n        run: bash .github/scripts/simulate-fresh-merge.sh\n\n  # === BUILD PACKAGE ===\n  build:\n    name: Build Package\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-build\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    needs: [javascript, lint, test]\n    if: ${{ !cancelled() && needs.javascript.result == 'success' && needs.lint.result == 'success' && needs.test.result == 'success' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      - name: Restore dependencies\n        run: dotnet restore\n\n      - name: Build Release\n        run: dotnet build --no-restore --configuration Release\n\n      # Write N+100 of `clink --transactions` must not be much slower than\n      # write N on a constant-size store (issue #195).\n      - name: Benchmark transactional writes\n        run: node ../.github/scripts/transactions-benchmark.mjs -- dotnet Foundation.Data.Doublets.Cli/bin/Release/net10.0/clink.dll\n\n      - name: Pack NuGet package\n        run: |\n          dotnet pack --no-build --configuration Release --output ./artifacts\n          node scripts/verify-packages.mjs\n\n      - name: Verify examples and experiments cannot produce packages\n        run: node scripts/verify-packages.mjs --pack-excluded\n\n      - name: Upload artifacts\n        uses: actions/upload-artifact@v7\n        with:\n          name: nuget-package\n          path: csharp/artifacts/*.nupkg\n          if-no-files-found: error\n\n  # === AUTOMATIC RELEASE ===\n  release:\n    name: Release\n    needs: [release-preflight, javascript, lint, test, build]\n    if: >-\n      ${{ !cancelled() && github.ref == 'refs/heads/main' &&\n      (github.event_name == 'push' || (github.event_name == 'workflow_dispatch' && inputs.release_mode == 'publish-current')) &&\n      needs.release-preflight.result == 'success' && needs.javascript.result == 'success' &&\n      needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 45\n    # Writer group: never cancel a release that may already have pushed a\n    # package or a version commit.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: write\n      packages: write\n      # NuGet trusted publishing (NuGet/login) exchanges the OIDC token.\n      id-token: write\n    environment: release\n    steps:\n      - uses: actions/checkout@v7\n        # Rules on main admit pushes only from the release deploy key (issue\n        # #111). The key is a secret of the `release` environment, which only\n        # main can use. Without it the version push is declined; see\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Check for changesets\n        if: inputs.release_mode != 'publish-current'\n        id: check_changesets\n        working-directory: .\n        run: |\n          # Count changeset files (excluding README.md and config.json)\n          CHANGESET_COUNT=$(find csharp/.changeset -name \"*.md\" ! -name \"README.md\" 2>/dev/null | wc -l)\n          echo \"Found $CHANGESET_COUNT changeset file(s)\"\n          echo \"has_changesets=$([[ $CHANGESET_COUNT -gt 0 ]] && echo 'true' || echo 'false')\" >> \"$GITHUB_OUTPUT\"\n          echo \"changeset_count=$CHANGESET_COUNT\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Check if release is needed\n        # Self-healing gate: even when a changeset is absent, resume publishing\n        # if the csproj <Version> is missing on NuGet or its GitHub release does\n        # not exist. See docs/case-studies/issue-84/README.md and the JS\n        # template's check-release-needed.mjs for the same pattern.\n        id: check_release\n        working-directory: .\n        env:\n          HAS_CHANGESETS: ${{ steps.check_changesets.outputs.has_changesets }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          GITHUB_REPOSITORY: ${{ github.repository }}\n        run: node csharp/scripts/check-release-needed.mjs --library-csproj csharp/Foundation.Data.Doublets.Cli.Library/Foundation.Data.Doublets.Cli.Library.csproj\n\n      - name: Merge multiple changesets\n        if: steps.check_changesets.outputs.has_changesets == 'true' && steps.check_release.outputs.skip_bump != 'true' && steps.check_changesets.outputs.changeset_count > 1\n        working-directory: .\n        run: |\n          echo \"Multiple changesets detected, merging...\"\n          node csharp/scripts/merge-changesets.mjs \\\n            --dir csharp/.changeset \\\n            --package-name Foundation.Data.Doublets.Cli\n\n      - name: Version and commit\n        if: steps.check_changesets.outputs.has_changesets == 'true' && steps.check_release.outputs.skip_bump != 'true'\n        id: version\n        working-directory: .\n        run: node csharp/scripts/version-and-commit.mjs --mode changeset\n\n      - name: Resolve release version\n        # Picks the version that downstream steps should publish. Prefers the\n        # one just committed; falls back to the csproj <Version> reported by\n        # check-release-needed for self-healing re-runs.\n        id: release_version\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        env:\n          NEW_VERSION: ${{ steps.version.outputs.new_version }}\n          CURRENT_VERSION: ${{ steps.check_release.outputs.current_version }}\n        run: |\n          if [ -n \"$NEW_VERSION\" ]; then\n            VERSION=\"$NEW_VERSION\"\n          else\n            VERSION=\"$CURRENT_VERSION\"\n          fi\n          echo \"version=$VERSION\" >> \"$GITHUB_OUTPUT\"\n          echo \"Releasing version: $VERSION\"\n\n      - name: Build release package\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        run: |\n          dotnet restore\n          dotnet build --configuration Release\n          dotnet pack --no-build --configuration Release --output ./artifacts\n          node scripts/verify-packages.mjs\n\n      - name: Resolve NuGet package ids\n        id: package\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        run: |\n          CLI_ID=$(sed -n 's:.*<PackageId>\\(.*\\)</PackageId>.*:\\1:p' Foundation.Data.Doublets.Cli/Foundation.Data.Doublets.Cli.csproj | head -n 1)\n          if [ -z \"$CLI_ID\" ]; then\n            CLI_ID=clink\n          fi\n          LIB_ID=$(sed -n 's:.*<PackageId>\\(.*\\)</PackageId>.*:\\1:p' Foundation.Data.Doublets.Cli.Library/Foundation.Data.Doublets.Cli.Library.csproj | head -n 1)\n          if [ -z \"$LIB_ID\" ]; then\n            LIB_ID=Foundation.Data.Doublets.Cli\n          fi\n          echo \"id=$CLI_ID\" >> \"$GITHUB_OUTPUT\"\n          echo \"library_id=$LIB_ID\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Validate NuGet API key\n        # Upfront validation surfaces an expired/invalid NUGET_API_KEY before\n        # we attempt a push that would otherwise return HTTP 403 mid-flight.\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        env:\n          NUGET_API_KEY: ${{ secrets.NUGET_API_KEY }}\n          NUGET_USER: ${{ vars.NUGET_USER }}\n        run: |\n          if [ -n \"$NUGET_USER\" ]; then\n            echo \"Publishing with NuGet trusted publishing as $NUGET_USER\"\n            exit 0\n          fi\n          if [ -z \"$NUGET_API_KEY\" ]; then\n            echo \"::error title=NuGet credentials are missing::The release was versioned but cannot be published to NuGet. Either configure a nuget.org trusted publishing policy for this repository and csharp.yml and set the NUGET_USER repository variable to the nuget.org account name, or add a nuget.org API key with push access to the clink and Foundation.Data.Doublets.Cli packages as the NUGET_API_KEY repository secret (Settings > Secrets and variables > Actions), then re-run this job.\"\n            exit 1\n          fi\n          echo \"NUGET_API_KEY length: ${#NUGET_API_KEY}\"\n\n      - name: NuGet login (OIDC)\n        id: nuget-login\n        # Trusted publishing: a one-hour key requested right before the push.\n        if: >-\n          vars.NUGET_USER != '' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true'))\n        uses: NuGet/login@8d196754b4036150537f80ac539e15c2f1028841 # v1.2.0\n        with:\n          user: ${{ vars.NUGET_USER }}\n\n      - name: Publish to NuGet\n        id: nuget_publish\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        env:\n          # The long-lived secret is only the fallback while trusted\n          # publishing is not configured (vars.NUGET_USER unset).\n          NUGET_API_KEY: ${{… }}\n        run: |\n          # A missing key used to skip the push while the release stayed green\n          # (issue #134); a versioned but unpublished release must fail.\n          if [ -z \"$NUGET_API_KEY\" ]; then\n            echo \"::error title=NuGet credentials are missing::The release was versioned but cannot be published to NuGet. Either configure a nuget.org trusted publishing policy for this repository and csharp.yml and set the NUGET_USER repository variable to the nuget.org account name, or add a nuget.org API key with push access to the clink and Foundation.Data.Doublets.Cli packages as the NUGET_API_KEY repository secret (Settings > Secrets and variables > Actions), then re-run this job.\"\n            exit 1\n          fi\n          # zizmor flags every --api-key [REDACTED]; the key is the short-lived\n          # trusted-publishing key whenever vars.NUGET_USER is set.\n          dotnet nuget push ./artifacts/*.nupkg --api-key \"$NUGET_API_KEY\" --source https://api.nuget.org/v3/index.json --skip-duplicate # zizmor: ignore[use-trusted-publishing]\n          echo \"published=true\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Verify CLI package on NuGet\n        if: >-\n          steps.nuget_publish.outputs.published == 'true' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true'))\n        env:\n          PACKAGE_ID: ${{ steps.package.outputs.id }}\n          RELEASE_VERSION: ${{ steps.release_version.outputs.version }}\n        run: |\n          node scripts/wait-for-nuget.mjs \\\n            --package-id \"$PACKAGE_ID\" \\\n            --release-version \"$RELEASE_VERSION\"\n\n      - name: Verify library package on NuGet\n        if: >-\n          steps.nuget_publish.outputs.published == 'true' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true'))\n        env:\n          PACKAGE_ID: ${{ steps.package.outputs.library_id }}\n          RELEASE_VERSION: ${{ steps.release_version.outputs.version }}\n        run: |\n          node scripts/wait-for-nuget.mjs \\\n            --package-id \"$PACKAGE_ID\" \\\n            --release-version \"$RELEASE_VERSION\"\n\n      - name: Create GitHub Release\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true' ||\n          (steps.check_release.outputs.should_release == 'true' && steps.check_release.outputs.skip_bump == 'true')\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_VERSION: ${{ steps.release_version.outputs.version }}\n          CLI_PACKAGE_ID: ${{ steps.package.outputs.id }}\n          LIBRARY_PACKAGE_ID: ${{ steps.package.outputs.library_id }}\n        working-directory: .\n        run: |\n          node csharp/scripts/create-github-release.mjs \\\n            --release-version \"$RELEASE_VERSION\" \\\n            --repository \"$GITHUB_REPOSITORY\" \\\n            --tag-prefix \"csharp-v\" \\\n            --language \"C#\" \\\n            --package-id \"$CLI_PACKAGE_ID\" \\\n            --package-id \"$LIBRARY_PACKAGE_ID\" \\\n            --changelog-path \"csharp/CHANGELOG.md\" \\\n            --assets-glob \"csharp/artifacts/*.nupkg\"\n\n  # === MANUAL INSTANT RELEASE ===\n  instant-release:\n    name: Instant Release\n    needs: [release-preflight, javascript, lint, test, build]\n    if: ${{ !cancelled() && needs.release-preflight.result == 'success' && needs.javascript.result == 'success' && github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant' && needs.lint.result == 'success' && needs.test.result == 'success' && needs.build.result == 'success' }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 45\n    # Writer group: never cancel a release that may already have pushed a\n    # package or a version commit.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: write\n      packages: write\n      # NuGet trusted publishing (NuGet/login) exchanges the OIDC token.\n      id-token: write\n    environment: release\n    steps:\n      - uses: actions/checkout@v7\n        # Rules on main admit pushes only from the release deploy key (issue\n        # #111). The key is a secret of the `release` environment, which only\n        # main can use. Without it the version push is declined; see\n        # docs/ci-cd/troubleshooting.md#a-release-push-was-declined.\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n          ssh-key: ${{ secrets.RELEASE_DEPLOY_KEY }}\n\n      - name: Setup .NET\n        uses: actions/setup-dotnet@v6\n        with:\n          dotnet-version: '10.0.403' # Exact version uses the public builds feed; channel redirect returns HTTP 409.\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n\n      - name: Version and commit\n        id: version\n        working-directory: .\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n        run: |\n          node csharp/scripts/version-and-commit.mjs \\\n            --mode instant \\\n            --bump-type \"$BUMP_TYPE\" \\\n            --description \"$DESCRIPTION\"\n\n      - name: Build package\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true'\n        run: |\n          dotnet restore\n          dotnet build --configuration Release\n          dotnet pack --no-build --configuration Release --output ./artifacts\n          node scripts/verify-packages.mjs\n\n      - name: Resolve NuGet package ids\n        id: package\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true'\n        run: |\n          CLI_ID=$(sed -n 's:.*<PackageId>\\(.*\\)</PackageId>.*:\\1:p' Foundation.Data.Doublets.Cli/Foundation.Data.Doublets.Cli.csproj | head -n 1)\n          if [ -z \"$CLI_ID\" ]; then\n            CLI_ID=clink\n          fi\n          LIB_ID=$(sed -n 's:.*<PackageId>\\(.*\\)</PackageId>.*:\\1:p' Foundation.Data.Doublets.Cli.Library/Foundation.Data.Doublets.Cli.Library.csproj | head -n 1)\n          if [ -z \"$LIB_ID\" ]; then\n            LIB_ID=Foundation.Data.Doublets.Cli\n          fi\n          echo \"id=$CLI_ID\" >> \"$GITHUB_OUTPUT\"\n          echo \"library_id=$LIB_ID\" >> \"$GITHUB_OUTPUT\"\n\n      - name: NuGet login (OIDC)\n        id: nuget-login\n        # Trusted publishing: a one-hour key requested right before the push.\n        if: >-\n          vars.NUGET_USER != '' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true')\n        uses: NuGet/login@8d196754b4036150537f80ac539e15c2f1028841 # v1.2.0\n        with:\n          user: ${{ vars.NUGET_USER }}\n\n      - name: Publish to NuGet\n        id: nuget_publish\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true'\n        env:\n          # The long-lived secret is only the fallback while trusted\n          # publishing is not configured (vars.NUGET_USER unset).\n          NUGET_API_KEY: ${{… }}\n        run: |\n          # A missing key used to skip the push while the release stayed green\n          # (issue #134); a versioned but unpublished release must fail.\n          if [ -z \"$NUGET_API_KEY\" ]; then\n            echo \"::error title=NuGet credentials are missing::The release was versioned but cannot be published to NuGet. Either configure a nuget.org trusted publishing policy for this repository and csharp.yml and set the NUGET_USER repository variable to the nuget.org account name, or add a nuget.org API key with push access to the clink and Foundation.Data.Doublets.Cli packages as the NUGET_API_KEY repository secret (Settings > Secrets and variables > Actions), then re-run this job.\"\n            exit 1\n          fi\n          # zizmor flags every --api-key [REDACTED]; the key is the short-lived\n          # trusted-publishing key whenever vars.NUGET_USER is set.\n          dotnet nuget push ./artifacts/*.nupkg --api-key \"$NUGET_API_KEY\" --source https://api.nuget.org/v3/index.json --skip-duplicate # zizmor: ignore[use-trusted-publishing]\n          echo \"published=true\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Verify CLI package on NuGet\n        if: >-\n          steps.nuget_publish.outputs.published == 'true' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true')\n        env:\n          PACKAGE_ID: ${{ steps.package.outputs.id }}\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\n        run: |\n          node scripts/wait-for-nuget.mjs \\\n            --package-id \"$PACKAGE_ID\" \\\n            --release-version \"$RELEASE_VERSION\"\n\n      - name: Verify library package on NuGet\n        if: >-\n          steps.nuget_publish.outputs.published == 'true' && (\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true')\n        env:\n          PACKAGE_ID: ${{ steps.package.outputs.library_id }}\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\n        run: |\n          node scripts/wait-for-nuget.mjs \\\n            --package-id \"$PACKAGE_ID\" \\\n            --release-version \"$RELEASE_VERSION\"\n\n      - name: Create GitHub Release\n        if: >-\n          steps.version.outputs.version_committed == 'true' ||\n          steps.version.outputs.already_released == 'true'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          RELEASE_VERSION: ${{ steps.version.outputs.new_version }}\n          CLI_PACKAGE_ID: ${{ steps.package.outputs.id }}\n          LIBRARY_PACKAGE_ID: ${{ steps.package.outputs.library_id }}\n        working-directory: .\n        run: |\n          node csharp/scripts/create-github-release.mjs \\\n            --release-version \"$RELEASE_VERSION\" \\\n            --repository \"$GITHUB_REPOSITORY\" \\\n            --tag-prefix \"csharp-v\" \\\n            --language \"C#\" \\\n            --package-id \"$CLI_PACKAGE_ID\" \\\n            --package-id \"$LIBRARY_PACKAGE_ID\" \\\n            --changelog-path \"csharp/CHANGELOG.md\" \\\n            --assets-glob \"csharp/artifacts/*.nupkg\"\n\n  # === MANUAL CHANGESET PR ===\n  # The workflow_dispatch input above advertises a 'changeset-pr' release mode,\n  # but no job used to handle it: selecting it silently did nothing while the\n  # run still reported success (issue #96). This job implements the advertised\n  # mode - it opens a pull request carrying the changeset instead of releasing\n  # straight away. The branch name matches the 'changeset-manual-release-*'\n  # prefix that changeset-check already skips.\n  changeset-pr:\n    name: Create Changeset PR\n    needs: [javascript]\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changeset-pr'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    # Writer group: never cancel a run that may already have pushed a branch.\n    concurrency:\n      group: main-writer-${{ github.repository }}\n      cancel-in-progress: false\n      queue: max\n    permissions:\n      contents: write\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: true\n          fetch-depth: 0\n\n      - name: Create changeset file\n        working-directory: .\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n          RUN_ID: ${{ github.run_id }}\n        run: |\n          set -euo pipefail\n          CHANGESET_FILE=\"csharp/.changeset/manual-release-${RUN_ID}.md\"\n          DESCRIPTION_TEXT=\"${DESCRIPTION:-Manual ${BUMP_TYPE} release}\"\n          {\n            echo '---'\n            echo \"'Foundation.Data.Doublets.Cli': ${BUMP_TYPE}\"\n            echo '---'\n            echo\n            echo \"${DESCRIPTION_TEXT}\"\n          } > \"$CHANGESET_FILE\"\n          echo \"Created changeset: $CHANGESET_FILE\"\n          cat \"$CHANGESET_FILE\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@v8\n        with:\n          token: ${{ secrets.GITHUB_TOKEN }}\n          commit-message: 'chore: add changeset for manual ${{ github.event.inputs.bump_type }} release'\n          branch: changeset-manual-release-${{ github.run_id }}\n          delete-branch: true\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n          body: |\n            ## Manual Release Request\n\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n\n            ### Release Details\n            - **Type:** ${{ github.event.inputs.bump_type }}\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n            - **Triggered by:** @${{ github.actor }}\n\n            ### Next Steps\n            1. Review the changeset in this PR\n            2. Merge this PR to main\n            3. The automated release workflow will version, publish, and create a GitHub release\n\n  pipeline-status:\n    name: Pipeline Status (csharp)\n    needs:\n      - javascript\n      - release-preflight\n      - verify-trusted-publishing\n      - detect-changes\n      - changeset-check\n      - lint\n      - test\n      - fresh-merge\n      - build\n      - release\n      - instant-release\n      - changeset-pr\n    if: ${{ !cancelled() }}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' && github.ref || github.event_name == 'push' && github.sha || github.run_id }}-pipeline-status\n      cancel-in-progress: ${{ github.event_name == 'pull_request' && github.event.action == 'synchronize' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - uses: actions/setup-node@v7\n        with:\n          node-version: '26.x'\n      - name: Check every prerequisite\n        working-directory: .\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n        run: node .github/scripts/pipeline-status.mjs\n"
