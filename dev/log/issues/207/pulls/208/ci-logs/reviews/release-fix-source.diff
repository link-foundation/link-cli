+                Directory.Move(directory, released);
+            }
+            catch (IOException) when (attempts == 1)
+            {
+                reader.Dispose();
+                throw;
+            }
+        }, trace: true));
+        Assert.Equal(2, attempts);
+        Assert.Equal("held", StorePidLock.ReadOwner(released)?.Token);
+        Assert.False(Directory.Exists(directory));
