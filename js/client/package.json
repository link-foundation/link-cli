{
  "name": "@link-foundation/link-cli-client",
  "version": "0.2.0",
  "description": "Minimal universal JS/TS client for link-cli stores: the clink --serve TCP protocol (Node.js, Bun, Deno), a subprocess adapter and the in-process WebAssembly backend, behind one contract with explicit capabilities",
  "type": "module",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/link-cli.git",
    "directory": "js/client"
  },
  "homepage": "https://github.com/link-foundation/link-cli/tree/main/js/client#readme",
  "bugs": "https://github.com/link-foundation/link-cli/issues",
  "keywords": [
    "links",
    "doublets",
    "lino",
    "links-notation",
    "link-cli",
    "clink",
    "client",
    "wasm"
  ],
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./tcp": {
      "types": "./types/tcp.d.ts",
      "default": "./src/tcp.js"
    },
    "./process": {
      "types": "./types/process.d.ts",
      "default": "./src/process.js"
    },
    "./lino": {
      "types": "./types/lino.d.ts",
      "default": "./src/lino.js"
    },
    "./package.json": "./package.json",
    "./engine-sqlite-log": {
      "types": "./types/engine-sqlite-log.d.ts",
      "default": "./src/engine-sqlite-log.js"
    },
    "./engine-file-log": {
      "types": "./types/engine-file-log.d.ts",
      "default": "./src/engine-file-log.js"
    },
    "./engine-paged-log": {
      "types": "./types/engine-paged-log.d.ts",
      "default": "./src/engine-paged-log.js"
    },
    "./engine-file-paged-log": {
      "types": "./types/engine-file-paged-log.d.ts",
      "default": "./src/engine-file-paged-log.js"
    },
    "./engine-mirrored-pages": {
      "types": "./types/engine-mirrored-pages.d.ts",
      "default": "./src/engine-mirrored-pages.js"
    },
    "./engine-file-mirrored-pages": {
      "types": "./types/engine-file-mirrored-pages.d.ts",
      "default": "./src/engine-file-mirrored-pages.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:conformance": "node test/conformance/run.mjs",
    "benchmark": "node examples/synthetic-consumer.mjs",
    "typecheck": "tsc --noEmit --strict --lib esnext,dom --target esnext --module nodenext types/*.d.ts test/types.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
